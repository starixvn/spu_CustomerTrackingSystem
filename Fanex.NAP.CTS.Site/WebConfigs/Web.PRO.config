  <NapSettings Environment="Live" EnableDirectLogin="1" SiteId="36" UnauthorizeUrl="~/Error/403" EnableReCheckin="true" HubUrl="https://nap.oneops.net/NAPHub" ServiceUrls="http://10.99.99.51:1710/api" AccessKey="GnE/fcyUYdoa7hjQz9fy4LaQdbafN7Q+E3Mhcu7xsmg=">
