<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core" />
  </configSections>
  <appSettings configSource="Web.AppSettings.config" />
  <connectionStrings configSource="Web.ConnectionString.config" />
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.6.1" />
      </system.Web>
  -->

  <system.web>
    <authentication mode="Forms">
      <forms ticketCompatibilityMode="Framework40" cookieless="UseCookies" name=".NAPFORMSAUTH_NAPLICENSEE" loginUrl="~/UserLogin/Login" timeout="2880" defaultUrl="~/Home" />
    </authentication>
    <compilation debug="true" targetFramework="4.6.1">     
    </compilation>
    <httpRuntime targetFramework="4.6.1" />
    <customErrors mode="Off" defaultRedirect="~/Errors/500">
      <error statusCode="404" redirect="~/Errors/404" />
      <error statusCode="403" redirect="~/Errors/403" />
    </customErrors>
  </system.web>
  <system.webServer>
    <modules>
      <remove name="FormsAuthenticationModule" />
    </modules>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
