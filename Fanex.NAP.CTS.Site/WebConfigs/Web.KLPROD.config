      <httpRuntime executionTimeout="1800" />
    </system.web>
    <system.webServer>
      <urlCompression doDynamicCompression="false" />
      <httpCompression>
        <dynamicTypes>
          <add mimeType="text/event-stream" enabled="false" />
        </dynamicTypes>
      </httpCompression>
      <httpProtocol>
        <customHeaders>
          <add name="X-Accel-Buffering" value="no" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  
