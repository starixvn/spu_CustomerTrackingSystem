@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewResources.Offline</title>
    <link href="~/Areas/UserLogin/Views/Common/Style/Maintenance.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <div class="container">
        <div class="header">
            <picture>
                <source srcset="~/Areas/UserLogin/Views/Common/Style/Images/logo.webp" type="image/webp">
                <source srcset="~/Areas/UserLogin/Views/Common/Style/Images/logo.jpeg" type="image/jpeg">
                <img class="img" src="~/Areas/UserLogin/Views/Common/Style/Images/logo.png" alt="logo">
            </picture>
        </div>
        
        <div class="content">
            <div class="content-left">
                <picture>
                    <source srcset="~/Areas/UserLogin/Views/Common/Style/Images/maintenance.webp" type="image/webp">
                    <source srcset="~/Areas/UserLogin/Views/Common/Style/Images/maintenance.jpeg" type="image/jpeg">
                    <img class="img" src="~/Areas/UserLogin/Views/Common/Style/Images/maintenance.png" alt="maintenance">
                </picture>
            </div>
            
            <div class="content-right">
                <h1>
                    This site is currently unavailable due to scheduled maintenance.
                </h1>
                <h4>
                    This downtime will last from <span class="em">@(ViewBag.UmtFrom)</span> &rarr; <span class="em">@(ViewBag.UmtTo)</span> (GMT-4). Thanks for your patience!
                </h4>
            </div>
        </div>
        @*<h1>
            @ViewResources.Maintenance</h1>*@
    </div>
</body>
</html>