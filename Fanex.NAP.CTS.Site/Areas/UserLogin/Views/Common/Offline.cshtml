@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <link href="https://fonts.googleapis.com/css?family=Lato:400,400i,700,900" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/scss/fonts/Fraud-Sensor/style.css">
    <link rel="stylesheet" href="~/Content/scss/base/reset.css">
    <link rel="stylesheet" href="~/Content/scss/pages/common/maintenance.css">
    <link rel="shortcut icon" href="~/favicon.ico" />
    <title>@ViewResources.Offline</title>
</head>
<body>
    <div class="container">
        <div class="header">
            <picture>
                <source srcset="@Url.Content("~/Content/images/logo.webp")" type="image/webp">
                <source srcset="@Url.Content("~/Content/images/logo.jpeg")" type="image/jpeg">
                <img class="img img-logo" src="@Url.Content("~/Content/images/logo.png")" alt="maintenance">
            </picture>
        </div>

        <div class="content">
            <div class="content-left">
                <picture>
                    <source srcset="@Url.Content("~/Content/images/maintenance.webp")" type="image/webp">
                    <source srcset="@Url.Content("~/Content/images/maintenance.jpeg")" type="image/jpeg">
                    <img class="img img-content" src="@Url.Content("~/Content/images/maintenance.png")" alt="maintenance">
                </picture>
            </div>

            <div class="content-right">
                <h1 class="title">
                    This site is currently unavailable due to scheduled maintenance.
                </h1>
                <h4 class="text">
                    This downtime will last from <span class="em">@(ViewBag.UmtFrom)</span> &rarr; <span class="em">@(ViewBag.UmtTo)</span> (GMT-4). Thanks for your patience!
                </h4>
            </div>
        </div>
        @*<h1>
            @ViewResources.Maintenance</h1>*@
    </div>
</body>
</html>