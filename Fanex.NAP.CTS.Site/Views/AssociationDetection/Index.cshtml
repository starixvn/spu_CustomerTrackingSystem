
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="page-title">Association Detection</h2>
@section styles{
    @Styles.Render("~/association-detection-styles")
}
<section class="association-detection-report">
    <div class="association-detection-content">
        <div class="association-detection-table">
            <div class="control-table">
                <div class="form-filter">
                    <div id="divAddUserName" class="popup-add box-username">
                        <div class="group-title">
                            <div class="label">Username</div>
                            <div class="wrapper-title">
                                <div class="wrapper-rule wrapper-rule-left">
                                    <span class="text bg-red">Red</span>
                                    <span class="text">Invalid username</span>
                                </div>                                
                            </div>
                        </div>
                        <span class="wrapper-value" id="spanAddUserName">
                            <input id="inputTagUsername" type="text" name='tags-outside' class="input-field full-width tagify--outside" placeholder="Type username (Separate by comma, tab, space and enter)" />
                            <span class="limit-username">
                                Max: <span id="spanAddUserNameMaxTag">1001</span> usernames
                            </span>
                            <span id="spanAddChangeHidden" hidden></span>
                        </span>
                        <div class="flex-container modal-footer margin-top-10">                            
                            <div>
                                <div><span class="checkbox-filter">Check all</span></div>
                                <div><span class="checkbox-filter">Uncheck all</span></div>
                            </div>
                            <div style="width: 42%">
                                <button id="btnAssociationDetection" class="button btn btn-detect" title="Association Detection">Detect</button>
                            </div>
                        </div>
                        <div class="flex-container modal-footer margin-top-10">                            
                            <div>
                                <span class="checkbox-filter">
                                    <label class="checkbox-container" id="ckbOptBPContainer">
                                        <input id="inputOptBP" type="checkbox" checked>
                                        <span class="checkmark"></span>
                                        Betting Pattern
                                    </label>
                                </span>

                                <span class="checkbox-filter">
                                    <label class="checkbox-container" id="ckbOptDeviceContainer">
                                        <input id="inputOptDevice" type="checkbox" checked>
                                        <span class="checkmark"></span>
                                        Device
                                    </label>
                                </span>

                                <span class="checkbox-filter">
                                    <label class="checkbox-container" id="ckbOptIPContainer">
                                        <input id="inputOptIP" type="checkbox" checked>
                                        <span class="checkmark"></span>
                                        IP
                                    </label>
                                </span>

                                <span class="checkbox-filter">
                                    <label class="checkbox-container" id="ckbOptAgentContainer">
                                        <input id="inputOptAgent" type="checkbox">
                                        <span class="checkmark"></span>
                                        Agent
                                    </label>
                                </span>

                                <span class="checkbox-filter">
                                    <label class="checkbox-container" id="ckbOpt3MatchesLast7DaysContainer">
                                        <input id="inputOpt3MatchesLast7Days" type="checkbox">
                                        <span class="checkmark"></span>
                                        3 Matches(last 7 days)
                                    </label>
                                </span>

                                <span class="checkbox-filter">
                                    <label class="checkbox-container" id="ckbOptIPLast3DaysContainer">
                                        <input id="inputOptIPLast3Days" type="checkbox">
                                        <span class="checkmark"></span>
                                        IP(last 3 days)
                                    </label>

                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="report-cont hide" id="divReportContainer">
                <div class="table-report">
                    <div class="fixed-header">
                        <div class="top-header">
                            <div class="button-primary">
                                <span class="sub-icon" id="btnExportToExcel" title="Export To Excel">
                                    <i class="icon-excel"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                    <table id="tblAssociationDetection" class="table table-striped table-association-detection" style="width:100%">
                        <thead>
                            <tr>
                                <th>Group</th>
                                <th>Username</th>
                                <th>Status</th>
                                <th>Evidence</th>
                                <th>Associated Type</th>
                                <th>Customer Category</th>
                                <th>CC</th>
                                <th>Agent</th>
                                <th>Agent's Evidence</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<div id="divAssociationDetectDetail" class="popup-add" style="display:none;">
    <div class="report-cont" style="max-height:400px">
        <div class="table-report">
            <table id="tblAssociationDetectDetail" class="table table-striped table-association-detection-detail" style="width:100%">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Associated Type</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div id="divAssociationDetectDetailIP" class="popup-add" style="display:none;">
    <div class="report-cont">
        <div class="table-report">
            <table id="tblAssociationDetectDetailIP" class="table table-striped table-association-detection-detail-ip" style="width:100%">
                <thead>
                    <tr>
                        <th>IP</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div id="divAssociationDetectDetailMatch" class="popup-add" style="display:none;">
    <div class="report-cont" style="max-height:400px">
        <div class="table-report">
            <table id="tblAssociationDetectDetailMatch" class="table table-striped table-association-detection-detail-Match" style="width:100%">
                <thead>
                    <tr>
                        <th>MatchID</th>
                        <th>Username</th>
                        <th>Trans Date</th>
                        <th>Trans ID</th>
                        <th>Bet Type</th>
                        <th>Bet Team</th>
                        <th>Stake</th>
                        <th>Odd</th>
                        <th>Live Score</th>
                        <th>Result</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div id="divAssociationDetectDetailAgent" class="popup-add" style="display:none;">
    <div class="report-cont">
        <div class="table-report">
            <table id="tblAssociationDetectDetailAgent" class="table table-striped table-association-detection-agent" style="width:100%">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Agent</th>
                        <th>Associated Type</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section scripts{
    @Scripts.Render("~/association-detection-scripts")
}
