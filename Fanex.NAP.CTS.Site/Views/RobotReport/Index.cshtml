
@{
    ViewBag.Title = "ROBOT REPORT";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/robot-report-styles")
}

<section class="robot-report">
    <div class="content">
        <h2 class="page-title">Robot Report</h2>
    </div>

     <div class="robot-report-header">
        <div class="group-control">
            <div class="form-filter">
                <div class="group">
                    <label class="group title-text">Report Type</label>
                    <select class="control width-select" id="cbbRobotType">
                        <option value="0">All</option>
                        <option selected value="1">Robot</option>
                        <option value="2">AI Robot</option>
                    </select>
                </div>

                <div class="group">
                    <label class="group title-text">Site</label>
                    <select class="control width-select" id="cbbSite">
                        <option selected value="A">All</option>
                        <option value="C">Credit</option>
                        <option value="L">Licensee</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="robot-report-body">
        <div class="control">
            <div class="group-control">
                <div class="title-robot-report title-text">
                    <div class="label">Month</div>
                </div>

                <div class="form-filter">
                    <div class="group calendar">
                        <label class="text">From</label>
                        <input type="text" id="dpkFromMonth" class="input" readonly>
                        <span class="icon-calendar-text"></span>
                        <input type="text" id="dpkFromMonthServer" hidden>
                    </div>
                    <div class="group calendar">
                        <label class="text">To</label>
                        <input type="text" id="dpkToMonth" class="input" readonly>
                        <span class="icon-calendar-text"></span>
                        <input type="text" id="dpkToMonthServer" hidden>
                    </div>

                    <button class="button button-generate" id="btnGenerateMonthly">Generate</button>
                </div>
            </div>

            <div style="display:flex; justify-content:space-between; width: 100%; margin-top: 5px;">
                
                <div id="Robot1ReportDatatable" class="report-cont">
                    <div class="robot-report-datatable">
                        <div class="fixed-header">
                            <div class="top-header">
                                <div class="title-text">Robot Monthly Statistic</div>
                                <div class="export-excel">
                                    <button class="button btnExcel" id="btnExportExcelRobot1" title="Export to Excel">
                                        <i class="icon icon-excel"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <table id="tblRobot1Report" class="table table-striped table-robot-report" style="width: 100%">
                            <thead>
                                <tr>
                                    <th style="min-width: 140px;">Month</th>
                                    <th>AI</th>
                                    <th>Imperva</th>
                                    <th>Counter</th>
                                    <th style="min-width: 140px;">Total Distinct Account</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                            <tfoot>
                                <tr>
                                    <th>Total Distinct Account</th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                
                <div id="AIRobot1ReportDatatable" class="report-cont">
                    <div class="robot-report-datatable">
                        <div class="fixed-header">
                            <div class="top-header">
                                <div class="title-text">AI Robot Monthly Statistic</div>
                                <div class="export-excel">
                                    <button class="button btnExcel" id="btnExportExcelAIRobot1" title="Export to Excel">
                                        <i class="icon icon-excel"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <table id="tblAIRobot1Report" class="table table-striped table-robot-report" style="width: 100%">
                            <thead>
                                <tr>
                                    <th style="min-width: 140px;">Month</th>
                                    <th>TI</th>
                                    <th>SCE</th>
                                    <th>TD</th>
                                    <th>OCRD</th>
                                    <th>LP</th>
                                    <th style="min-width: 140px;">Total Distinct Account</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                            <tfoot>
                                <tr>
                                    <th>Total Distinct Account</th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                
            </div>
        </div>
        <div style="height: 1.2%"></div>
        <div class="control">
            <div class="group-control">
                <div class="title-robot-report title-text">
                    <div class="label">Date</div>
                </div>

                <div class="form-filter">
                    <div class="group calendar">
                        <label class="text">From</label>
                        <input type="text" id="dpkFromDate" class="input" readonly>
                        <span class="icon-calendar-text"></span>
                    </div>
                    <div class="group calendar">
                        <label class="text">To</label>
                        <input type="text" id="dpkToDate" class="input" readonly>
                        <span class="icon-calendar-text"></span>
                    </div>

                    <button class="button button-generate" id="btnGenerateDaily">Generate</button>
                </div>
            </div>

            <div style="display:flex; justify-content:space-between; width: 100%; margin-top: 5px;">
               
                <div id="Robot0ReportDatatable" class="report-cont">
                    <div class="robot-report-datatable">
                        <div class="fixed-header">
                            <div class="top-header">
                                <div class="title-text">Robot Daily Statistic</div>
                                <div class="export-excel">
                                    <button class="button btnExcel" id="btnExportExcelRobot0" title="Export to Excel">
                                        <i class="icon icon-excel"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <table id="tblRobot0Report" class="table table-striped table-robot-report" style="width: 100%">
                            <thead>
                                <tr>
                                    <th style="min-width: 140px;">Date</th>
                                    <th>AI</th>
                                    <th>Imperva</th>
                                    <th>Counter</th>
                                    <th style="min-width: 140px;">Total Distinct Account</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                            <tfoot>
                                <tr>
                                    <th>Total Distinct Account</th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                
                <div id="AIRobot0ReportDatatable" class="report-cont">
                    <div class="robot-report-datatable">
                        <div class="fixed-header">
                            <div class="top-header">
                                <div class="title-text">AI Robot Daily Statistic</div>
                                <div class="export-excel">
                                    <button class="button btnExcel" id="btnExportExcelAIRobot0" title="Export to Excel">
                                        <i class="icon icon-excel"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <table id="tblAIRobot0Report" class="table table-striped table-robot-report" style="width: 100%">
                            <thead>
                                <tr>
                                    <th style="min-width: 140px;">Date</th>
                                    <th>TI</th>
                                    <th>SCE</th>
                                    <th>TD</th>
                                    <th>OCRD</th>
                                    <th>LP</th>
                                    <th style="min-width: 140px;">Total Distinct Account</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                            <tfoot>
                                <tr>
                                    <th>Total Distinct Account</th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section scripts{
    @Scripts.Render("~/robot-report-scripts")
}