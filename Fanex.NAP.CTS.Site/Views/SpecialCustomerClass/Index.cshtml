@{
    ViewBag.Title = "SPECIAL CUSTOMER CLASS";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<KeyValuePair<int, string>> customerCategoryDictionary = ViewBag.CustomerCategorySportOrder;
}
@section styles{
    @Styles.Render("~/special-customer-class-styles")
}

<body class="special-customer-class-page">
    <section class="special-customer-class">
        <div class="content">
            <h2 class="page-title">SPECIAL CUSTOMER CLASS</h2>
        </div>

        <div class="special-customer-container">
            <div class="special-customer-table">
                <div class="group-control">
                    <div class="form-filter">
                        <div class="group width-380">
                            <label class="text">Username</label>
                            <input class="control input-username" type="text" id="txtSearchUsername" />
                        </div>
                        <div class="group width-180">
                            <label class="text">Sport Type</label>
                            <select class="control width-select" id="ccbSportType" multiple="multiple">
                                <option value='0' selected>General</option>

                                @foreach (var item in customerCategoryDictionary)
                                {
                                    <option value=@item.Key selected>@item.Value</option>
                                }
                            </select>
                        </div>
                        <button class="button button-generate" id="btnGenerate">Generate</button>
                    </div>
                </div>

                <div id="special-customer-datatable" class="report-cont">
                    <div class="table-report" style="width : 100%">
                        <!-- <div class="fixed-header">
                            <div class="top-header">
                                <div class="add-special">
                                    <button class="button button-primary-outline" id="btnAdd">Add</button>
                                </div>
                            </div>
                        </div> -->

                        <table id="tblSpecialCustomerClass" class="table table-striped table-special-customer">
                            <thead>
                                <tr>
                                    <th><input name="select_all" value="1" id="inputSelectAll" type="checkbox" class="col-checkbox" /></th>
                                    <th>Username</th>
                                    <th>Site</th>
                                    <th>Sport Type</th>
                                    <th>Customer Class</th>
                                    <th>Added By</th>
                                    <th>Comment</th>
                                    <th>Added Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                        </table>
                    </div>

                    <div class="hide">
                        <input id="hdIsHostPermission" type="hidden" IsHostPermission="@Model.ToString()" />
                    </div>
                </div>
            </div>
        </div>
    </section>
</body>

<div id="divAddProblemAccount" class="popup-add divAddProblemAccount" style="display:none;">
    <div class="form-validate">
        <div class="form-group">
            <div class="form-control">
                <div class="label">Sport Type<label style="color:red">*</label></div>
                <select class="control width-select" id="ccbSportTypeSingle">
                    <option value='0'>General</option>

                    @foreach (var item in customerCategoryDictionary)
                    {
                        <option value=@item.Key>@item.Value</option>
                    }
                </select>
            </div>
            
            <div class="form-control" style="margin-left:10px">
                <div class="label">Class<label style="color:red">*</label></div>
                <input id="txtCustomerClass" class="control input-class" style="width: 150px !important;" />
            </div>
        </div>

        <div class="group-title">
            <div class="label">Username<label style="color:red">*</label></div>
        </div>
        <span class="wrapper-value" id="spanAddProblemAccountUserName">
            <input id="inputTagUsername" type="text" name='tags-outside' class="input-field full-width tagify--outside" placeholder="Type username (Separate by comma, tab, space and enter)" />
            <span class="limit-username">
                Max: <span id="spanAddProblemAccountUserNameMaxTag">1001</span> usernames
            </span>
            <span id="spanAddProblemAccountChangeHidden" hidden></span>
            <span id="spanProblemAccountActionHidden" hidden></span>
        </span>
    </div>

    <div class="form-control wrapper-comment">
        <div class="label">Comment</div>
        <textarea id="txtComment" rows="3" class="comment-field full-width" maxlength="500"></textarea>
    </div>

    <div class="modal-footer margin-top-10">
        <button id="btnCancel" class="button btn-cancel-outline" title="Cancel">Cancel</button>
        <button id="btnSave" class="button -add" title="Save">Save</button>
    </div>  
</div>

@section scripts{
    @Scripts.Render("~/special-customer-class-scripts")
}

