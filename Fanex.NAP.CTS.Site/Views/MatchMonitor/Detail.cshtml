@{ ViewBag.Title = "MATCH MONITOR DETAIL";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section styles{
    @Styles.Render("~/match-monitor-styles")
}

<section class="detailpage" id="detailpage">
    <div class="content">
        <div class="page-title-match">
            <span class="title-description">MATCH MONITOR DETAIL</span>
            <span class="title-match-name"> @ViewBag.HomeName <span class="title-match-vs"> vs </span> @ViewBag.AwayName</span>
            <span class="title-league-name"> @ViewBag.LeagueName</span>
        </div>
    </div>

    <div class="monitor-container">
        <div class="monitor-table">
            <div class="group-control">
                <div class="group-info filter-group">
                    <div class="form-filter">
                        <div class="group width-160">
                            <label class="text">Site</label>
                            <select class="control width-select-one" id="cbbSites">
                                <option value="A">All</option>
                                <option value="C">Credit</option>
                                <option value="L">Licensee</option>
                            </select>
                        </div>

                        <div class="group width-160">
                            <label class="text">Type of Tickets</label>
                            <select class="control width-select-one" id="cbbTypeOfTickets">
                                <option value="2">Suspicious Tickets</option>
                                <option value="3">All</option>
                            </select>
                        </div>

                        <div class="group width-160">
                            <label class="text">Currency</label>
                            <select class="control width-select" id="cbbCurrency" multiple="multiple">
                            </select>
                        </div>

                        <div class="group width-160">
                            <label class="text">HDP</label>
                            <select class="control width-select" id="cbbHDP" multiple="multiple">                              
                            </select>
                        </div>

                        <div class="group width-160" @(ViewBag.IsDisableScoreFilter ? "hidden" : "")   >
                            <label class="text">Score</label>
                            <select class="control width-select" id="cbbMatchScore" multiple="multiple">
                                @if (ViewBag.MatchScore != null)
                                {
                                    foreach (var item in ViewBag.MatchScore)
                                    {
                                        <option value="@item.ScoreDiff" selected>@item.LiveHomeScore - @item.LiveAwayScore </option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="group width-160">
                            <label class="text">Reason</label>
                            <select class="control width-select" id="cbbReason" multiple="multiple">                              
                            </select>
                        </div>

                        <div class="group width-180">
                            <label class="text">A.Gr.</label>
                            <select class="control width-select" id="cbbGroup" multiple="multiple">                               
                            </select>
                        </div>

                        <div class="group-button">
                            <button class="button button-generate" id="btnGenerate-detail">Generate</button>
                        </div>                        
                    </div>
                    <div class="detail-area" id="detail-area">                        
                        <span>@ViewBag.SportName - @ViewBag.BettypeName - <span class="market-highlight">@ViewBag.MarketName</span><br /></span>
                        <span id="spanKOTime">KO Time: @ViewBag.KOTime<br /></span>
                        <span class="reason-highlight" id="spanReasonInfo"></span>
                    </div>
                </div>

                <div class="breadcrumb-button">
                    <div class="breadcrumb-totaltickets"></div>
                    <div>
                        <button class="button button-primary-outline" id="btnRefresh">Import New Tickets</button>
                        <button class="button button-primary-outline" id="btnShowAll">Show All</button>
                        <button class="button button-primary-outline" id="btnShowPopupAssDetection">Association Detection</button>
                        <button class="button button-primary-outline" id="btnExportExcel">Export Excel</button>
                        <button class="button button-primary-outline" id="btnVerifyAndClose">Verify and Close</button>
                    </div>
                </div>
                <div class="group-table" id="groupTable">                   
                    <div id="first-monitor-datatable">
                        <div id="tbrMMHomeTeam" class="table-report" style="width: 100%">
                            <table id="tblMMHomeTeam" class="table table-striped table-monitor-detail">
                                <thead>
                                    <tr>
                                        <th><input name="select_all" value="1" id="inputHomeSelectAll" type="checkbox" class="col-checkbox" /></th>
                                        <th>Username</th>
                                        <th>CC</th>
                                        <th>Bot</th>
                                        <th>Dgr</th>
                                        <th>Odds</th>
                                        <th>BetID</th>
                                        <th>Cur</th>
                                        <th>Amount</th>
                                        <th>HDP</th>
                                        <th>Score</th>
                                        <th>Transtime</th>
                                        <th title="Auto-detected Association Group">
                                            A.Gr.
                                        </th>
                                        <th title="Manual-detected Association Group: max. 1001 Usernames">
                                            M.Gr.<sup style="vertical-align: super; font-size: smaller;">i</sup>
                                        </th>
                                        <th>Reason</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>     
                        <table id="tblHomeHeaderFixed"></table>
                    </div>

                    <div id="second-monitor-datatable">
                        <div id="tbrMMAwayTeam" class="table-report" style="width: 100%">
                            <table id="tblMMAwayTeam" class="table table-striped table-monitor-detail">
                                <thead>
                                    <tr>
                                        <th><input name="select_all" value="1" id="inputAwaySelectAll" type="checkbox" class="col-checkbox" /></th>
                                        <th>Username</th>
                                        <th>CC</th>
                                        <th>Bot</th>
                                        <th>Dgr</th>
                                        <th>Odds</th>
                                        <th>BetID</th>
                                        <th>Cur</th>
                                        <th>Amount</th>
                                        <th>HDP</th>
                                        <th>Score</th>
                                        <th>Transtime</th>
                                        <th title="Auto-detected Association Group">
                                            A.Gr.
                                        </th>
                                        <th title="Manual-detected Association Group: max. 1001 Usernames">
                                            M.Gr.<sup style="vertical-align: super; font-size: smaller;">i</sup>
                                        </th>
                                        <th>Reason</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div> 
                        <table id="tblAwayHeaderFixed"></table>
                    </div>
                </div>
            </div>
        </div>               

        <div class="hide">
            <input id="hdEventDataToString" type="hidden" value="@ViewBag.EventDateToString" />
            <input id="hdMatchID" type="hidden" value="@ViewBag.MatchID" />
            <input id="hdMatchName" type="hidden" value="@ViewBag.MatchName" />
            <input id="hdBetTypeID" type="hidden" value="@ViewBag.BetTypeID" />
            <input id="hdBetTypeName" type="hidden" value="@ViewBag.BettypeName" />
            <input id="hdBetIDToString" type="hidden" value="@ViewBag.BetIDToString" />
            <input id="hdLiveIndicator" type="hidden" value="@ViewBag.LiveIndicator.ToString()" />
            <input id="hdreason" type="hidden" value="@ViewBag.Reason" />
            <input id="hdIsSupportShowAllTickets" type="hidden" value="@ViewBag.IsSupportShowAllTickets.ToString()" />
            <input id="hdIsHostPermission" type="hidden" IsHostPermission="@ViewBag.IsHostPermission.ToString()" />
        </div>
    </div>    
</section>

<div id="divPopupAssDetect" class="popup-add" style="display: none">
    <div class="flex-container">
        <div class="box-left">
            <div class="flex-container" style="border-bottom: 1px solid #C0C0C0;">
                <div style="margin-top: 1px; margin-bottom: 1px;">
                    <span class='icon-Check'></span>
                    <span class="checkbox-filter checkbox-all">
                        <span class="checkbox-filter" id="tickCheckAll">Check all</span>
                    </span>

                    <span class='icon-Close'></span>
                    <span class="checkbox-filter checkbox-all">
                        <span class="checkbox-filter" id="tickUncheckAll">Uncheck all</span>
                    </span>
                </div>

            </div> <!--div end - flex-container-->

            <div class="flex-container">
                <div>
                    <span class="checkbox-filter">
                        <label class="checkbox-container" id="ckbOptBPContainer">
                            <input id="inputOptBP" type="checkbox">
                            <span class="checkmark"></span>
                            Betting Pattern
                        </label>
                    </span>

                    <span class="checkbox-filter">
                        <label class="checkbox-container" id="ckbOptDeviceContainer">
                            <input id="inputOptDevice" type="checkbox">
                            <span class="checkmark"></span>
                            Device
                        </label>
                    </span>

                    <span class="checkbox-filter">
                        <label class="checkbox-container" id="ckbOptIPContainer">
                            <input id="inputOptIP" type="checkbox">
                            <span class="checkmark"></span>
                            IP
                        </label>
                    </span>

                    <span class="checkbox-filter">
                        <label class="checkbox-container" id="ckbOptAgentContainer">
                            <input id="inputOptAgent" type="checkbox" checked>
                            <span class="checkmark"></span>
                            Agent
                        </label>
                    </span>

                    <span class="checkbox-filter">
                        <label class="checkbox-container" id="ckbOpt3MatchesLast7DaysContainer">
                            <input id="inputOpt3MatchesLast7Days" type="checkbox" checked>
                            <span class="checkmark"></span>
                            3 Matches(last 7 days)
                        </label>
                    </span>

                    <span class="checkbox-filter">
                        <label class="checkbox-container" id="ckbOptIPLast3DaysContainer">
                            <input id="inputOptIPLast3Days" type="checkbox" checked>
                            <span class="checkmark"></span>
                            IP(last 3 days)
                        </label>

                    </span>
                </div>
            </div> <!--div end - flex-container margin-top-10-->
        </div>

        <div class="box-right">
            <button id="btnAssDetection" class="button button-primary-outline" title="Association Detection">Detect</button>
        </div>

        <div class="hide">
            <input id="hdSelectedCTSCustIDs" type="hidden" />
            <input id="hdSelectedCustIDs" type="hidden" />
        </div>
    </div>
</div>

@section scripts{
    @Scripts.Render("~/match-monitor-detail-scripts")
}