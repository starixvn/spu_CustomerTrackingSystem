@{ ViewBag.Title = "MATCH MONITOR DETAIL";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section styles{
    @Styles.Render("~/match-monitor-styles")
}

<section class="detailpage" id="detailpage">
    <div class="content">
        <h2 class="page-title">MATCH MONITOR DETAIL</h2>
    </div>

    <div class="monitor-container">
        <div class="monitor-table">
            <div class="group-control">
                <div class="group-info filter-group">
                    <div class="form-filter">
                        <div class="group width-120">
                            <label class="text">Site</label>
                            <select class="control width-select-sites" id="cbbSites">
                                <option value="A">All</option>
                                <option value="C">Credit</option>
                                <option value="L">Licensee</option>
                            </select>
                        </div>

                        <div class="group-button">
                            <button class="button button-generate" id="btnRefresh">Refresh</button>
                        </div>

                        <div class="blank"></div>
                       
                        <div class="group width-180" style="display: none;">
                            <label class="text">Bet choice</label>
                            <select class="control width-select" id="cbbBetChoice">
                                @if (ViewBag.BetChoice != null)
                                {
                                    foreach (var item in ViewBag.BetChoice)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="group width-180" @(ViewBag.IsDisableScoreFilter ? "hidden" : "")   >
                            <label class="text">Score</label>
                            <select class="control width-select" id="cbbMatchScore" multiple="multiple">
                                @if (ViewBag.MatchScore != null)
                                {
                                    foreach (var item in ViewBag.MatchScore)
                                    {
                                        <option value="@item.ScoreDiff" selected>@item.LiveHomeScore - @item.LiveAwayScore </option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="group">
                            <label class="text">Reason</label>
                            <select class="control width-select" id="cbbReason" multiple="multiple">
                                <option value="1" selected>TODO</option>
                                <option value="2" selected>TODO</option>
                            </select>
                        </div>

                        <div class="group width-180" @(ViewBag.IsDisableGroup ? "hidden" : "")>
                            <label class="text">Group</label>
                            <select class="control width-select" id="cbbGroup" multiple="multiple">
                                @if (ViewBag.Group != null)
                                {
                                    foreach (var item in ViewBag.Group)
                                    {
                                        <option value="@item.Key" selected> TODO </option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="group-button">
                            <button class="button button-generate" id="btnGenerate-detail">Generate</button>
                        </div>                        
                    </div>
                    <div class="detail-area">
                        <span>@ViewBag.MatchName <br /></span>
                        <span class="league-highlight">@ViewBag.LeagueName<br /></span>
                        <span>@ViewBag.SportName - @ViewBag.BettypeName - <span class="market-highlight">@ViewBag.MarketName</span><br /></span>
                        <span id="spanKOTime">KO Time: @ViewBag.KOTime<br /></span>
                        <span class="reason-highlight" id="spanReason">TODO</span>
                    </div>
                </div>

                <div class="breadcrumb-button">
                    <div class="">
                        <button class="button button-primary-outline" id="btnShowAll">Show All</button>
                        <button class="button button-primary-outline" id="btnAssDetection">Association Detection</button>
                        <button class="button button-primary-outline" id="btnExportExcel">Export Excel</button>
                        <button class="button button-primary-outline" id="btnVerifyAndClose">Verify and Close</button>
                    </div>
                </div>
                <div class="group-table" id="groupTable">                   
                    <div id="first-monitor-datatable">
                        <div class="table-report">
                            <div class="fixed-header">
                                <div class="top-header">
                                    <button class="button button-primary-outline" id="btnVerify">Verify & Close</button>
                                </div>
                            </div>

                            <table id="first-tblMonitor" class="table table-striped table-monitor-detail">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Username</th>
                                        <th>CC</th>
                                        <th>Bot</th>
                                        <th>Dgr</th>
                                        <th>Odds</th>
                                        <th>BetID</th>
                                        <th>Cur</th>
                                        <th>Amount</th>
                                        <th>HDP</th>
                                        <th>Score</th>
                                        <th>Transtime</th>
                                        <th>Group</th>
                                        <th>Reason</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>

                    <div id="second-monitor-datatable">
                        <div class="table-report" style="width : 100%">
                            <table id="secondtblMonitor" class="table table-striped table-monitor-detail">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Username</th>
                                        <th>CC</th>
                                        <th>Bot</th>
                                        <th>Dgr</th>
                                        <th>Odds</th>
                                        <th>BetID</th>
                                        <th>Cur</th>
                                        <th>Amount</th>
                                        <th>HDP</th>
                                        <th>Score</th>
                                        <th>Transtime</th>
                                        <th>Group</th>
                                        <th>Reason</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="hide">
            <input id="hdEventDataToString" type="hidden" value="@ViewBag.EventDateToString" />
            <input id="hdMatchID" type="hidden" value="@ViewBag.MatchID" />
            <input id="hdBetTypeID" type="hidden" value="@ViewBag.BetTypeID" />
            <input id="hdBetIDToString" type="hidden" value="@ViewBag.BetIDToString" />
            <input id="hdLiveIndicator" type="hidden" value="@ViewBag.LiveIndicator.ToString()" />
            <input id="hdreason" type="hidden" value="@ViewBag.Reason" />
            <input id="hdIsDisableGroup" type="hidden" value="@ViewBag.IsDisableGroup.ToString()" />
            <input id="hdIsHostPermission" type="hidden" IsHostPermission="@ViewBag.IsHostPermission.ToString()" />
        </div>
    </div>
</section>
@section scripts{
    @Scripts.Render("~/match-monitor-detail-scripts")
}