
@{
    ViewBag.Title = "MATCH MONITOR DETAIL";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles{
    @Styles.Render("~/match-monitor-styles")
}

<section class="match-monitor detailpage">
    <div class="content">
        <h2 class="page-title">MATCH MONITOR DETAIL</h2>
    </div>

    <div class="monitor-container">
        <div class="monitor-table">
            <div class="group-control">
                <div class="form-filter">
                    <div class="group width-180">
                        <label class="text">Match Event</label>
                        <div class="control width-select text-box">Manchester City vs Chelsea</div>
                    </div>
                    <div class="group width-180">
                        <label class="text">Live/Non-live</label>
                        <select class="control width-select" id="cbbAccountStatus">
                            <option selected>Non-live</option>
                            <option>Live</option>
                        </select>
                    </div>
                    <div class="group width-180">
                        <label class="text">Score</label>
                        <select class="control width-select" id="cbbAccountStatus">
                            <option>4 of 4 selected</option>
                            <option>3 of 3 selected</option>
                            <option>2 of 2 selected</option>
                        </select>
                    </div>
                    <div class="group width-180">
                        <label class="text">Reason Group</label>
                        <select class="control width-select" id="cbbAccountStatus">
                            <option>30 of 30 selected</option>
                            <option>3 of 3 selected</option>
                            <option>2 of 2 selected</option>
                        </select>
                    </div>
                    <button class="button button-generate" id="btnGenerate-detail">Generate</button>
                </div>
            </div>
            <div class="group-table">
                <div id="first-monitor-datatable" class="report-cont">
                    <div class="table-report" style="width : 100%">
                        <table id="first-tblMonitor" class="table table-striped table-monitor-detail">
                            <thead>
                                <tr>
                                    <th>Site</th>
                                    <th>Username</th>
                                    <th>Dgr</th>
                                    <th>ODDS</th>
                                    <th>BetID</th>
                                    <th>CUR</th>
                                    <th>Live/Non-Live</th>
                                    <th>AMOUNT</th>
                                    <th>HDP</th>
                                    <th>Score</th>
                                    <th>TRANSTIME</th>
                                    <th>Reason Group</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

                <div id="second-monitor-datatable" class="report-cont">
                    <div class="table-report" style="width : 100%">
                        <table id="second-tblMonitor" class="table table-striped table-monitor-detail">
                            <thead>
                                <tr>
                                    <th>Site</th>
                                    <th>Username</th>
                                    <th>Dgr</th>
                                    <th>ODDS</th>
                                    <th>BetID</th>
                                    <th>CUR</th>
                                    <th>Live/Non-Live</th>
                                    <th>AMOUNT</th>
                                    <th>HDP</th>
                                    <th>Score</th>
                                    <th>TRANSTIME</th>
                                    <th>Reason Group</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>  


@section scripts{
    @Scripts.Render("~/match-monitor-scripts")
}