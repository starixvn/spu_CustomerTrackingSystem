
@{
    ViewBag.Title = "MATCH MONITOR DETAIL";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles{
    @Styles.Render("~/match-monitor-styles")
}

<section class="match-monitor detailpage">
    <div class="content">
        <h2 class="page-title">MATCH MONITOR DETAIL</h2>
    </div>

    <div class="monitor-container">
        <div class="monitor-table">
            <div class="group-control">
                <div class="form-filter">
                    <div class="group width-180">
                        <label class="text">Match Event</label>
                        <div class="control width-select text-box">@ViewBag.MatchName</div>
                    </div>
                    <div class="group width-180">
                        <label class="text">Live/Non-live</label>
                        <select class="control width-select" id="cbbLiveIndicator">
                            <option value="false" selected>Non-live</option>
                            <option value="true" >Live</option>
                        </select>
                    </div>
                    <div class="group width-180">
                        <label class="text">Score</label>
                        <select class="control width-select" id="cbbMatchScore" multiple="multiple">
                            @if (ViewBag.MatchScore != null)
                            {
                                foreach (var item in ViewBag.MatchScore)
                                {
                                    <option value="@item.TotalScore" @(item.TotalScore == 0 ? "selected" : "")>@item.LiveHomeScore - @item.LiveAwayScore </option>
                                }
                            }
                        </select>
                    </div>
                    <div class="group width-180">
                        <label class="text">Reason Group</label>
                        <select class="control width-select" id="cbbReasonGroup" multiple="multiple">
                            @*@{
                                int preIncrement1 = 0;
                                int preIncrement2 = 0;
                            }
                            @if (ViewBag.ReasonGroup != null)
                            {
                                foreach (var item in ViewBag.ReasonGroup)
                                {
                                    if (@item.IsHedging)
                                    {
                                        <option value="@item.GroupID"> Hedging @(preIncrement1++) </option>
                                    }
                                    else
                                    {
                                        <option value="@item.GroupID"> Group Betting @(preIncrement2++) </option>
                                    }
                                }
                            }*@

                            @if (ViewBag.ReasonGroup != null)
                            {
                                foreach (var item in ViewBag.ReasonGroup)
                                {
                                    <option value="@item.GroupID"> @item.ReasonGroupName </option>
                                }
                            }
                        </select>
                    </div>
                    <button class="button button-generate" id="btnGenerate-detail">Generate</button>
                </div>
            </div>
            <div class="group-table">
                <div id="first-monitor-datatable" class="report-cont">
                    <div class="table-report" style="width : 100%">
                        <table id="first-tblMonitor" class="table table-striped table-monitor-detail">
                            <thead>
                                <tr>
                                    <th>Site</th>
                                    <th>Username</th>
                                    <th>Dgr</th>
                                    <th>ODDS</th>
                                    <th>BetID</th>
                                    <th>CUR</th>
                                    <th>Live/Non-Live</th>
                                    <th>AMOUNT</th>
                                    <th>HDP</th>
                                    <th>Score</th>
                                    <th>TRANSTIME</th>
                                    <th>Reason Group</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

                <div id="second-monitor-datatable" class="report-cont">
                    <div class="table-report" style="width : 100%">
                        <table id="second-tblMonitor" class="table table-striped table-monitor-detail">
                            <thead>
                                <tr>
                                    <th>Site</th>
                                    <th>Username</th>
                                    <th>Dgr</th>
                                    <th>ODDS</th>
                                    <th>BetID</th>
                                    <th>CUR</th>
                                    <th>Live/Non-Live</th>
                                    <th>AMOUNT</th>
                                    <th>HDP</th>
                                    <th>Score</th>
                                    <th>TRANSTIME</th>
                                    <th>Reason Group</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="hide">
        <input id="hdEventDataToString" type="hidden" value="@ViewBag.EventDateToString" />
        <input id="hdMatchID" type="hidden" value="@ViewBag.MatchID" />
        <input id="hdBetTypeID" type="hidden" value="@ViewBag.BetTypeID" />
        <input id="hdIsHostPermission" type="hidden" IsHostPermission="@ViewBag.IsHostPermission.ToString()" />
    </div>
</section>  


@section scripts{
    @Scripts.Render("~/match-monitor-detail-scripts")
}