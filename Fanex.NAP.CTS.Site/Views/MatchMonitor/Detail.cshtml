@{ ViewBag.Title = "MATCH MONITOR DETAIL";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section styles{
    @Styles.Render("~/match-monitor-styles")
}

<section class="match-monitor detailpage">
    <div class="content">
        <h2 class="page-title">MATCH MONITOR DETAIL</h2>
    </div>

    <div class="monitor-container">
        <div class="monitor-table">
            <div class="group-control">
                <div class="group-table">
                    <div class="form-filter">
                        <div class="group width-180">
                            <label class="text">Sites</label>
                            <select class="control width-select" id="cbbSites">
                                <option value="A">All</option>
                                <option value="C">Credit</option>
                                <option value="L">Licensee</option>
                            </select>
                        </div>
                        <div class="group width-180">
                            <label class="text">Score</label>
                            <select class="control width-select" id="cbbMatchScore" multiple="multiple">
                                @if (ViewBag.MatchScore != null)
                                {
                                    foreach (var item in ViewBag.MatchScore)
                                    {
                                        <option value="@item.TotalScore" selected>@item.LiveHomeScore - @item.LiveAwayScore </option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="group width-180">
                            <label class="text">Group</label>
                            <select class="control width-select" id="cbbGroup" multiple="multiple">
                                @if (ViewBag.Group != null)
                                {
                                    foreach (var item in ViewBag.Group)
                                    {
                                        <option value="@item.Key" selected> @item.GroupID </option>
                                    }
                                }
                            </select>
                        </div>
                        <button class="button button-generate" id="btnGenerate-detail">Generate</button>
                    </div>
                    <div class="detail-area">
                        <span>@ViewBag.MatchName <br /></span>
                        <span class="league-highlight">@ViewBag.LeagueName<br /></span>
                        <span>@ViewBag.ReasonName - <span class="market-highlight">@ViewBag.MarketName</span><br /></span>
                    </div>
                </div>
                <div class="group-table second-group-table-border">
                    <button class="button button-verification" id="btnVerify">Verify & Close</button>
                </div>
                <div class="group-table third-group-table-border">
                    <div id="first-monitor-datatable" class="report-cont">
                        <div class="table-report" style="width : 100%">
                            <table id="first-tblMonitor" class="table table-striped table-monitor-detail">
                                <thead>
                                    <tr>
                                        <th>Site</th>
                                        <th>Username</th>
                                        <th>Bot</th>
                                        <th>Dgr</th>
                                        <th>ODDS</th>
                                        <th>BetID</th>
                                        <th>CUR</th>
                                        <th>Market</th>
                                        <th>AMOUNT</th>
                                        <th>HDP</th>
                                        <th>Score</th>
                                        <th>TRANSTIME</th>
                                        <th>Group</th>
                                        <th>PIC & Last Verified</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>

                    <div id="second-monitor-datatable" class="report-cont">
                        <div class="table-report" style="width : 100%">
                            <table id="second-tblMonitor" class="table table-striped table-monitor-detail">
                                <thead>
                                    <tr>
                                        <th>Site</th>
                                        <th>Username</th>
                                        @*<th>Bot</th>*@
                                        <th>Dgr</th>
                                        <th>ODDS</th>
                                        <th>BetID</th>
                                        <th>CUR</th>
                                        <th>Market</th>
                                        <th>AMOUNT</th>
                                        <th>HDP</th>
                                        <th>Score</th>
                                        <th>TRANSTIME</th>
                                        <th>Group</th>
                                       @* <th>PIC & Last Verified</th>*@
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="hide">
            <input id="hdEventDataToString" type="hidden" value="@ViewBag.EventDateToString" />
            <input id="hdMatchID" type="hidden" value="@ViewBag.MatchID" />
            <input id="hdBetTypeID" type="hidden" value="@ViewBag.BetTypeID" />
            <input id="hdLiveIndicator" type="hidden" value="@ViewBag.LiveIndicator.ToString()" />
            <input id="hdIsHedging" type="hidden" value="@ViewBag.IsHedging.ToString()" />
            <input id="hdIsHostPermission" type="hidden" IsHostPermission="@ViewBag.IsHostPermission.ToString()" />
        </div>
</section>
@section scripts{
    @Scripts.Render("~/match-monitor-detail-scripts")
}