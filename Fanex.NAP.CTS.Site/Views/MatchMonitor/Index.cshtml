
@{
    ViewBag.Title = "MATCH MONITOR";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles{
    @Styles.Render("~/match-monitor-styles")
}

<section class="match-monitor">
    <div class="content">
        <h2 class="page-title">MATCH MONITOR</h2>
    </div>
        
    <div class="monitor-container">
        <div class="monitor-table">
            <div class="group-control">
                <div class="title-association"><div class="label">Date</div></div>
                <div class="form-filter">
                    <div class="group calendar width-180">
                        <label class="text">From</label>
                        <input type="text" id="dpkFromDate" class="control" readonly>
                        <span class="icon-calendar-text"></span>
                    </div>
                    <div class="group calendar width-180">
                        <label class="text">To</label>
                        <input type="text" id="dpkToDate" class="control" readonly>
                        <span class="icon-calendar-text"></span>
                    </div>
                    <div class="group width-180">
                        <label class="text">Verified</label>
                        <select class="control width-select" id="cbbAccountStatus">
                            <option>Yes</option>
                            <option>Yes</option>
                            <option>Yes</option>
                        </select>
                    </div>
                    <div class="group width-180">
                        <label class="text">Bet Type</label>
                        <select class="control width-select" id="cbbAccountStatus">
                            <option>4 of 4 selected</option>
                            <option>3 of 3 selected</option>
                            <option>2 of 2 selected</option>
                        </select>
                    </div>
                    <button class="button button-generate" id="btnGenerate">Generate</button>
                    <div class="group-droup-down">
                        <button class="button button-generate btn-refresh" id="btnGenerateMonitor">Refesh(8)</button>
                        <ul class="refresh-list">
                            <li><a href="#">Refesh(8)</a></li>
                            <li><a href="#">Refesh(9)</a></li>
                            <li><a href="#">Refesh(10)</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div id="monitor-datatable" class="report-cont">
                <div class="table-report" style="width : 100%">
                    <table id="tblMonitor" class="table table-striped table-monitor">
                        <thead>
                            <tr>
                                <th>Match</th>
                                <th>Event Date</th>
                                <th>League</th>
                                <th>Reason</th>
                                <th>PIC</th>
                                <th>Last Verified</th>
                                <th>Verified</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</section>



    @section scripts{
        @Scripts.Render("~/match-monitor-scripts")
    }
