@{
    ViewBag.Title = "Associated Account Monitor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/probation-management-styles")
}

<h2 class="page-title">Probation Management</h2>



<div class="probation-content">
    <div id="probation-detail-container" class="report-content">
        <div id="tabs-probation-detail" class="tabs-probation-detail">
            <ul class="fixed-tabs">
                <li><a href="#tabs-1" id="greneral-tab">Greneral Category</a></li>
                <li><a href="#tabs-2" id="detailed-tab">Detailed Category</a></li>
            </ul>
            <div id="tabs-1">
                <div class="probation-table">
                    <div class="form-control mb-0">
                        <div class="label">Username</div>
                        <input type="text" name="name" value="" placeholder="" />
                    </div>
                    <div class="form-control mb-0">
                        <div class="label">Probation Day Left:</div>
                        <input type="number" name="name" value="" placeholder="" />
                    </div>
                    <div class="form-control form-group mb-0">
                        <div class="label">Current Margin:</div>
                        <div class="flex-form">
                            <div class="form-control mb-0 variable">
                                <label>Min</label>
                                <input type="number" name="name" value="" />
                            </div>
                            <div class="form-control mb-0 variable">
                                <label>Max</label>
                                <input type="number" name="name" value="" />
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-probation">Gererate</button>
                </div>


                <div id="greneral" class="report-cont">
                    <div id="account-by-account">
                        <div class="table-report">
                            <table id="probation-managament" class="table table-striped table-tab-mt" style="width: 100%">
                                <thead>
                                    <tr>
                                        <th>No</th>
                                        <th>Username</th>
                                        <th>Site</th>
                                        <th>Sport</th>
                                        <th>Target Category</th>
                                        <th>Tagged Date</th>
                                        <th>First Margin</th>
                                        <th>Current_margin</th>
                                        <th>Probation Day Left</th>
                                        <th>Edit</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div id="tabs-2">
                <div id="chains_evidence" class="report-cont">

                    <div id="account-by-account">
                        <div class="table-report">
                            <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




@section scripts{
    @Scripts.Render("~/probation-management-scripts")
}
