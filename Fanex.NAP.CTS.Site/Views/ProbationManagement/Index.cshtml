@using Fanex.NAP.CTS.ViewModel.ProbationManagement
@{
    ViewBag.Title = "Probation Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/probation-management-styles")
}

<h2 class="page-title">Probation Management</h2>

<div class="probation-content">
    <div id="probation-detail-container" class="report-content">
        <div id="tabs-probation-detail" class="tabs-probation-detail">
            <ul class="fixed-tabs">
                <li><a href="#tabGeneral" id="greneral-tab">Greneral Category</a></li>
                <li><a href="#tabDetailed" id="detailed-tab">Detailed Category</a></li>
            </ul>
            <div id="tabGeneral">
                <div class="probation-table">
                    <div class="form-control mb-0">
                        <div class="label">Username</div>
                        <input type="text" id="inputUserNameGeneral" value="" placeholder="" />
                    </div>
                    <div class="form-control mb-0">
                        <div class="label">Probation Day Left:</div>
                        <input type="number" id="inputDayLeftGeneral" value="" placeholder="" />
                    </div>
                    <div class="form-control form-group mb-0">
                        <div class="label">Current Margin:</div>
                        <div class="flex-form">
                            <div class="form-control mb-0 variable">
                                <label>Min</label>
                                <input type="number" id="inputMinMarginGeneral" value="" class="number-min" />
                            </div>
                            <div class="form-control mb-0 variable">
                                <label>Max</label>
                                <input type="number" id="inputMaxMarginGeneral" value="" class="number-max" />
                            </div>
                        </div>
                    </div>
                    <button type="submit" id="btnGenerateGeneral" class="btn btn-probation">Generate</button>
                </div>

                <div id="gridGeneral" class="report-cont" hidden>
                    <div>
                        <div class="table-report">
                            <table id="tblGeneral" class="table table-striped table-tab-mt" style="width: 100%">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Username</th>
                                        <th>Site</th>
                                        <th>Sport</th>
                                        <th>Target Category</th>
                                        <th>Tagged Date</th>
                                        <th>First Margin (%)</th>
                                        <th>Current Margin (%)</th>
                                        <th>Probation Day Left</th>
                                        <th>Edit</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div id="tabDetailed">
                <div class="probation-table">
                    <div class="form-control mb-0">
                        <div class="label">Username</div>
                        <input type="text" id="inputUserNameDetailed" placeholder="" />
                    </div>
                    <div class="form-control mb-0">
                        <div class="label">Probation Day Left:</div>
                        <input type="number" id="inputDayLeftDetailed" placeholder="" />
                    </div>
                    <div class="form-control form-group mb-0">
                        <div class="label">Current Margin:</div>
                        <div class="flex-form">
                            <div class="form-control mb-0 variable">
                                <label>Min</label>
                                <input type="number" id="inputMinMarginDetailed" />
                            </div>
                            <div class="form-control mb-0 variable">
                                <label>Max</label>
                                <input type="number" id="inputMaxMarginDetailed" />
                            </div>
                        </div>
                    </div>
                    <button id="btnGenerateDetailed" class="btn btn-probation">Generate</button>
                </div>

                <div id="gridDetailed" class="report-cont" hidden>
                    <div>
                        <div class="table-report">
                            <table id="tblDetailed" class="table table-striped table-tab-mt" style="width: 100%">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Username</th>
                                        <th>Site</th>
                                        <th>Sport</th>
                                        <th>Target Category</th>
                                        <th>Tagged Date</th>
                                        <th>First Margin (%)</th>
                                        <th>Current Margin (%)</th>
                                        <th>Probation Day Left</th>
                                        <th>Edit</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="formGeneralCategories" hidden class="form-change-category">
            <div>
                <ul class="ui-menu ui-corner-bottom ui-widget ui-widget-content">
                    @foreach (var item in (IEnumerable<CategoryViewModel>)ViewBag.GeneralCategories)
                    {
                        <li class="ui-menu-item"><span id="@item.CategoryID">@item.CategoryName</span></li>
                    }
                </ul>
            </div>
        </div>

        <div id="formDetailedCategories" hidden class="form-change-category">
            <div>
                <ul class="ui-menu ui-corner-bottom ui-widget ui-widget-content">
                    @foreach (var item in (IEnumerable<CategoryViewModel>)ViewBag.DetailedCategories)
                    {
                        <li class="ui-menu-item"><span id="@item.CategoryID">@item.CategoryName</span></li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<div hidden>
    <input id="hdIsHostPermission" type="hidden" IsHostPermission="@Model.ToString()" />
</div>

@section scripts{
    @Scripts.Render("~/probation-management-scripts")
}
