@using Fanex.NAP.CTS.Model.ProbationManagement
@using Fanex.NAP.CTS.Model.ManageSubscriber
@{
    ViewBag.Title = "Probation Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/probation-management-styles")
}

<h2 class="page-title">Probation Management</h2>

<div class="probation-content">
    <div id="probation-detail-container" class="report-content">
        <div id="tabs-probation-detail" class="tabs-probation-detail">
            <div class="header-fixed">
                <ul class="fixed-tabs">
                    <li><a href="#tabGeneral" id="greneral-tab">General Category</a></li>                    
                </ul>
            </div>
            <div id="tabGeneral" class="tbl-general">
                <div class="probation-table">
                    <div class="form-control mb-0">
                        <div class="label">Username:</div>
                        <input type="text" id="inputUserNameGeneral" value="" placeholder="" maxlength="50" />
                    </div>
                    <div class="form-control mb-0" style="width: 200px">
                        <div class="label">Site:</div>
                        <select class="control" id="cbbSiteGeneral">
                            @{ var selected = true; }
                            @foreach (var item in (IEnumerable<SubscriberModel>)ViewBag.Subscribers)
                            {
                                if (selected)
                                {
                                    selected = false;
                                    <option value="@item.SubscriberID" selected>@item.SubscriberName</option>
                                }
                                else
                                {
                                    <option value="@item.SubscriberID">@item.SubscriberName</option>
                                }                                
                            }
                        </select>
                    </div>
                    <div class="form-control mb-0" style="width: 120px">
                        <div class="label">Status:</div>
                        <select class="control" id="cbbAccountStatusGeneral" style="width: 120px">
                            @{ var defaultSelecteds = "OPEN"; }
                            @foreach (var item in (IEnumerable<AccountStaticStatusModel>)ViewBag.AccountStaticStatuses)
                            {
                                if (defaultSelecteds.Contains(item.ItemName.ToUpper()))
                                {
                                    <option value="@item.ItemName" selected>@item.ItemNameDisplay</option>
                                }
                                else
                                {
                                    <option value="@item.ItemName">@item.ItemNameDisplay</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-control mb-0">
                        <div class="label">Probation Day Left:</div>
                        <select class="control" id="cbbDaysLeft" style="width:130px">
                            <option value="0-10" selected>0 - 10</option>
                            <option value="11-20">11 - 20</option>
                        </select>
                    </div>
                    <div class="form-control mb-0">
                        <div class="label">Associated With PA:</div>
                        <select class="control" id="cbbAssociatedWithPAGeneral" style="width:130px">
                            <option value="-1" selected>All</option>
                            <option value="1">Yes</option>
                            <option value="0">No</option>
                        </select>
                    </div>
                    <div class="form-control form-group mb-0">
                        <div class="label">Current WinLost:</div>
                        <div class="flex-form">
                            <div class="form-control mb-0 variable">
                                <label>Min:</label>
                                <input type="number" id="inputMinWinLossGeneral" value="" class="number-min" step="0.01" />
                            </div>
                            <div class="form-control mb-0 variable">
                                <label>Max:</label>
                                <input type="number" id="inputMaxWinLossGeneral" value="" class="number-max" step="0.01" />
                            </div>
                        </div>
                    </div>
                    <div class="form-control form-group mb-0">
                        <div class="label">Current Margin (%):</div>
                        <div class="flex-form">
                            <div class="form-control mb-0 variable">
                                <label>Min:</label>
                                <input type="number" id="inputMinMarginGeneral" value="" class="number-min" step="0.01" />
                            </div>
                            <div class="form-control mb-0 variable">
                                <label>Max:</label>
                                <input type="number" id="inputMaxMarginGeneral" value="" class="number-max" step="0.01" />
                            </div>
                        </div>
                    </div>
                    <button id="btnExportGeneral" class="btn btn-probation">Export</button>                    
                </div>
            </div>                           
        </div>       
    </div>
</div>

<div hidden>
    <input id="hdIsHostPermission" type="hidden" IsHostPermission="@Model.IsHostPermission.ToString()" />
    <input id="hdProbationFilterType" type="hidden" value="@Model.ProbationFilterType" />
</div>

@section scripts{
    @Scripts.Render("~/probation-management-scripts")
}
