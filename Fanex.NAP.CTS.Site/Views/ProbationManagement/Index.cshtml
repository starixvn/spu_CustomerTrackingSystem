@{
    ViewBag.Title = "Associated Account Monitor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/probation-management-styles")
}

<h2 class="page-title">Probation Management</h2>



<div class="content-card">
    <div id="account-detail-container" class="report-content">
        <div id="tabs-account-detail" class="tabs-account-detail">
            <ul class="fixed-tabs">
                <li><a href="#tabs-1" id="associated_account-tab">Greneral Category</a></li>
                <li><a href="#tabs-2" id="evidence-tab">Detailed Category</a></li>
            </ul>
            <div id="tabs-1">
                <div id="associated_account" class="report-cont">
                    <div id="account-by-account">
                        <div class="table-report" id="account-by-account-content">
                            <table id="account-by-account-table" class="table table-striped" style="width: 100%">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Category</th>
                                        <th>Sport</th>
                                        <th>Target Category</th>
                                        <th>First Margin</th>
                                        <th>Current margin</th>
                                        <th>Probation Duration</th>
                                        <th>Edit</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div id="tabs-2">
                <div id="chains_evidence" class="report-cont">
                    <div id="account-by-account">
                        <div class="table-report" id="account-by-account-content">
                            <table id="account-by-account-table" class="table table-striped" style="width: 100%">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Category</th>
                                        <th>Sport</th>
                                        <th>Target Category áddasadsdassadsdasda</th>
                                        <th>First Margin</th>
                                        <th>Current margin</th>
                                        <th>Probation Duration</th>
                                        <th>Edit</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section scripts{
    @Scripts.Render("~/probation-management-scripts")
}
