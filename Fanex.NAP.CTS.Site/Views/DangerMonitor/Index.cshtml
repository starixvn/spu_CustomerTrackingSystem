@using Fanex.NAP.CTS.ViewModel.DangerMonitor
@{
    ViewBag.Title = "DANGER MONITOR";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles{
    @Styles.Render("~/danger-monitor-styles")
}

<body class="match-monitor-page">
    <section class="match-monitor">
        <div class="content">
            <h2 class="page-title">DANGER MONITOR</h2>
        </div>

        <div class="monitor-container">
            <div class="monitor-table">
                <div class="group-control">
                    <div class="title-association">                      
                    <div class="form-filter">
                        <div class="group width-custom">
                            <div class="radio-button">
                                <input type="radio" id="rbtnDgr" name="radioSelect" value="0" checked>
                                <label for="rbtnDgr" class="text">Dgr</label>
                            </div>
                            <select class="control width-select" id="cbbDgr"></select>
                        </div>
                        <div class="group width-180" style="margin-right: 9px;">
                            <div class="radio-button">
                                <input type="radio" id="rbtnUsername" name="radioSelect" value="1">
                                <label for="rbtnUsername" class="text">Username</label>
                            </div>
                            <div class="input-username width-180">
                                <input class="control" style="padding-right: 50px;" type="text" id="txtUsername" placeholder="Max 1000 Usernames"/>
                                <span class="icon-clear icon-icon-clear" id="btnClearUsername"></span>
                                <span class="icon-modify icon-icon-modify" id="btnModifyUsername"><span class="path1"></span><span class="path2"></span></span>
                            </div>
                        </div>

                        <div class="group width-custom">
                            <div class="text">
                                <!-- <input id="checkboxFrom" type="checkbox" style="display:inline" checked/> -->
                                <label>Association</label>
                            </div>
                            <select class="control width-select" id="cbbAssociation" multiple="multiple">
                                <optgroup label="Association" data-group="with">
                                    <option value="BettingPattern">Betting Pattern</option>
                                    <option value="Device">Device</option>
                                    <option value="IP">IP</option>
                                </optgroup>
                                <optgroup label="No Association" data-group="none">
                                    <option value="None" selected>None</option>
                                </optgroup>
                            </select>
                        </div>

                        <div class="group width-180">
                            <div class="text">
                                <!-- <input id="checkboxFrom" type="checkbox" style="display:inline" checked/> -->
                                <label>Event Date</label>
                            </div>
                            <div class="calendar width-180">
                                <label class="text">From</label>
                                <input type="text" id="dpkFromDate" class="control" readonly>
                                    <span class="icon-calendar-text"></span>
                            </div>
                        </div>
                        <div class="group width-180">
                            <!-- <div class="text">
                                <input id="checkboxTo" type="checkbox" style="display:inline"/>
                                <label>To</label>
                            </div> -->
                            <div class="calendar width-180">
                                <label class="text">To</label>
                                <input type="text" id="dpkToDate" class="control" readonly>
                                    <span class="transtime-icon icon-clear icon-icon-clear" id="iconClear"></span>
                                    <span class="icon-calendar-text"></span>
                            </div>
                        </div>
                        <div class="group width-custom">
                            <label class="text">Sport</label>
                            <select class="control width-select" id="cbbSport"></select>
                        </div>

                         <div class="group width-180">
                            <label class="text">League Group</label>
                            <select class="control width-select" id="cbbLeagueGroup" multiple="multiple"></select>
                        </div>

                        <div class="group width-custom">
                            <label class="text">Event</label>
                            <input class="control input-event" type="text" id="txtEvent" placeholder="League/Match" />
                        </div>
                        <div class="group width-custom">
                            <label class="text">Market</label>
                            <select class="control width-select" id="cbbMarket">
                                <option value="" selected>All</option>
                                <option value="1">Live</option>
                                <option value="0">Non-Live</option>
                            </select>
                        </div>
                        <div class="group width-custom">
                            <label class="text">Match Section</label>
                            <select class="control width-select" id="cbbMatchSection" multiple="multiple">
                                <option value="1" selected>Live</option>
                                <option value="2" selected>Today</option>
                                <option value="3" selected>Early</option>
                                <option value="4" selected>Closed</option>
                            </select>
                        </div>

                        <div class="group width-custom">
                            <label class="text">Bet Type</label>
                            <select class="control width-select" id="cbbBetType" multiple="multiple">
                            </select>
                        </div>

                        <div class="group width-custom">
                            <label class="text">Username's Amt (RM)</label>
                            <div class="input-amount">
                                <input class="control input-event" type="text" id="txtUsernameAmt" placeholder=">= please input amount" maxlength="15" />
                                <span class="icon-clear icon-icon-clear" id="btnClearUsernameAmt"></span>
                            </div>
                        </div>

                         <div class="group width-custom">
                            <label class="text">Total Amt (RM)</label>
                            <div class="input-amount">
                                <input class="control input-event" type="text" id="txtTotalAmt" placeholder=">= please input amount" maxlength="15" />
                                <span class="icon-clear icon-icon-clear" id="btnClearTotalAmt"></span>
                            </div>
                        </div>

                        <button class="button button-generate" id="btnGenerate">Generate</button>
                        <!-- <div class="group-drop-down">
                            <button class="button button-generate btn-refresh" id="btnRefresh">Refesh(30)</button>
                            <ul class="refresh-list" id="refreshList">
                                <li value="-1">None</li>
                                <li value="15">Refresh(15)</li>
                                <li value="30" id="selectedRefresh">Refresh(30)</li>
                                <li value="60">Refresh(60)</li>
                            </ul>
                        </div> -->
                    </div>
                </div>
                <div id="monitor-datatable" class="report-cont">
                    <div class="table-report" style="width : 100%">
                        <table id="tblMonitor" class="table table-striped table-monitor">
                            <thead>
                                <tr>
                                    <th rowspan="2" class="thFirst">Sport</th>
                                    <th rowspan="2" class="thFirst">League</th>
                                    <th rowspan="2" class="thFirst">Match</th>
                                    <th rowspan="2" class="thFirst">Market</th>
                                    <th rowspan="2" class="thFirst">Event Date</th>
                                    <th rowspan="2" class="thFirst">Bet Type</th>
                                    <th colspan="2" class="thFirst">Total Amt (RM)</th>
                                    <th colspan="2" class="thFirst">Total Ticket</th>
                                </tr>
                                <tr>
                                    <th class="thFirst">Home</th>
                                    <th class="thFirst">Away</th>
                                    <th class="thFirst">Home</th>
                                    <th class="thFirst">Away</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="hide">
            @*<input id="hdIsHostPermission" type="hidden" IsHostPermission="@Model.IsHostPermission.ToString()" />
            <input id="hdCTSCustId" type="hidden" value="@Model.CustId" />*@
            @*<input id="hdSportBettypeList" type="hidden" value="@Model.SportBettypeList" />*@
        </div>
    </section>
</body>

<div id="divAddProblemAccount" class="popup-add divAddProblemAccount" style="display:none;">
    <div class="form-validate">
        <div class="group-title">
            <div class="label">Username</div>
            <div class="wrapper-title">
                <div class="wrapper-rule wrapper-rule-left">
                    <span id="btnRemoveInvalidUserName" class="text icon-delete" title="Remove all invalid Usernames"></span>     
                    <span class="text bg-red">Invalid Username</span>
                </div>                                
            </div>
        </div>
        <span class="wrapper-value" id="spanAddProblemAccountUserName">
            <input id="inputTagUsername" type="text" name='tags-outside' class="input-field full-width tagify--outside" placeholder="Type username (Separate by comma, tab, space and enter)" />
            <span class="limit-username">
                Max: <span id="spanAddProblemAccountUserNameMaxTag">1000</span> usernames
            </span>
            <span id="spanAddProblemAccountChangeHidden" hidden></span>
            <span id="spanProblemAccountActionHidden" hidden></span>
        </span>
    </div>

    <div class="modal-footer margin-top-10">
        <button id="btnCancel" class="button btn-cancel-outline" title="Cancel">Cancel</button>
        <button id="btnSave" class="button -add" title="Save">Save</button>
    </div>  
</div>
@section scripts{
    @Scripts.Render("~/danger-monitor-scripts")
}