@using Fanex.NAP.CTS.Resource.Consts;

@{
    ViewBag.Title = "DANGER MONITOR DETAIL";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles{
    @Styles.Render("~/danger-monitor-detail-styles")
}

<section class="detailpage" id="detailpage">
    <div class="content" id="divContent">
        <div class="page-title-match">
            <div class="title-box-left">
                <span class="title-description">MATCH MONITOR DETAIL</span>
                <span class="title-match-name"> @ViewBag.HomeName <span class="title-match-vs"> vs </span> @ViewBag.AwayName</span>
                <span class="title-league-name"> @ViewBag.LeagueName</span>
                <span class="title-ko-time"> KO Time: @ViewBag.KOTime</span>

            </div>
            <div class="title-box-right">
                <span class="title-sport-name">
                    <span id="spanSportBetTypeInfo">@ViewBag.SportName - @ViewBag.BettypeName -</span>
                    <span class="title-market" id="spanMarketInfo">@ViewBag.MarketName</span>
                    <span class="title-market-line"> | </span>
                    <span class="title-market" id="spanReasonInfo"> GB, FG</span>
                </span>
            </div>

        </div>
    </div>

    <div class="monitor-container">
        <div class="monitor-table" id="divFilterMonitor">
            <div class="loading-container" id="divFilterLoading" style="display: none;">
                <div class="loading-icon"></div>
            </div>
            <div class="group-control" id="groupControl">
                <div class="group-info filter-group">
                    <div class="form-filter first-row">
                        <div class="first-row-info">
                            <label class="text info-text">Market</label>
                            <select class="control info-select" id="cbbMarket">
                                <option value="True">Live</option>
                                <option value="False">Non-Live</option>
                            </select>
                        </div>

                        <div class="first-row-line"></div>

                        <div class="first-row-info select-group-bettype">
                            <label class="info-text">Bet Type</label>
                            <select class="control info-select" id="cbbBetType" name="state">
                                @foreach (var item in ViewBag.BetTypeSettings)
                                {
                                    var itemValue = item.BetTypeID + "_" + item.BetID;

                                    if (!item.IsSupportSuspicious)
                                    {
                                        <option value="@itemValue" data-bettypeid="@item.BetTypeID" data-betidpattern="@item.BetIDPattern" data-betchoicetype="@item.BetChoiceType" data-betchoicehome="@item.BetChoiceHome" data-betchoiceaway="@item.BetChoiceAway" data-betid="@item.BetID" data-is-support-suspicious="false" class="readOnly">@item.BetTypeName</option>
                                    }
                                    else
                                    {
                                        <option value="@itemValue" data-bettypeid="@item.BetTypeID" data-betidpattern="@item.BetIDPattern" data-betchoicetype="@item.BetChoiceType" data-betchoicehome="@item.BetChoiceHome" data-betchoiceaway="@item.BetChoiceAway" data-betid="@item.BetID">@item.BetTypeName</option>
                                    }
                                }

                            </select>
                        </div>

                        <div class="first-row-info" style="width:80px" id="divMapX">
                            <select class="control info-select" id="cbbMapX" name="state">
                                @for (int i = 1; i < 10; i++)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                        </div>

                        <div class="first-row-info" style="width:80px" id="divMapYY">
                            <select class="control info-select" id="cbbMapYY" name="state">
                                @for (int i = 1; i < 99; i++)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                        </div>

                        <!-- <div class="first-row-line"></div>

                        <div class="first-row-info">
                            <label class="text info-text">Tickets Type</label>
                            <select class="control info-select" id="cbbTypeOfTickets">
                                <option value="2">Suspicious</option>
                                <option value="3">All</option>
                            </select>
                        </div> -->

                        <div class="first-row-line"></div>

                        <div class="first-row-info">
                            <label class="text info-text">Transtime</label>
                            <div class="control info-input">
                                <input class="transtime-input" placeholder="dd/mm/yy hh:mm:ss" id="inputTranstimeFrom"/>
                                <label>-</label>
                                <input class="transtime-input" placeholder="dd/mm/yy hh:mm:ss" id="inputTranstimeTo"/>
                                <span class="transtime-icon icon-clear icon-icon-clear" id="iconTranstimeClear"></span>
                                <span class="icon-icon-transtime-submit transtime-icon transtime-icon-submit" id="iconTranstimeSubmit"><span class="path1"></span><span class="path2"></span></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="group-info filter-group border" style="padding: 0px;">
                    <div class="form-filter">
                        <div class="group width-160 second-row-depend-1 start-box" @(ViewBag.IsDisableScoreFilter ? "hidden" : "")>
                            <label class="text">Score</label>
                            <select class="control width-select" id="cbbMatchScore" multiple="multiple">
                                @*@if (ViewBag.MatchScore != null)
                                    {
                                        foreach (var item in ViewBag.MatchScore)
                                        {
                                            <option value="@item.ScoreDiff" selected>@item.LiveHomeScore - @item.LiveAwayScore </option>
                                        }
                                    }*@
                            </select>
                        </div>

                        <div class="group width-160 second-row-depend-1 @(ViewBag.IsDisableScoreFilter ? "start-box": "")">
                            <label class="text">Site</label>
                            <select class="control width-select-one" id="cbbSites">
                                <option value="A">All</option>
                                <option value="C">Credit</option>
                                <option value="L">Licensee</option>
                            </select>
                        </div>

                        <div class="group width-160 second-row-depend-1">
                            <label class="text">CC</label>
                            <select class="control width-select" id="cbbCC" multiple="multiple">
                            </select>
                        </div>

                        <div class="group width-160 second-row-depend-1 end-depend">
                            <label class="text">Dgr</label>
                            <select class="control width-select" id="cbbDanger" multiple="multiple">
                            </select>
                        </div>

                        <div class="group width-160 second-row-depend-2 start-depend">
                            <label class="text">Cur</label>
                            <select class="control width-select" id="cbbCurrency" multiple="multiple">
                            </select>
                        </div>

                        <div class="group width-160 second-row-depend-2">
                            <label class="text">Reason</label>
                            <select class="control width-select" id="cbbReason" multiple="multiple">
                            </select>
                        </div>

                        <div class="group width-160 second-row-depend-2 end-depend">
                            <label class="text">A.Gr.</label>
                            <select class="control width-select" id="cbbAGroup" multiple="multiple">
                            </select>
                        </div>

                        <div class="group width-160 second-row-depend-1 start-depend">
                            <label class="text">M.Gr.</label>
                            <select class="control width-select" id="cbbMGroup" multiple="multiple">
                            </select>
                        </div>

                        <div class="group width-160 second-row-depend-1">
                            <label class="text">HDP/Choice</label>
                            <select class="control width-select" id="cbbHDPBetTeam" multiple="multiple">
                            </select>
                        </div>

                        <div class="group width-160 second-row-depend-1">
                            <label class="text">Username's Amt (RM)</label>
                            <div class="ui-multiselect width-amount">
                                <input class="width-amount-item" placeholder=">= please input amount" id="inputCustAmountRM" maxlength="15" />
                                <span class="icon-icon-clear icon-clear clear-amount hide" id="iconClearUsnAmt"></span>
                            </div>
                        </div>

                        <div class="group width-160 second-row-depend-1">
                            <label class="text">Tickets Status</label>
                            <select class="control width-select" id="cbbTicketsStatus" multiple="multiple">
                                @*<option selected value=103>Refund</option>
                                    <option selected value=113>Lose</option>
                                    <option selected value=131>Completed</option>
                                    <option selected value=112>Won</option>
                                    <option selected value=101>Reject</option>
                                    <option selected value=111>Draw</option>
                                    <option selected value=0>Running</option>
                                    <option selected value=102>Void</option>
                                    <option selected value=1>Waiting</option>*@
                            </select>
                        </div>
                        <div class="group second-row-depend-1">
                            <div class="group-button">
                                <button class="button button-generate" id="btnGenerate-detail">Generate</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="breadcrumb-button" id="breadcrumbButton">
                    <div class="breadcrumb-totaltickets"></div>
                    <div id="hdbreadcrumTotalTickets" style="display: none">0</div>
                    <div>
                        <button class="button-primary-outline-1" id="btnImportNewTicket">Import New Tickets</button>
                        <button class="button-primary-outline-1" id="btnShowPopupAssDetection">Detect Association</button>
                        <button class="button-primary-outline-1" id="btnExportExcel">Export Excel</button>
                        <!-- <button class="button-primary-outline-1" id="btnVerifyAndClose">Verify and Close</button>
                        <button class="button-primary-outline-1 button-feedback" id="btnReasonFeedback">Feedback</button> -->
                    </div>
                </div>

                <div class="group-table" id="groupTable">
                    <div id="first-monitor-datatable">
                        <div id="tbrMMHomeTeam" class="table-report" style="width: 100%; padding-bottom: 8px;">
                            <table id="tblMMHomeTeam" class="table table-striped table-monitor-detail">
                                <thead>
                                    <tr>
                                        <th><input name="select_all" value="1" id="inputHomeSelectAll" type="checkbox" class="col-checkbox" /></th>
                                        <th>Username</th>
                                        <th>CC</th>
                                        <th>Bot</th>
                                        <th>Dgr</th>
                                        <th>Odds</th>
                                        <th>
                                            <div class="type-outer">
                                                <span class="col-title">BetID</span>
                                                <span id="iconHToggleBetID" class="dropdown-button icon-collapse-expand">
                                                    <span></span>
                                                    <span></span>
                                                    <span></span>
                                                </span>
                                            </div>
                                        </th>
                                        <th>Cur</th>
                                        <th>Amt</th>
                                        <th>HDP</th>
                                        <th>Score</th>
                                        <th>
                                            <div class="type-outer">
                                                <span class="col-title">Transtime</span>
                                                <span class="transtime-autofill-icon" id="iconHTranstimeAutofill"></span>
                                            </div>
                                        </th>
                                        <th>B.f.</th>
                                        <th title="Auto-detected Association Group">
                                            A.Gr.
                                        </th>
                                        <th title="Manual-detected Association Group: max. 5000 Usernames">
                                            M.Gr.<sup style="vertical-align: super; font-size: smaller;">i</sup>
                                        </th>
                                        <th>Reason</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>

                    <div id="second-monitor-datatable">
                        <div id="tbrMMAwayTeam" class="table-report" style="width: 100%; padding-bottom: 8px;">
                            <table id="tblMMAwayTeam" class="table table-striped table-monitor-detail">
                                <thead>
                                    <tr>
                                        <th><input name="select_all" value="1" id="inputAwaySelectAll" type="checkbox" class="col-checkbox" /></th>
                                        <th>Username</th>
                                        <th>CC</th>
                                        <th>Bot</th>
                                        <th>Dgr</th>
                                        <th>Odds</th>
                                        <th>
                                            <div class="type-outer">
                                                <span class="col-title">BetID</span>
                                                <span id="iconAToggleBetID" class="dropdown-button icon-collapse-expand">
                                                    <span></span>
                                                    <span></span>
                                                    <span></span>
                                                </span>
                                            </div>
                                        </th>
                                        <th>Cur</th>
                                        <th>Amt</th>
                                        <th>HDP</th>
                                        <th>Score</th>
                                        <th>
                                            <div class="type-outer">
                                                <span class="col-title">Transtime</span>
                                                <span class="icon-transtime-autofill icon-icon-copy" id="iconATranstimeAutofill"></span>
                                            </div>
                                        </th>
                                        <th>B.f.</th>
                                        <th title="Auto-detected Association Group">
                                            A.Gr.
                                        </th>
                                        <th title="Manual-detected Association Group: max. 5000 Usernames">
                                            M.Gr.<sup style="vertical-align: super; font-size: smaller;">i</sup>
                                        </th>
                                        <th>Reason</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>

                    <div id="monitor-datatable">
                        <div id="tbrMMSG" class="table-report" style="width: 50%; padding-bottom: 8px;">
                            <table id="tblMMSG" class="table table-striped table-monitor-detail">
                                <thead>
                                    <tr>
                                        <th><input name="select_all" value="1" id="inputSGSelectAll" type="checkbox" class="col-checkbox" /></th>
                                        <th>Username</th>
                                        <th>CC</th>
                                        <th>Bot</th>
                                        <th>Dgr</th>
                                        <th>Odds</th>
                                        <th>
                                            <div class="type-outer">
                                                <span class="col-title">BetID</span>
                                            </div>
                                        </th>
                                        <th>Cur</th>
                                        <th>Amt</th>
                                        <th>Choice</th>
                                        <th>Score</th>
                                        <th>
                                            <div class="type-outer">
                                                <span class="col-title">Transtime</span>
                                                <span class="icon-transtime-autofill icon-icon-copy" id="iconSGTranstimeAutofill"></span>
                                            </div>
                                        </th>
                                        <th>B.f.</th>
                                        <th title="Auto-detected Association Group">
                                            A.Gr.
                                        </th>
                                        <th title="Manual-detected Association Group: max. 5000 Usernames">
                                            M.Gr.<sup style="vertical-align: super; font-size: smaller;">i</sup>
                                        </th>
                                        <th>Reason</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="hide">
            <div>
                <label class="text">CC</label>
                <select class="control" id="cbbCCHidden" multiple="multiple">
                    @foreach (var group in ViewBag.GroupCCList)
                    {
                        <optgroup label="@group.CCGroupName">
                            @foreach (var cc in group.CCList)
                            {
                                <option selected value=@cc>@cc</option>
                            }
                            @if (group.CCGroupName.ToLower().Contains("other"))
                            {
                                <option selected value=0>-</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
            <input id="hdEventDataToString" type="hidden" value="@ViewBag.EventDateToString" />
            <input id="hdMatchID" type="hidden" value="@ViewBag.MatchID" />
            <input id="hdMatchName" type="hidden" value="@ViewBag.MatchName" />
            <input id="hdBetTypeID" type="hidden" value="@ViewBag.BetTypeID" />
            <input id="hdBetTypeName" type="hidden" value="@ViewBag.BettypeName" />
            <input id="hdBetIDToString" type="hidden" value="@ViewBag.BetIDToString" />
            <input id="hdLiveIndicator" type="hidden" value="@ViewBag.LiveIndicator.ToString()" />
            <input id="hdreason" type="hidden" value="@ViewBag.Reason" />
            <input id="hdSportType" type="hidden" value="@ViewBag.SportType">
            <input id="hdSportName" type="hidden" value="@ViewBag.SportName" />
            <input id="hdIsSupportShowAllTickets" type="hidden" value="@ViewBag.IsSupportShowAllTickets.ToString()" />
            <input id="hdIsHostPermission" type="hidden" IsHostPermission="@ViewBag.IsHostPermission.ToString()" />
            <input id="hdReasonNames" type="hidden" value="@ViewBag.ReasonName" />
            <input id="hdMapX" type="hidden" value="@ViewBag.MapX" />
            <input id="hdMapYY" type="hidden" value="@ViewBag.MapYY" />
        </div>
    </div>
</section>

<div id="divPopupAssDetect" class="popup-add" style="display: none">
    <div class="flex-container">
        <div class="box-left" style="padding-right: 10px">
            <div class="flex-container" style="border-bottom: 1px solid #C0C0C0; justify-content: space-between; align-items: center;">
                <div style="margin-top: 1px; margin-bottom: 1px;">
                    <span class='icon-Check'></span>
                    <span class="checkbox-filter checkbox-all">
                        <span class="checkbox-filter" id="tickCheckAll">Check all</span>
                    </span>

                    <span class='icon-Close'></span>
                    <span class="checkbox-filter checkbox-all">
                        <span class="checkbox-filter" id="tickUncheckAll">Uncheck all</span>
                    </span>
                </div>

                <span class="limit-username" style="font-size: 12px;">
                    Max: <span id="spanAddUserNameMaxTag">5000</span> usernames
                </span>
            </div> <!--div end - flex-container-->

            <div class="flex-container">
                <div>
                    <span class="checkbox-filter">
                        <label class="checkbox-container" id="ckbOptBPContainer">
                            <input id="inputOptBP" type="checkbox" checked>
                            <span class="checkmark"></span>
                            Betting Pattern
                        </label>
                    </span>

                    <span class="checkbox-filter">
                        <label class="checkbox-container" id="ckbOptDeviceContainer">
                            <input id="inputOptDevice" type="checkbox" checked>
                            <span class="checkmark"></span>
                            Device
                        </label>
                    </span>

                    <span class="checkbox-filter">
                        <label class="checkbox-container" id="ckbOptIPContainer">
                            <input id="inputOptIP" type="checkbox" checked>
                            <span class="checkmark"></span>
                            IP
                        </label>
                    </span>

                    <span class="checkbox-filter">
                        <label class="checkbox-container" id="ckbOptAgentContainer">
                            <input id="inputOptAgent" type="checkbox">
                            <span class="checkmark"></span>
                            Agent
                        </label>
                    </span>

                    <span class="checkbox-filter">
                        <label class="checkbox-container" id="ckbOpt3MatchesLast7DaysContainer">
                            <input id="inputOpt3MatchesLast7Days" type="checkbox">
                            <span class="checkmark"></span>
                            3 Matches(last 7 days)
                        </label>
                    </span>

                    <span class="checkbox-filter">
                        <label class="checkbox-container" id="ckbOptIPLast3DaysContainer">
                            <input id="inputOptIPLast3Days" type="checkbox">
                            <span class="checkmark"></span>
                            IP(last 3 days)
                        </label>

                    </span>
                </div>
            </div> <!--div end - flex-container margin-top-10-->
        </div>

        <div class="box-right" style="margin-left: 30px !important">
            <button id="btnAssDetection" class="button button-primary-outline" title="Association Detection">Detect</button>
        </div>

        <div class="hide">
            <input id="hdSelectedCustIDs" type="hidden" />
            <input id="hdSelectedUsernames" type="hidden" />
            <input id="hdSelectedHomeDetectMGr" type="hidden" />
            <input id="hdSelectedAwayDetectMGr" type="hidden" />            
        </div>
    </div>
</div>

@*@Html.Partial("Feedback")*@

@section scripts{
    @Scripts.Render("~/danger-monitor-detail-scripts")
}