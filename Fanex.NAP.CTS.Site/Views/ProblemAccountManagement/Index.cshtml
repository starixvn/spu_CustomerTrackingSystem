@{
    ViewBag.Title = "PROBLEM ACCOUNT MANAGEMENT";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    @Styles.Render("~/problem-account-management-styles")

}

<section class="problem-account-container">
    <div class="content">
        <h2 class="page-title">Problem Account Management</h2>
    </div>
    <div class="problem-account-content">
        <div class="problem-account-table">
            <div class="group-control">
                <div>
                    <div class="label"> Date </div>
                </div>
                <div class="form-filter">
                    <div class="group calendar width-180">
                        <label class="text">From</label>
                        <input type="text" id="dpkFromDate" class="control" readonly>
                        <span class="icon-calendar-text"></span>
                    </div>
                    <div class="group calendar width-180">
                        <label class="text">To</label>
                        <input type="text" id="dpkToDate" class="control" readonly>
                        <span class="icon-calendar-text"></span>
                    </div>

                    <div class="group width-180">
                        <label class="text">Subscriber</label>
                        <select class="control width-select" id="cbbSubscriber" multiple="multiple">
                            @if (Model != null)
                            {
                                foreach (var group in Model)
                                {
                                    <optgroup label="@group.SubscriberGroupName">
                                        @foreach (var item in group.SubscriberList)
                                        {
                                            <option selected value=@item.SubscriberID>@item.SubscriberName</option>
                                        }
                                    </optgroup>
                                }
                            }
                        </select>
                    </div>
                    <div class="group width-180">
                        <div class="label">Username:</div>
                        <input type="text" id="inputUserName" value="" placeholder="" maxlength="50" />
                    </div>
                    <button class="button button-generate" id="btnGenerate">Generate</button>
                </div>
            </div>
        </div>
    </div>
</section>

@section scripts {
    @Scripts.Render("~/problem-account-management-scripts")
}

