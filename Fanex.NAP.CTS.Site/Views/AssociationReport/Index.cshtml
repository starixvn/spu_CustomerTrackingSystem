@{
    ViewBag.Title = "Association Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/association-report-styles")
}



<section class="association-report">
    <div class="content">
        <h2 class="page-title">Association Report</h2>
    </div>
    <div class="association-content">
        <div class="association-table">



            <div class="gorup-control">

                <div class="title-association"><div class="label">First Associated date: </div></div>
                <div class="form-filter">
                    <div class="group calendar width-180">
                        <label class="text">From</label>
                        <input type="text" id="dpkDate" class="control" readonly>
                        <span class="icon-calendar-text"></span>
                    </div>
                    <div class="group calendar width-180">
                        <label class="text">To</label>
                        <input type="text" id="dpkDate" class="control" readonly>
                        <span class="icon-calendar-text"></span>
                    </div>
                    <div class="group">
                        <label class="text">Account Status</label>
                        <input type="text" name="status" value="" class="control" />
                    </div>
                    <div class="group">
                        <label class="text">Site</label>
                        <input type="text" name="status" value="" class="control" />
                    </div>
                    <div class="group">
                        <label class="text">Evidence</label>
                        <input type="text" name="status" value="" class="control" />
                    </div>
                    <div class="group">
                        <label class="text">Association Type</label>
                        <input type="text" name="status" value="" class="control" />
                    </div>
                    <div class="button button-generate">Generate</div>
                </div>
            </div>
            <div id="association-datatable" class="report-cont">
                <div class="table-report" style="width : 100%">
                    <table id="tblGeneral" class="table table-striped table-tab-mt">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Username</th>
                                <th>Site</th>
                                <th>Account Status</th>
                                <th>Evidence</th>
                                <th>General Category</th>
                                <th>Associated Accounts</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
@section scripts{
    @Scripts.Render("~/association-report-scripts")
}