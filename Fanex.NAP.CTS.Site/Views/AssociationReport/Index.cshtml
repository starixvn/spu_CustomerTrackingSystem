@{
    ViewBag.Title = "Association Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/association-report-styles")
}

<section class="association-report">
    <div class="content">
        <h2 class="page-title">Association Report</h2>
    </div>
    <div class="association-content">
        <div class="association-table">
            <div class="group-control">
                <div class="title-association"><div class="label">First Associated date: </div></div>
                <div class="form-filter">
                    <div class="group calendar width-180">
                        <label class="text">From:</label>
                        <input type="text" id="dpkFromDate" class="control" readonly>
                        <span class="icon-calendar-text"></span>
                    </div>
                    <div class="group calendar width-180">
                        <label class="text">To:</label>
                        <input type="text" id="dpkToDate" class="control" readonly>
                        <span class="icon-calendar-text"></span>
                    </div>
                    <div class="group width-180">
                        <label class="text">Account Status:</label>                        
                        <select class="control width-select" id="cbbAccountStatus">
                            @{
                                var optionSelect = true;
                            }
                            @foreach (var item in ViewBag.AccountStatus)
                            {
                                if (optionSelect)
                                {
                                    optionSelect = false;
                                    <option value=@item.Ids selected>@item.Name</option>
                                }
                                else
                                {
                                    <option value=@item.Ids>@item.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="group width-180">
                        <label class="text">Site:</label>
                        <div style="width:200px">
                            <select class="control width-select" id="cbbSite">
                                @{
                                    optionSelect = true;
                                }
                                @foreach (var item in ViewBag.Subscribers)
                                {
                                    if (optionSelect)
                                    {
                                        optionSelect = false;
                                        <option value=@item.SiteID selected>@item.SiteName</option>
                                    }
                                    else
                                    {
                                        <option value=@item.SiteID>@item.SiteName</option>
                                    }
                                }
                            </select>
                        </div>                        
                    </div>
                    <div class="group width-180">
                        <label class="text">Association Status:</label>                        
                        <select class="control width-select" id="cbbAssociationStatus" multiple="multiple">                            
                            @foreach (var item in ViewBag.AssociationStatus)
                            {
                                <option value=@item.ItemId selected>@item.ItemNameDisplay</option>
                            }
                        </select>
                    </div>
                    <div class="group">
                        <label class="text">Evidence:</label> 
                        <div style="width:260px">
                            <select class="control width-select" id="cbbEvidence">
                                @{
                                    optionSelect = true;
                                }
                                @foreach (var item in ViewBag.Evidences)
                                {
                                    if (optionSelect)
                                    {
                                        optionSelect = false;
                                        <option value=@item.EvidenceCode selected>@item.EvidenceName</option>
                                    }
                                    else
                                    {
                                        <option value=@item.EvidenceCode>@item.EvidenceName</option>
                                    }
                                }
                            </select>
                        </div>                        
                    </div>
                    <div class="group width-180">
                        <label class="text">Association Type:</label>                        
                        <select class="control width-select" id="cbbAssociationType">
                            @{
                                optionSelect = true;
                            }
                            @foreach (var item in ViewBag.AssociationTypes)
                            {
                                if (optionSelect)
                                {
                                    optionSelect = false;
                                    <option value=@item.ItemId selected>@item.ItemNameDisplay</option>
                                }
                                else
                                {
                                    <option value=@item.ItemId>@item.ItemNameDisplay</option>
                                }
                            }
                        </select>
                    </div>
                    <button class="button button-generate" id="btnGenerate">Generate</button>
                </div>
            </div>
            <div id="association-datatable" class="report-cont">
                <div class="table-report" style="width : 100%">
                    <table id="tblAssociation" class="table table-striped table-association">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Username</th>
                                <th>Site</th>
                                <th>Account Status</th>
                                <th>Evidence</th>
                                <th>General Category</th>
                                <th>Associated Accounts</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
@section scripts{
    @Scripts.Render("~/association-report-scripts")
}