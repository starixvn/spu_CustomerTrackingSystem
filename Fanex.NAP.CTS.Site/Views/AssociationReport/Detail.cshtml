@{
    ViewBag.Title = "Association Report Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/association-report-styles")
}


<section class="association-report">
    <div class="content">
        <h2 class="page-title">Association Report Detail</h2>
    </div>
    <div class="association-content">
        <div class="association-table">
            <div class="gorup-control">
                <div class="form-filter">
                    <div class="group width-180">
                        <label class="text">Account:</label>
                        <p>Account</p>
                    </div>
                    <div class="group width-180">
                        <label class="text">Associated date:</label>
                        <p>Associated date</p>
                    </div>
                    <div class="group width-180">
                        <label class="text">Association Type:</label>
                        <p>Associated Type</p>
                    </div>
                </div>
            </div>


            <div id="association-datatable" class="report-cont detail-association">
                <div class="table-report" style="width : 100%">
                    <table id="tblGeneralDetail" class="table table-striped table-tab-mt">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Username</th>
                                <th>Account Status</th>
                                <th>Account Date</th>
                                <th>Associated Status</th>
                                <th>Associated Type</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
@section scripts{
    @Scripts.Render("~/association-detail-report-scripts")
}