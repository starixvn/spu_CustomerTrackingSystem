@{
    ViewBag.Title = "Association Report Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/association-report-styles")
}

<section class="association-report">
    <div class="content">
        <h2 class="page-title">Association Report Detail</h2>
    </div>
    <div class="association-content">
        <div class="association-table">
            <div class="group-control">
                <div class="form-filter">
                    <div class="group width-180">
                        <label class="text">Account:</label>
                        <p id="lblAccount">@ViewBag.UserName</p>
                    </div>
                    <div class="group width-180">
                        <label class="text">Associated date:</label>
                        <p id="lblRangeDate">@ViewBag.FromDate - @ViewBag.ToDate</p>
                    </div>
                    <div class="group width-180">
                        <label class="text">Association Type:</label>
                        <p id="lblAssociatedType">@ViewBag.AssociationTypeName</p>
                    </div>
                </div>
            </div>

            <div id="association-datatable" class="report-cont detail-association">
                <div class="table-report" style="width : 100%">
                    <table id="tblAssociationDetail" class="table table-striped table-association-detail">
                        <thead>
                            <tr>
                                <th>Site</th>
                                <th>Username</th>
                                <th>Account Status</th>
                                <th>Associated Date</th>
                                <th>Associated Status</th>
                                <th>Associated Type</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="hide">
    <input id="hdSubscriberId" type="hidden" value="@ViewBag.SubscriberId" />
    <input id="hdCTSCustId" type="hidden" value="@ViewBag.CTSCustId" />
    <input id="hdUserName" type="hidden" value="@ViewBag.UserName" />
    <input id="hdFromDate" type="hidden" value="@ViewBag.FromDate" />
    <input id="hdToDate" type="hidden" value="@ViewBag.ToDate" />
    <input id="hdAssociationStatus" type="hidden" value="@ViewBag.AssociationStatus" />
    <input id="hdAssociationType" type="hidden" value="@ViewBag.AssociationType" />
    <input id="hdIsHostPermission" type="hidden" IsHostPermission="@ViewBag.IsHostPermission.ToString()" />
</div>

@section scripts{
    @Scripts.Render("~/association-detail-report-scripts")
}
