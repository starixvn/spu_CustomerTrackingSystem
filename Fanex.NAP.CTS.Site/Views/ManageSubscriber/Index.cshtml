
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles{
    @Styles.Render("~/manage-subscriber-styles")
}

<h2 class="page-title">Manage Subscriber</h2>
<div class="wrapper-content manage-subscriber">
    <div class="fixed-header">
        <div class="top-header">
            <button class="button button-primary-outline" id="btnAdd">Add</button>
        </div>
    </div>

    <table id="manageSubscriberTable" class="table table-striped table-basic manageSubscriberTable">
        <thead>
            <tr>
                <th>No.</th>
                <th>Sub ID</th>
                <th>Subscriber Name</th>
                <th>IBCUserName_Prefix</th>
                <th>Subscriber Group</th>
                <th>Role Mapping</th>
                <th>Site ID</th>
                <th>Site</th>
                <th>IsActive</th>
                <th>Release Date</th>
                <th>Terminated</th>
            </tr>
        </thead>
        <tbody>
            @*<tr role="row" class="odd deleted">
            <td class=" text-center">1</td>
            <td class=" text-center">123</td>
            <td class=" text-center">Vano</td>
            <td class=" text-center">Vano$</td>
            <td class=" text-center">Credit Site</td>
            <td class=" text-center">1</td>
            <td class=" text-center">239</td>
            <td class=" text-center">NovaCash</td>
            <td class=" text-center">1</td>
            <td class=" text-center">4-Mar-20</td>
            <td class=" text-center">2-Mar-20</td>
        </tr>*@
        </tbody>
    </table>
</div>

<div id="divAddSubscriber" class="popup-add divAddSubscriber" style="display: none;">
    <div class="form-control">
        <div class="label">Site</div>
        <input id="txtSite" type="text" class="input-field full-width" maxlength="50">
    </div>
    <div class="form-control">
        <div class="label">Site ID</div>
        <input id="txtSiteID" type="text" class="input-field full-width" maxlength="50">
    </div>
    <div class="form-control">
        <div class="label">IBCUserName_Prefix</div>
        <input id="txtIBCUserNamePrefix" type="text" class="input-field full-width" maxlength="50">
    </div>
    <div class="form-control">
        <div class="label">Subscriber Group</div>
        <select class="control full-width" id="txtSubscriberGroup">
            <option value="All" selected="">Credit Site</option>
            <option value="running">None</option>
        </select>
    </div>
    <div class="form-control">
        <div class="label">Subscriber Name</div>
        <input id="txtSubscriberName" type="text" class="input-field full-width" maxlength="50">
    </div>
    <div class="form-control">
        <div class="label">Role Mapping</div>
        <select class="control full-width" id="txtRoleMapping">
            <option value="0" selected="">0</option>
            <option value="1">1</option>
        </select>
    </div>

    <div class="note">
        <span class="text-title">
            Note: 
        </span>

        <span class="text-description">
            Role Mapping format
        </span>
        <div class="text-detail">
            <p class="text">- 0: is for Licensee site</p>
            <p class="text">- 1: is for Membersite of Credit Site</p>
            <p class="text">- 2: is for Alpha site of Credit Site</p>
        </div>
       
    </div>

    <div class="modal-footer margin-top-10">
        <button id="btnCancel" class="button btn-cancel-outline" title="Cancel">Cancel</button>
        <button id="btnSave" class="button -add" title="Add Username">Add</button>
    </div>
</div>

@section scripts{
    @Scripts.Render("~/manage-subscriber-scripts")
}