
@{
    ViewBag.Title = "Search";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var username2 = string.Empty;

}
@model Fanex.NAP.CTS.ViewModel.Home.SearchResultViewModel

@Styles.Render("~/Content/styles/dashboard")

<div class="search-result">
    @using (Html.BeginForm("Search", "Home", FormMethod.Post))
    {
        <div class="search-box">
            <input id="txtInput" name="txtInput" class="input-field" placeholder="Type in Username or Login ID to search" type="text" value="@Model.InputValue" />
            <i class="icon-magnify"></i>
        </div>

        <div id="errMessage" class="error-alert hide">At least two letters are required!</div>
    }

    <div class="result-content">


        @if (Model.SearchResults != null && Model.SearchResults.Any())
        {
            <div class="result-number">Top <span>50</span> results with keyword "<span>@Model.InputValue</span>"</div>
            <ul class="result-list">

                @foreach (var data in Model.SearchResults)
                {
                    username2 = !string.IsNullOrWhiteSpace(data.Username2) ? "(" + data.Username2 + ")" : string.Empty;

                    <li class="result-item">
                        <a class="result-name" href="~/Account/Index/@data.CTSCustId">@data.Username <span>@username2</span></a>
                        <p>
                            <span style="width: 130px;">Currency: @data.Currency.Name</span>
                            <span style="width: 130px;">Level: @data.Role.Name</span>
                            <span style="width: 200px;">Subscriber: @data.Subscriber.Name</span>
                            <span style="width: 170px;">Last Login: @data.LastLogin.ToString("MMM dd, yyyy")</span>
                        </p>
                    </li>
                }
            </ul>

        }
        else
        {
            <div class="result-number">No results found for "<span>@Model.InputValue</span>"</div>
        }

    </div>
</div>

@section scripts{
    @Scripts.Render("~/scripts/searchbox")
}