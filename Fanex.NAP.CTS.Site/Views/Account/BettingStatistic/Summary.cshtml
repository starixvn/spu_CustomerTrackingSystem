@{
    ViewBag.Title = "Summary of Last 90 Days";
}

    <div class="summary-detail">
        <div class="wrapper-title">
            <i class="icon icon-chevron-right"></i>
            <span class="title">
                Summary Of Last 90 Days
            </span>
        </div>
       
        <div class="wrapper-data">
            <div class="summary-top">
                <div class="wrapper-title">
                    <div class="name">Total</div>
                    <div class="alert high-stake">
                        High Stake
                    </div>
                </div>
                <div class="wrapper-value">
                    <div class="value">100k</div>
                    <div class="text">Turn Over</div>
                </div>
                <div class="wrapper-value">
                    <div class="value">114k</div>
                    <div class="text">Win Loss</div>
                </div>
                <div class="wrapper-value">
                    <div class="value">7%</div>
                    <div class="text">Margin</div>
                </div>
                <div class="wrapper-value">
                    <div class="value">100</div>
                    <div class="text">Bet Count</div>
                </div>
            </div>
            <div class="border-divide">

            </div>
            <div class="summary-bottom">
                <div class="wrapper-title">
                    <div class="name">Soccer</div>
                    <div class="alert normal-stake">
                        Normal Stake
                    </div>
                </div>
                <div class="wrapper-value">
                    <div class="value">30k</div>
                    <div class="text">Turn Over</div>
                </div>
                <div class="wrapper-value">
                    <div class="value">70k</div>
                    <div class="text">Win Loss</div>
                </div>
                <div class="wrapper-value">
                    <div class="value">7%</div>
                    <div class="text">Margin</div>
                </div>
                <div class="wrapper-value">
                    <div class="value">10</div>
                    <div class="text">Bet Count</div>
                </div>
            </div>
        </div>
    </div>