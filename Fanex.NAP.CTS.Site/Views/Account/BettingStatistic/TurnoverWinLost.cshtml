@{
    ViewBag.Title = "Turnover & Win Lost Last 3 Months";
}

<div class="chart-win-lost">
    <span class="title">
        Turnover & Win Lost Last 3 Months
        <span class="icon icon-zoom"></span>
    </span>
    <div class="win-lost-grid">
        <div id="chart-win-lost" class="wapper-win-lost">
