@{
    ViewBag.Title = "AccountDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/account-detail-styles")
}
@model Fanex.NAP.CTS.ViewModel.Account.CustomerGeneralStatusViewModel
<h2 class="page-title">Account Profile</h2>
<div class="content-card">
    <div class="status-info">
        <p>
            <strong>@Model.Role.Name @(Model.CustSubId != 0 ? "(Sub Account)" : string.Empty) :</strong>
            <span class="username">@(Model.UserName != null ? Model.UserName : Model.UserName2) <span class="nickname" style="color: #c16112">(@(Model.UserName2 != null ? Model.UserName2 : Model.UserName))</span></span>
            <span class="icon icon-Robot-User hide" title="Robot User"></span>
            <span class="icon icon-P-with-Bet-Limit hide" title="Problem Account With Bet Limit reduced"></span>
            <span class="icon icon-P-without-Bet-Limit hide" title="Problem Account Without Bet Limit reduced"></span>
            <span class="icon icon-Bet-Restrict-Account hide" title="Bet Restricted Account"></span>
            <span class="icon icon-Bet-Restricted-Currency hide" title="Bet Restricted Currency"></span>
            <span class="icon icon-Bet-Restrict-Site hide" title="Bet Restricted Site"></span>
            <span class="icon icon-Bet-Restricted-SiteandCurrency hide" title="Bet Restricted Site and Currency"></span>
            <span class="icon icon-Smart-Punter-Account hide" title="Smart Punter Account"></span>
            <span class="icon icon-Affected hide" title="Affected"></span>
            <span class="icon icon-Flagged hide" title="Flagged"></span>
            <span class="icon icon-Flagged-With-Evidence hide" title="Flagged with Evidence 100"></span>
            <span class="icon loading"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
            <strong style="margin-left: 20px">Account Status: </strong>
            @*<span class="badge-label status-active" style="margin-right: 20px">@(Model.AcountStatus == "NA" ? "N/A" : Model.AcountStatus)</span>*@
            <span id="accountStatus" class="badge-label status-active" style="margin-right: 20px"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
            <strong>Subscribers: </strong>
            <span class="username">@Model.Subscriber</span>
        </p>
    </div>
    <div class="account-info">
        <!-- Dates -->
        <div class="info-item">
            <div class="info-title">Dates</div>
            <div class="info-block">
                <div class="info-label">
                    <label>Created</label>
                    <label>Last Login</label>
                    <label>Last Ticket</label>
                </div>
                <div class="info-text">
                    <div>@(Model.CreatedDate.Year == 0001 ? "None" : Model.CreatedDate.ToString("MMM dd, yyyy HH:mm"))</div>
                    <div>@(Model.LastLoginDate.Year == 0001 ? "None" : Model.LastLoginDate.ToString("MMM dd, yyyy HH:mm"))</div>
                    <div>@(Model.LastTicketDate.Year == 0001 ? "None" : Model.LastTicketDate.ToString("MMM dd, yyyy HH:mm"))</div>
                </div>
            </div>
        </div>
        <!--Dangerous-->
        <div class="info-item">
            <div class="info-title">Dangerous</div>
            <div class="info-block">
                <div class="info-label">
                    <label>Original</label>
                    <label>ABI</label>
                    <label>Other Sports</label>
                </div>
                <div class="info-text">
                    <div><span id="dangerousOriginal"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span></div>
                    <div><span id="dangerouseABI"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span></div>
                    <div><span id="dangerouseOtherSports"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span></div>
                </div>
            </div>
        </div>
        <!--Abnormal-->
        <div class="info-item">
            <div class="info-title">Abnormal</div>
            <div class="info-block">
                <div class="info-label">
                    <label>Abnormal</label>
                </div>
                <div class="info-text">
                    <div><span id="abnormal"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span></div>
                    @*<div>@(Model.Abnormal == 0 ? Html.Raw("None") : Html.Raw(string.Format("<span class='abnormal-level-{0}'>{1}</span>", Model.Abnormal.ToString(), Model.Abnormal)))</div>*@
                </div>
            </div>
        </div>
        <!-- Auto Suspend-->
        <div class="info-item">
            <div class="info-title">Auto Suspend</div>
            <div class="info-block">
                <div class="info-label">
                    <label>Soccer</label>
                    <label>Other Sports</label>
                    <label>E-Sports</label>
                </div>
                <div class="info-text">
                    <div id="autoSuspendSoccer"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></div>
                    <div id="autoSuspendOtherSport"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></div>
                    <div id="autoSuspendESport"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></div>
             
                </div>
            </div>
        </div>
        <!-- Association & Evidence-->
        <div class="info-item">
            <div class="info-title">Association & Evidence</div>
            <div class="info-block">
                <div class="info-label">
                    <label>Accounts / Devices / IP</label>
                    <label>Evidence</label>
                </div>
                <div class="info-text">
                    <div>
                        <a id="lnkAssociation" href="javascript:void(0)" class="link">
                            <span id="totalAssAccount">
                                <img class="icon-loading" src="~/Content/scss/images/loading.svg" />
                            </span>/
                            <span id="totalAssDevice"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>/
                            <span id="totalAssIP"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        </a>
                    </div>
                    <div>
                        <a id='lnkEvidence' href='javascript:void(0)' class='link'>
                            <span id="evidences"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <!-- Committed Fraud Case -->
        <div class="info-item">
            <div class="info-title">Committed Fraud Case</div>
            <div class="info-block">
                <div class="info-label">
                    <label>Classification</label>
                    <label>Fraud case</label>
                </div>
                <div class="info-text">
                    <div class="classification">
                        <img class="icon-loading" src="~/Content/scss/images/loading.svg" />
                        <span class="icon-delinquency hide" title="Delinquency"></span>
                        <span class="icon-Hedge-Account hide" title="Hedge Account"></span>
                        <span class="icon-dirty hide" title="Dirty Account"></span>
                    </div>
                    <div id="fraudcase">
                        <span><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content-card">
    <div class="status" id="account-detail-header">
        <p class="info" style="margin-bottom: 0">
            <span class="expand-all" title="Expand All"></span>
            Account Details
        </p>
    </div>
    <div id="account-detail-container" class="report-content">
        <div class="report-item">
            <h3 id="header_associated_account" class="report-header" ref="associated_account">
                <i class="icon-chevron-right"></i>
                <a href="javascript:void(0)">Associated Accounts</a>
            </h3>
            <div id="associated_account" class="report-cont hide">
                <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
            </div>
        </div>
        <div class="report-item">
            <h3 id="header_chains_evidence" class="report-header" ref="chains_evidence">
                <i class="icon-chevron-right"></i>
                <a href="javascript:void(0)">Chains to Evidence and Exceptions</a>
            </h3>
            <div id="chains_evidence" class="report-cont hide">
                <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
            </div>
        </div>

        <div class="report-item">
            <h3 id="header_customer_category" class="report-header" ref="customer_category">
                <i class="icon-chevron-right"></i>
                <a href="javascript:void(0)">Customer Classification</a>
            </h3>
            <div id="customer_category" class="report-cont hide">
                <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
            </div>
        </div>
        <div class="report-item">
            <h3 id="header_trans_history" class="report-header" ref="trans_history">
                <i class="icon-chevron-right"></i>
                <a href="javascript:void(0)">Transaction History</a>
            </h3>
            <div id="trans_history" class="report-cont hide">
                <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
            </div>
        </div>
    </div>
</div>
<div class="hide">
    <input id="hdCTSCustId" type="hidden" value="@Model.CTSCustId" />
    <input id="hdCustId" type="hidden" value="@Model.CustId" />
    <input id="hdUsername" type="hidden" value="@Model.UserName" />
    <input id="hdSubscriberId" type="hidden" value="@Model.SubscriberId" />
    <input id="hdSubscriber" type="hidden" value="@Model.Subscriber" />
    <input id="hdIsHostPermission" type="hidden" IsHostPermission ="@Model.IsHostPermission.ToString()" />
</div>
@section scripts{
    @Scripts.Render("~/account-detail-scripts"
    , "~/chain-to-evidence-scripts"
    , "~/account/transaction-history-scripts"
    , "~/account/customer-category-scripts")
}