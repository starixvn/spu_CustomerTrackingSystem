@{
    ViewBag.Title = "AccountDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/account-detail-styles")
}
@model Fanex.NAP.CTS.ViewModel.Account.CustomerGeneralStatusViewModel
<h2 class="page-title">Account Profile</h2>
<div class="content-info">
    <span class="tag-text-right spanContentInfoLoading" id="spanContentInfoLoading"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
    <div class="header-info border-green" id="divHeaderInfo" style="visibility:hidden">
        <div class="header-username bg-green" id="divHeaderUsername">
            <div class="block-icon">
                @if (Model.IsRobotUser)
                {
                    switch (Model.RobotType)
                    {
                        case -1:
                            <span class="icon-Robot icon-base-robot">
                                <span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span><span class="path6"></span><span class="path7"></span>
                            </span>
                            break;
                        case 0:
                            <span class="icon-Robot icon-ob-robot">
                                <span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span><span class="path6"></span><span class="path7"></span>
                            </span>
                            break;
                        case 1:
                            <span class="icon-Robot icon-good-robot">
                                <span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span><span class="path6"></span><span class="path7"></span>
                            </span>
                            break;
                        case 2:
                            <span class="icon-Robot icon-bad-robot">
                                <span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span><span class="path6"></span><span class="path7"></span>
                            </span>
                            break;
                        default:
                            break;
                    }
                }

                <span class="icon-big-Robot icon-big-robot hide"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span><span class="path6"></span><span class="path7"></span></span>

                <span class="icon-big-Robot icon-big-observation-robot hide"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span><span class="path6"></span><span class="path7"></span></span>

                <span class="icon-big-Robot icon-big-good-robot hide"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span><span class="path6"></span><span class="path7"></span></span>

                <span class="icon-big-Robot icon-big-bad-robot hide"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span><span class="path6"></span><span class="path7"></span></span>

                @if (Model.AffectedEvidence)
                {
                    <span class="icon-error"><span class="path1"></span><span class="path2"></span></span>
                }
                else
                {
                    <span class="icon-error hide"><span class="path1"></span><span class="path2"></span></span>
                }

                @if (Model.FlaggedEvidence)
                {
                    <span class="icon-flag"><span class="path1"></span><span class="path2"></span></span>
                }
                else
                {
                    <span class="icon-flag hide"><span class="path1"></span><span class="path2"></span></span>
                }

                <span class="username">@(Model.UserName != null ? Model.UserName : Model.UserName2)</span>
            </div>
        </div>
        <div class="container-status">
            <div class="wrapper-status" id="divCustomerCategorySummary">
            </div>           
        </div>
       
    </div>

    <div class="wrapper-content">
        <div class="tag-info">
            <div class="wrapper-tag-info">
                <span class="tag-text-left">Login Name: </span>
                <span class="tag-text-right">@(Model.UserName2 != null ? Model.UserName2 : Model.UserName)</span>
            </div>
            <div class="wrapper-tag-info">
                <span class="tag-text-left">Account Status: </span>
                <span class="tag-text-right">@Model.StatusName</span>
            </div>
            <div class="wrapper-tag-info">
                <span class="tag-text-left">Subscriber: </span>
                <span class="username tag-text-right">@Model.Subscriber</span>
            </div>

            <div class="wrapper-tag-info">
                <span class="tag-text-left">Level: </span>
                <span class="username tag-text-right">@Model.Role.Name</span>
            </div>
        </div>

        <div class="account-info">
            <!-- Association & Evidence -->
            <div class="info-item association">
                <div class="info-title">Associated Accounts</div>
                <div class="info-block">
                    <div class="info-text left">
                        <span>By Betting Pattern:</span>
                        <span>By Manually:</span>
                        <span>By Device:</span>
                        <span>By IP:</span>
                    </div>
                    <div class="info-text right">
                        <span id="spanAssAccByBettingPattern"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        <span id="spanAssAccByManually"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        <span id="spanAssAccByDevice"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        <span id="spanAssAccByIP"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                    </div>
                </div>
            </div>

            <!-- Classification -->
            <div class="info-item classify">
                <div class="info-title">Classification</div>
                <div class="info-block">
                    <div class="info-text left">
                        <span>Class:</span>
                        <span>Lic VIP:</span>
                        <span id="spanLblFlagEvidence">Flag Evidence:</span>
                        <span id="spanLblAffectedEvidence">Affected Evidence:</span>
                    </div>
                    <div class="info-text right">
                        <span id="spanClass"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        <span id="spanLicVIP"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        <span id="spanFlagEvidence"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        <span id="spanAffectedEvidence"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                    </div>
                </div>
            </div>

            <!-- Dangerous Setting -->
            <div class="info-item dangerous">
                <div class="info-title">Dangerous Setting</div>
                <div class="info-block">
                    <div class="info-text left">
                        <span>Orignal:</span>
                        <span>ABI:</span>
                        <span>Basketball:</span>
                        <span>E-Sports:</span>
                        <span>Other Sports:</span>
                    </div>
                    <div class="info-text right">
                        <span id="spanDangerousOriginal">@Model.DangerousOriginal</span>
                        <span id="spanDangerousABI">@Model.DangerousABI</span>
                        <span id="spanDangerousBasketball">@Model.DangerousBasketball</span>
                        <span id="spanDangerousESports">@Model.DangerousESports</span>
                        <span id="spanDangerouseOtherSports">@Model.DangerousOtherSports</span>
                    </div>
                </div>
            </div>

            <!-- Login Information (Last 90 days) -->
            <div class="info-item login-information">
                <div class="info-title">Login Information (Last 90 days)</div>
                <div class="info-block">
                    <div class="info-text left">
                        <span>Desktop Usage:</span>
                        <span>Mobile Usage:</span>
                        <span>Others Usage:</span>
                        <span>Logins Count:</span>
                        <span>IPs / Devices Count:</span>
                    </div>
                    <div class="info-text right">
                        <span id="spanDesktopUsage"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        <span id="spanMobileUsage"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        <span id="spanOthersUsage"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        <span id="spanLoginCount"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        <span id="spanIPDeviceCount"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                    </div>
                </div>
            </div>



            <!-- Dates -->
            <div class="info-item dates">
                <div class="info-title">Dates</div>
                <div class="info-block">
                    <div class="info-text left">
                        <span id="spanLblNextCategoryScanDate">Next Category Scan:</span>
                        <span id="spanLblLastTicketDate">Last Ticket:</span>
                        <span id="spanLblLastLoginDate">Last Login:</span>
                        <span id="spanLblCreatedDate">Created:</span>
                    </div>
                    <div class="info-text right">                     
                        <span id="spanNextCategoryScanDate"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        <span id="spanLastTicketDate"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        <span id="spanLastLoginDate"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        <span id="spanCreatedDate"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <div class="wrapper-statistic hide" id="wrapper-statistic">
        <div class="statistic-title" id="statistic-title" ref="statistic-detail">
            <i class="icon icon-chevron-right"></i>
            <a class="title" href="javascript:void(0)">
                Betting Statistic Last 90 Days
            </a>
        </div>
       
        <div id="statistic-detail" class="statistic-detail hide">
            <div class="chart_empty hide" id="chart_empty">
                <div class="wrapper_content">
                    <img class="report_empty" src="@Url.Content("~/Content/images/statistic_empty.png")" alt="Loading ..." />
                    <span class="text">There’s no activity to report yet.</span>
                </div>
            </div>
            <div class="chart-default" id="chart-default">
                <div class="container-grid">
                    @Html.Partial("BettingStatistic/Summary")
                    @Html.Partial("BettingStatistic/TurnoverBySport")
                    @Html.Partial("BettingStatistic/TurnoverByBetType")
                    @Html.Partial("BettingStatistic/TurnoverWinLost")
                </div>
            </div>
        </div>
    </div>
</div>

<div class="content-card">
    <div class="status" id="account-detail-header-remove">
        <span class="icon icon-account_detail"></span>
        <span class="info"> Account Detail</span>
    </div>
    <div id="account-detail-container" class="report-content">
        <div id="tabs-account-detail" class="tabs-account-detail">
            <ul class="fixed-tabs">
                <li id="associated_account-tab"><a href="#tabs-1">Associated Accounts</a></li>
                <li id="evidence-tab"><a href="#tabs-2" >Chains to Evidence and Exceptions</a></li>
                <li id="customer-class-tab"><a href="#tabs-3">Customer Classification</a></li>
                <li id="transaction-history-tab"><a href="#tabs-4">Transaction History</a></li>
                <li id="robot-classification-tab"><a href="#tabs-5">Robot Classification</a></li>
                <li id="robot-betting-tab"><a href="#tabs-6">Robot Betting</a></li>
            </ul>
            <div id="tabs-1">
                <div id="associated_account" class="report-cont">
                    <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
                </div>
            </div>
            <div id="tabs-2">
                <div id="chains_evidence" class="report-cont">
                    <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
                </div>
            </div>
            <div id="tabs-3">
                <div id="customer_category" class="report-cont">
                    <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
                </div>
            </div> 
            <div id="tabs-4">
                <div id="trans_history" class="report-cont">
                    <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
                </div>
            </div>
            <div id="tabs-5">
                <div id="robot_classification" class="report-cont">
                    <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
                </div>
            </div>
            <div id="tabs-6">
                <div id="robot_betting" class="report-cont">
                    <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
                </div>
            </div>
        </div>
    </div>
</div>

<div class="hide">
    <input id="hdCTSCustId" type="hidden" value="@Model.CTSCustId" />
    <input id="hdCustId" type="hidden" value="@Model.CustId" />
    <input id="hdCustSubId" type="hidden" value="@Model.CustSubId" />
    <input id="hdUsername" type="hidden" value="@Model.UserName" />
    <input id="hdSubscriberId" type="hidden" value="@Model.SubscriberId" />
    <input id="hdSubscriber" type="hidden" value="@Model.Subscriber" />
    <input id="hdIsHostPermission" type="hidden" IsHostPermission="@Model.IsHostPermission.ToString()" />
    <input id="hdCurrentUserId" type="hidden" value="@Model.CurrentUserId" />
    <input id="hdIsBettingStatisticPermission" type="hidden" IsBettingStatisticPermission="@Model.IsBettingStatisticPermission.ToString()" />
    <input id="hdIsViewIPTransactionPermission" type="hidden" IsViewIPTransactionPermission="@Model.IsViewIPTransactionPermission.ToString()" />
    <input id="hdRoleID" type="hidden" value="@Model.Role.Id" />
</div>
@section scripts{
    @Scripts.Render("~/statistic-scripts"
    , "~/account-detail-scripts"
    , "~/chain-to-evidence-scripts"
    , "~/account/transaction-history-scripts"
    , "~/account/customer-category-scripts"
    , "~/account/robot-classification-scripts"
    , "~/account/robot-betting-scripts")
}