@{
    ViewBag.Title = "AccountDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    <link href="~/Content/scss/pages/account/account.css" rel="stylesheet" />
    <link href="~/Content/scss/pages/evidence/evidence.css" rel="stylesheet" />
    <link href="~/Content/scss/vendors/popoto/popoto.min.css" rel="stylesheet" />
    <link href="~/Content/scss/vendors/popoto/vis/vis-network.min.css" rel="stylesheet" />
}
@model Fanex.NAP.CTS.ViewModel.Account.CustomerGeneralStatusViewModel
<h2 class="page-title">Home</h2>

<div class="content-card">
    <div class="status-info">
        <p>
            <strong>Member:</strong>
            <span class="username">@Model.UserName <span class="nickname" style="color: #c16112">(Nickname)</span></span>
            

            <span class="icon icon-Robot-User"></span>
            <span class="icon icon-Bet-Restricted-Currency"></span>
            <span class="icon icon-Bet-Restricted-Site"></span>
            <span class="icon icon-Affected"></span>
        </p>
        <p>
            <strong>Account Status: </strong>
            <span class="badge-label status-active">@Model.AcountStatus</span>
        </p>
    </div>

    <div class="account-info">
        <!-- Dates -->
        <div class="info-item">
            <div class="info-title">Dates</div>
            <div class="info-block">
                <div class="info-label">
                    <label>Created</label>
                    <label>Last Login</label>
                    <label>Last Ticket</label>
                </div>
                <div class="info-text">
                    <div>Jun 13, 2019, 23:59</div>
                    <div>Jun 13, 2019, 23:59</div>
                    <div>Jun 13, 2019, 23:59</div>
                </div>
            </div>
        </div>

        <!--Dangerous-->
        <div class="info-item">
            <div class="info-title">Dangerous</div>
            <div class="info-block">
                <div class="info-label">
                    <label>Orignal</label>
                    <label>ABI</label>
                    <label>Other Sports</label>
                </div>
                <div class="info-text">
                    <div><span class="dangerous-level-0">None</span></div>
                    <div><span class="dangerous-level-19">19</span></div>
                    <div><span class="dangerous-level-18">18</span></div>
                </div>
            </div>
        </div>

        <!--Abnormal-->
        <div class="info-item">
            <div class="info-title">Abnormal</div>
            <div class="info-block">
                <div class="info-label">
                    <label>Abnormal</label>
                </div>
                <div class="info-text">
                    <div><span class="abnormal-level-0">None</span></div>
                </div>
            </div>
        </div>

        <!-- Auto Suspend-->
        <div class="info-item">
            <div class="info-title">Auto Suspend</div>
            <div class="info-block">
                <div class="info-label">
                    <label>Soccer</label>
                    <label>Other Sports</label>
                    <label>E-Sports</label>
                </div>
                <div class="info-text">
                    <div><a href="#" class="link">Yes</a></div>
                    <div><a href="#" class="link">Yes</a></div>
                    <div>No</div>
                </div>
            </div>
        </div>

        <!-- Association & Evidence-->
        <div class="info-item">
            <div class="info-title">Association & Evidence</div>
            <div class="info-block">
                <div class="info-label">
                    <label>Accounts / Devices</label>
                    <label>Evidence</label>
                </div>
                <div class="info-text">
                    <div><a href="#" class="link">15/25</a></div>
                    <div><a href="#" class="link">6.7, 6.8</a></div>
                </div>
            </div>
        </div>

        <!-- Committed Fraud Case -->
        <div class="info-item">
            <div class="info-title">Association & Evidence</div>
            <div class="info-block">
                <div class="info-label">
                    <label>Classification</label>
                    <label>Fraud case</label>
                </div>
                <div class="info-text">
                    <div class="icon-classification">
                        <span class="icon-dirty"></span>
                        <span class="icon-delinquency">
                        </span><span class="icon-Hedge-Account"></span>
                    </div>
                    <div>
                        <a href="#" class="link">BNG</a>,
                        <a href="#" class="link">Check Bet</a>,
                        <a href="#" class="link">Bets Near Goal</a>,
                        @*<a href="#" class="link">Flagged Account Delay Goal</a>*@
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content-card">
    <div class="status">
        <p class="info" style="margin-bottom: 0">
            <span class="expand-all" title="Expand All"></span>
            <span class="collapse-all" title="Collapse All"></span>
            Account Detail
        </p>
    </div>
    <div id="account-detail-container" class="report-content">
        <div class="report-item">
            <h3 class="report-header" ref="associated_account">
                <i class="icon-chevron-right"></i>
                <a href="#">Associated Accounts</a>
            </h3>
            <div id="associated_account" class="report-cont hide">
                <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
            </div>
        </div>
        <div class="report-item">
            <h3 class="report-header" ref="chains_evidence">
                <i class="icon-chevron-right"></i>
                <a href="#">Chains To Evidence</a>
            </h3>
            <div id="chains_evidence" class="report-cont hide">
                <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
            </div>
        </div>
    </div>

</div>
@section scripts{
    <script src="~/Scripts/MultipleSelect/jquery.multiselect.filter.js"></script>
    <script src="~/Scripts/MultipleSelect/jquery.multiselect.js"></script>
    @*<script src="~/Scripts/Account/Associated/full-graph.js"></script>*@
    <script src="~/Scripts/Account/Associated/short-graph.js"></script>
    <script src="~/Scripts/Account/Associated/sample-data-graph.js"></script>
    @Scripts.Render("~/account-detail-scripts"
    , "~/graph-visualize-lib")

}