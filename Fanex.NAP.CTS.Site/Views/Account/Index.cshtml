@{
    ViewBag.Title = "AccountDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/account-detail-styles")
}
@model Fanex.NAP.CTS.ViewModel.Account.CustomerGeneralStatusViewModel
<h2 class="page-title">Account Profile</h2>
<div class="content-info">
    <span class="tag-text-right spanContentInfoLoading" id="spanContentInfoLoading"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
    <div class="header-info border-green" id="divHeaderInfo" style="visibility:hidden">
        <div class="header-username bg-green" id="divHeaderUsername">
            <div class="block-icon">
                <span class="icon-Robot icon-base-robot hide">
                    <span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span><span class="path6"></span><span class="path7"></span>
                </span>
                <span class="icon-big-Robot icon-big-robot"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span><span class="path6"></span></span>
                <span class="icon-error hide"><span class="path1"></span><span class="path2"></span></span>
                <span class="icon-flag hide"><span class="path1"></span><span class="path2"></span></span>
                <span class="username">@(Model.UserName != null ? Model.UserName : Model.UserName2)</span>
            </div>
        </div>
        <div class="container-status">
            <div class="wrapper-status" id="divCustomerCategorySummary">
            </div>           
        </div>
       
    </div>

    <div class="wrapper-content">
        <div class="tag-info">
            <div class="wrapper-tag-info">
                <span class="tag-text-left">Login Name: </span>
                <span class="tag-text-right">@(Model.UserName2 != null ? Model.UserName2 : Model.UserName)</span>
            </div>
            <div class="wrapper-tag-info">
                <span class="tag-text-left">Account Status: </span>
                <span class="tag-text-right">@Model.StatusName</span>
            </div>
            <div class="wrapper-tag-info">
                <span class="tag-text-left">Subscriber: </span>
                <span class="username tag-text-right">@Model.Subscriber</span>
            </div>

            <div class="wrapper-tag-info">
                <span class="tag-text-left">Level: </span>
                <span class="username tag-text-right">@Model.Role.Name</span>
            </div>
        </div>

        <div class="account-info">
            <!-- Association & Evidence -->
            <div class="info-item association">
                <div class="info-title">Association & Evidence</div>
                <div class="info-block">
                    <div class="info-text left">
                        <span>Accounts / Devices</span>
                        <span>Evidence</span>
                    </div>
                    <div class="info-text right">
                        <span id="spanTotalAssociated" style="cursor:pointer"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        <span id="spanTotalEvidences" style="cursor:pointer"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                    </div>
                </div>
            </div>
            <!-- policies Fraud Case -->
            <div class="info-item policies">
                <div class="info-title">Policies</div>
                <div class="info-block">
                    <div class="info-text left">
                        <span>Class:</span>
                        <span>Bet Limit:</span>
                        <span>Lic VIP:</span>
                    </div>
                    <div class="info-text right">
                        <span id="spanClass"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        <span id="spanBetLimit"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        <span id="spanLicVIP"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                    </div>
                </div>
            </div>


            <!-- Dangerous -->
            <div class="info-item dangerous">
                <div class="info-title">Dangerous</div>
                <div class="info-block">
                    <div class="info-text left">
                        <span>
                            Orignal:
                        </span>
                        <span>
                            ABI:
                        </span>
                        <span>
                            Other Sports:
                        </span>
                    </div>
                    <div class="info-text right">
                        <span id="dangerousOriginal">@Model.DangerousOriginal</span>
                        <span id="dangerouseABI">@Model.DangerouseABI</span>
                        <span id="dangerouseOtherSports">@Model.DangerouseOtherSports</span>
                    </div>
                </div>
            </div>

            <!-- Auto suspend -->
            <div class="info-item auto-suspend">
                <div class="info-title">Auto suspend</div>
                <div class="info-block">
                    <div class="info-text left">
                        <span>
                            Soccer:
                        </span>
                        <span>
                            Other Sports:
                        </span>
                        <span>
                            E-Sports:
                        </span>
                    </div>
                    <div class="info-text right">
                        <span id="autoSuspendSoccer"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        <span id="autoSuspendOtherSport"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                        <span id="autoSuspendESport"><img class="icon-loading" src="~/Content/scss/images/loading.svg" /></span>
                    </div>
                </div>
            </div>



            <!-- Dates -->
            <div class="info-item dates">
                <div class="info-title">Dates</div>
                <div class="info-block">
                    <div class="info-text left">
                        <span>Created</span>
                        <span>Last Login</span>
                        <span>Last Ticket</span>
                    </div>
                    <div class="info-text right">
                        <span>@(Model.CreatedDate.Year == 0001 ? "None" : Model.CreatedDate.ToString("MMM dd, yyyy HH:mm"))</span>
                        <span>@(Model.LastLoginDate.Year == 0001 ? "None" : Model.LastLoginDate.ToString("MMM dd, yyyy HH:mm"))</span>
                        <span>@(Model.LastTicketDate.Year == 0001 ? "None" : Model.LastTicketDate.ToString("MMM dd, yyyy HH:mm"))</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <div class="wrapper-statistic hide" id="wrapper-statistic">
        <div class="statistic-title" id="statistic-title" ref="statistic-detail">
            <i class="icon icon-chevron-right"></i>
            <a class="title" href="javascript:void(0)">
                Betting Statistic Last 90 Days
            </a>
        </div>
       
        <div id="statistic-detail" class="statistic-detail hide">
            <div class="chart_empty hide" id="chart_empty">
                <div class="wrapper_content">
                    <img class="report_empty" src="@Url.Content("~/Content/images/statistic_empty.png")" alt="Loading ..." />
                    <span class="text">There’s no activity to report yet.</span>
                </div>
            </div>
            <div class="chart-default" id="chart-default">
                <div class="container-grid">
                    @Html.Partial("BettingStatistic/Summary")
                    @Html.Partial("BettingStatistic/TurnoverBySport")
                    @Html.Partial("BettingStatistic/TurnoverByBetType")
                    @Html.Partial("BettingStatistic/TurnoverWinLost")
                </div>
            </div>
        </div>
    </div>
</div>

<div class="content-card">
    <div class="status" id="account-detail-header-remove">
        <span class="icon icon-account_detail"></span>
        <span class="info"> Account Detail</span>
    </div>
    <div id="account-detail-container" class="report-content">
        <div id="tabs-account-detail" class="tabs-account-detail">
            <ul class="fixed-tabs">
                <li><a href="#tabs-1" id="associated_account-tab">Associated Accounts</a></li>
                <li><a href="#tabs-2" id="evidence-tab">Chains to Evidence and Exceptions</a></li>
                <li><a href="#tabs-3">Customer Classification</a></li>
                <li><a href="#tabs-4">Transaction History</a></li>
                <li><a href="#tabs-5">Robot Classification</a></li>
                <li><a href="#tabs-6">Robot Betting</a></li>
            </ul>
            <div id="tabs-1">
                <div id="associated_account" class="report-cont">
                    <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
                </div>
            </div>
            <div id="tabs-2">
                <div id="chains_evidence" class="report-cont">
                    <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
                </div>
            </div>
            <div id="tabs-3">
                <div id="customer_category" class="report-cont">
                    <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
                </div>
            </div> 
            <div id="tabs-4">
                <div id="trans_history" class="report-cont">
                    <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
                </div>
            </div>
            <div id="tabs-5">
                <div id="robot_classification" class="report-cont">
                    <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
                </div>
            </div>
            <div id="tabs-6">
                <div id="robot_betting" class="report-cont">
                    <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
                </div>
            </div>
        </div>
    </div>
</div>

<div class="hide">
    <input id="hdCTSCustId" type="hidden" value="@Model.CTSCustId" />
    <input id="hdCustId" type="hidden" value="@Model.CustId" />
    <input id="hdCustSubId" type="hidden" value="@Model.CustSubId" />
    <input id="hdUsername" type="hidden" value="@Model.UserName" />
    <input id="hdSubscriberId" type="hidden" value="@Model.SubscriberId" />
    <input id="hdSubscriber" type="hidden" value="@Model.Subscriber" />
    <input id="hdIsHostPermission" type="hidden" IsHostPermission="@Model.IsHostPermission.ToString()" />
    <input id="hdCurrentUserId" type="hidden" value="@Model.CurrentUserId" />
    <input id="hdIsBettingStatisticPermission" type="hidden" IsBettingStatisticPermission="@Model.IsBettingStatisticPermission.ToString()" />
    <input id="hdIsViewIPTransactionPermission" type="hidden" IsViewIPTransactionPermission="@Model.IsViewIPTransactionPermission.ToString()" />
</div>
@section scripts{
    @Scripts.Render("~/statistic-scripts"
    , "~/account-detail-scripts"
    , "~/chain-to-evidence-scripts"
    , "~/account/transaction-history-scripts"
    , "~/account/customer-category-scripts"
    , "~/account/robot-classification-scripts"
    , "~/account/robot-betting-scripts")
}