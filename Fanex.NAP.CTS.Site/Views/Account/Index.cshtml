@{
    ViewBag.Title = "AccountDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{

    @*<link href="~/Content/scss/pages/evidence/evidence.css" rel="stylesheet" />*@
    <link href="~/Content/scss/vendors/popoto/popoto.min.css" rel="stylesheet" />
    <link href="~/Content/scss/vendors/popoto/vis/vis-network.min.css" rel="stylesheet" />
    <link href="~/Content/scss/MultipleSelect/jquery.multiselect.filter.css" rel="stylesheet" />
    <link href="~/Content/scss/MultipleSelect/jquery.multiselect.css" rel="stylesheet" />
    <link href="~/Content/scss/pages/account/account.css" rel="stylesheet" />
}
@model Fanex.NAP.CTS.ViewModel.Account.CustomerGeneralStatusViewModel
<h2 class="page-title">Home</h2>

<div class="content-card">
    <div class="status-info">
        <p>
            <strong>Member:</strong>
            <span class="username">@Model.UserName <span class="nickname" style="color: #c16112">@(Model.UserName2 != null ? "(" + Model.UserName2 + ")" : string.Empty)</span></span>
            @if (Model.RobotUser)
            {
                <span class="icon icon-Robot-User"></span>
            }

            @if (Model.ProblemAccountWithBetLimit)
            {
                <span class="icon icon-P-with-Bet-Limit"></span>
            }

            @if (Model.ProblemAccountWithBetLimit)
            {
                <span class="icon icon-P-without-Bet-Limit"></span>
            }

            @if (Model.BetRestrictedAccount)
            {
                <span class="icon icon-Bet-Restrict-Account"></span>
            }

            @if (Model.BetRestrictedCurrency)
            {
                <span class="icon icon-Bet-Restrict-Currency"></span>
            }

            @if (Model.BetRestrictedSite)
            {
                <span class="icon icon-Bet-Restrict-Site"></span>
            }

            @if (Model.BetRestrictedSite && Model.BetRestrictedCurrency)
            {
                <span class="icon icon-Bet-Restricted-SiteandCurrency"></span>
            }

            @if (Model.SmartPunterAccount)
            {
                <span class="icon icon-Smart-Punter-Account"></span>
            }

        </p>
        <p>
            <strong>Account Status: </strong>
            <span class="badge-label status-active">@Model.AcountStatus</span>
        </p>
    </div>

    <div class="account-info">
        <!-- Dates -->
        <div class="info-item">
            <div class="info-title">Dates</div>
            <div class="info-block">
                <div class="info-label">
                    <label>Created</label>
                    <label>Last Login</label>
                    <label>Last Ticket</label>
                </div>
                <div class="info-text">
                    <div>@Model.CreatedDate.ToString("MMM dd, yyyy HH:mm")</div>
                    <div>@Model.LastLoginDate.ToString("MMM dd, yyyy HH:mm")</div>
                    <div>@Model.LastTicketDate.ToString("MMM dd, yyyy HH:mm")</div>
                </div>
            </div>
        </div>

        <!--Dangerous-->
        <div class="info-item">
            <div class="info-title">Dangerous</div>
            <div class="info-block">
                <div class="info-label">
                    <label>Orignal</label>
                    <label>ABI</label>
                    <label>Other Sports</label>
                </div>
                <div class="info-text">
                    <div><span class="dangerous-level-@Model.DangerousOriginal">@(Model.DangerousOriginal == 0 ? "None" : Model.DangerousOriginal.ToString())</span></div>
                    <div><span class="dangerous-level-@Model.DangerouseABI">@(Model.DangerouseABI == 0 ? "None" : Model.DangerouseABI.ToString())</span></div>
                    <div><span class="dangerous-level-@Model.DangerouseOtherSports">@(Model.DangerouseOtherSports == 0 ? "None" : Model.DangerouseOtherSports.ToString())</span></div>
                </div>
            </div>
        </div>

        <!--Abnormal-->
        <div class="info-item">
            <div class="info-title">Abnormal</div>
            <div class="info-block">
                <div class="info-label">
                    <label>Abnormal</label>
                </div>
                <div class="info-text">
                    <div><span class="abnormal-level-@Model.Abnormal">@(Model.Abnormal == 0 ? "None" : Model.DangerousOriginal.ToString())</span></div>
                </div>
            </div>
        </div>

        <!-- Auto Suspend-->
        <div class="info-item">
            <div class="info-title">Auto Suspend</div>
            <div class="info-block">
                <div class="info-label">
                    <label>Soccer</label>
                    <label>Other Sports</label>
                    <label>E-Sports</label>
                </div>
                <div class="info-text">
                    <div>@(Model.AutoSuspendSoccer ? Html.Raw("<a href='#' class='link'>Yes</a>") : Html.Raw("No"))</div>
                    <div>@(Model.AutoSuspendOtherSport ? Html.Raw("<a href='#' class='link'>Yes</a>") : Html.Raw("No"))</div>
                    <div>@(Model.AutoSuspendESport ? Html.Raw("<a href='#' class='link'>Yes</a>") : Html.Raw("No"))</div>
                </div>
            </div>
        </div>

        <!-- Association & Evidence-->
        <div class="info-item">
            <div class="info-title">Association & Evidence</div>
            <div class="info-block">
                <div class="info-label">
                    <label>Accounts / Devices / IP</label>
                    <label>Evidence</label>
                </div>
                <div class="info-text">
                    <div><a href="#" class="link">@Model.TotalAssociationByAccount/@Model.TotalAssociationByDevice/@Model.TotalAssociationByIp</a></div>
                    <div><a href="#" class="link">@Model.Evidences</a></div>
                </div>
            </div>
        </div>

        <!-- Committed Fraud Case -->
        <div class="info-item">
            <div class="info-title">Committed Fraud Case</div>
            <div class="info-block">
                <div class="info-label">
                    <label>Classification</label>
                    <label>Fraud case</label>
                </div>
                <div class="info-text">
                    <div class="icon-classification">
                        @if (Model.Delinquency)
                        {
                            <span class="icon-delinquency" />
                        }
                        @if (Model.HedgeAccount)
                        {
                            <span class="icon-Hedge-Account" />
                        }
                        @if (Model.DirtyAccount)
                        {
                            <span class="icon-dirty" />
                        }
                    </div>
                    <div>
                        @if (Model.FraudCases != null && Model.FraudCases.Any())
                        {
                            foreach (var fraudCase in Model.FraudCases)
                            {
                                <a href="#" class="link">@(fraudCase.FraudCaseName + ", ")</a>
                            }
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content-card">
    <div class="status" id="account-detail-header">
        <p class="info" style="margin-bottom: 0">
            <span class="expand-all" title="Expand All"></span>
            @*<span class="collapse-all" title="Collapse All"></span>*@
            Account Detail
        </p>
    </div>
    <div id="account-detail-container" class="report-content">
        <div class="report-item">
            <h3 class="report-header" ref="associated_account">
                <i class="icon-chevron-right"></i>
                <a href="#">Associated Accounts</a>
            </h3>
            <div id="associated_account" class="report-cont hide">
                <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
            </div>
        </div>
        <div class="report-item">
            <h3 class="report-header" ref="chains_evidence">
                <i class="icon-chevron-right"></i>
                <a href="#">Chains To Evidence</a>
            </h3>
            <div id="chains_evidence" class="report-cont hide">
                <img src="@Url.Content("~/Content/images/ajax-loader.gif")" alt="Loading ..." />
            </div>
        </div>
    </div>
</div>
<div class="hide">
    <input id="hdCTSCustId" type="hidden" value="@Model.CTSCustId" />
    <input id="hdCustId" type="hidden" value="@Model.CustId" />
    <input id="hdUsername" type="hidden" value="@Model.UserName" />
</div>
@section scripts{
    <script src="~/Scripts/Account/Associated/graph.js"></script>
    <script src="~/Scripts/Account/Associated/sample-data-graph.js"></script>
    @Scripts.Render(
    "~/graph-visualize-lib"
    , "~/associated-by-account-detail-scripts"
    , "~/account-detail-scripts")
}