@using Fanex.NAP.CTS.Model;

@{
    ViewBag.Title = "AccountAssociatedAccount";
}
@model Fanex.NAP.CTS.ViewModel.Account.Associated.AssociatedByAccountViewModel
@Html.Partial("./Associated/GraphVisualization")
@Html.Partial("./Associated/MatchBettingPattern")
@Html.Partial("./Associated/IPAssociation")

<div id="account-by-account">
    <div id="account-by-account-filter" class="fixed-header">
        <div class="filter">
            @*<div class="form-control radio-button">
                <input type="radio" id="radio03-01" name="demo03" checked />
                <label for="radio03-01">Direct Association with @Model.Username</label>

                <input type="radio" id="radio03-02" name="demo03" />
                <label for="radio03-02">Indirect Association with @Model.Username</label>
            </div>*@
            <div class="form-control dropdown">
                <div class="control-label">Association Type</div>
                <select class="control" id="account-by-account-cbb-association-type">
                    @foreach (var status in Model.AssociationTypeList)
                    {
                        <option value="@status.ItemId" @(status.ItemId == 0 ? "selected" : "")>@status.ItemNameDisplay</option>
                    }
                </select>
            </div>
            <div class="form-control dropdown">
                <div class="control-label">Association Status</div>
                <select class="control" id="association-cbb-status">
                    @foreach (var status in Model.AssociationStatus)
                    {
                        <option value="@status.ItemId" @(status.ItemId == 1 ? "selected" : "")>@status.ItemNameDisplay</option>
                    }
                </select>
            </div>

            <div class="form-control dropdown">
                <div class="control-label">Account Status</div>
                <select class="control" id="cbbAssociationAccountStatus">
                    @{ var defaultSelecteds = "OPEN"; }
                    @foreach (var item in Model.AccountStatusList)
                    {
                        if (defaultSelecteds.Contains(item.Name.ToUpper()))
                        {
                            <option value="@item.Ids" selected>@item.Name</option>
                        }
                        else
                        {
                            <option value="@item.Ids">@item.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="form-control dropdown" style="width: 278px;">
                <div class="control-label">Category</div>
                <select class="control" id="cbbAssociationCategory" multiple="multiple">
                    @foreach (var group in Model.CategoryList)
                    {
                        <optgroup label="@group.CategoryGroupName">
                            @foreach (var item in group.CategoryList)
                            {
                                <option selected value=@item.CategoryIDs>@item.CategoryName</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>

            <div class="form-control dropdown" style="width: 258px;">
                <div class="control-label">Subscriber</div>
                <select class="control" id="cbbAssociationSite" multiple="multiple">
                    @foreach (var group in Model.SubscribersList)
                    {
                        <optgroup label="@group.SubscriberGroupName">
                            @foreach (var item in group.SubscriberList)
                            {
                                <option selected value=@item.SubscriberID>@item.SubscriberName</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
            <div class="form-control" style="vertical-align: bottom;">
                <button class="button btn-search" id="account-by-account-btn-search">Search</button>
            </div>
        </div>

        <div class="graph-heading">
            <div class="free-size"></div>

            <div class="graph-info">
                <div>
                    <button class="button button-primary-outline" id="btnAddAssociation">Add Association</button>
                </div>
                <div>
                    <button class="button button-primary-outline" id="account-by-account-btn-on-graph">View On Graph</button>
                </div>                
            </div>
        </div>
    </div>

    <div class="table-report" id="account-by-account-content">
       
        <table id="account-by-account-table" class="table table-striped" style="width: 100%">
            <thead>
                <tr>
                    <th>Tag</th>
                    <th>Username</th>
                    <th>Login ID</th>
                    <th>Status</th>
                    <th>Subscriber</th>
                    <th>Association Type</th>
                    <th>Customer Category</th>
                    <th>Customer Class</th>
                    <th>Association Status</th>
                    <th>Association Date</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@Html.Partial("Associated/AddAssociation", Model.Username)