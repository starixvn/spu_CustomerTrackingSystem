@model string

    <div id="divAddAssociation" style="display:none;">

        <div class="form-control">
            <div class="label">Username</div>
            <input id="txtassusername" type="text" class="input-field full-width" maxlength="50" />
        </div>
        <div class="form-control">
            <div class="label">To: Associated Account List Of <b>@(Model)</b> </div>
        </div>
        <div class="form-control">
            <div class="label">Comment</div>
            <textarea id="txtasscomment" rows="4" class="comment-field full-width" maxlength="500">If we had a dime for every time we said it, and a dollar for ever time it was ignored...</textarea>
        </div>

        <div class="modal-footer margin-top-10">
            <button id="btncancelassociation" class="button btn-cancel-outline" title="Cancel">Cancel</button>
            <button id="btnsaveassociation" class="button -add" title="Add Exception">Submit</button>
        </div>
    </div>
    
