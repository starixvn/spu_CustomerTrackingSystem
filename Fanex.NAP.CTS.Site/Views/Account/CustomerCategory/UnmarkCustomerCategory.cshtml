@model Fanex.NAP.CTS.ViewModel.Account.CustomerCategory.UnmarkCustomerCategoryViewModel

@if (Model.IsVVip)
{
    <div>
        <div class="form-control">
            <div class="label">Are you sure you want to unmark VVIP - @Model.RoleName <span style="color: #FF0000">@Model.UserName</span></div>
        </div>

        @if (Model.RoleID != 1 && !Model.IsLicensee)
        {
            <div class="form-control">
                <label class="checkbox-container" id="ckbAffectToAllDownlines">
                    <input id="inputVVIPUnmarkAffectToAllDownlines" type="checkbox">
                    <span class="checkmark"></span>
                    Affect all Downlines
                </label>
            </div>
        }
    </div>
}
else
{
<div>
    <div class="form-control">
        <div class="label">Are you sure you want to unmark Problem - @Model.RoleName <span style="color: #FF0000">@Model.UserName</span></div>
    </div>

        @if (Model.RoleID != 1 && !Model.IsLicensee)
        {
            <div class="form-control">
                <label class="checkbox-container" id="ckbAffectToAllDownlines">
                    <input id="inputPAUnmarkAffectToAllDownlines" type="checkbox">
                    <span class="checkmark"></span>
                    Unmark all SMA and Downlines, except for Downlines marked directly
                </label>
            </div>
        }

</div>
}

<div class="modal-footer margin-top-10">
    <button id="btnCCCancelUnmark" class="button btn-cancel-outline" title="Cancel">Cancel</button>
    <button id="btnCCSaveUnmark" class="button -add" title="Unmark Category">Submit</button>
</div>
