@model Fanex.NAP.CTS.ViewModel.Account.CustomerCategory.MarkCategoryViewModel

<div class="form-control">
    <div class="label">Category</div>
    <select id="ddlcategory">
        @foreach (var categoryParent in Model.CustomerCategoryList.Where(x => x.ParentId == 0))
        {
            <optgroup label="@categoryParent.CategoryName">

                @foreach (var category in Model.CustomerCategoryList.Where(x => x.ParentId == categoryParent.CategoryId))
                {
                    <option value="@category.CategoryId">@category.CategoryName</option>
                }
            </optgroup>
        }
    </select>
</div>
