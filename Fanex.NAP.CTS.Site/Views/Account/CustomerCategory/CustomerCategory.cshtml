@using Fanex.NAP.CTS.Model;

@{
    ViewBag.Title = "Customer Category";
}
@model Fanex.NAP.CTS.ViewModel.Account.CustomerCategory.MarkCategoryViewModel

    <div id="customer-category">        
        <div class="table-report" id="customer-category-content">
            <div class="fixed-header">
                <div class="graph-heading">
                    <div class="free-size"></div>

                    <div class="graph-info">
                        <label class="checkbox">
                            <input type="checkbox" id="inputPinCategory" />
                            <span>Pin Category</span>
                        </label>
                        <button id="btnmarkcategory" class="button button-primary-outline" title="Mark Category">Mark Category</button>
                        <button id="btnremovecategory" class="button button-primary-outline" title="Remove Category">Remove Category</button>
                    </div>
                </div>
            </div>
          
            <table id="customer-category-table" class="table table-striped" style="width: 100%">
                <thead>
                    <tr>
                        <th>Date/Time</th>
                        <th>Category</th>
                        <th>Customer Class</th>
                        <th>Reason</th>
                        <th>Add By</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <div id="divMarkCategory" style="display:none;">
    </div>

    <div id="divRemoveCategory" style="display:none;">
    </div>