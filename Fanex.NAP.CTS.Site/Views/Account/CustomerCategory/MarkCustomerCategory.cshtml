
<div class="float-container">
    <div class="float-left">
        <fieldset>
            <legend>Super Test01</legend>
            <div><label class="info-block">VVIP Category</label></div>
            <div>
                <label>
                    <input id="inputCCVVIP" name="group1" type="radio">
                    <span class="checkmark"></span>
                    VVIP
                </label>

                <label id="ckbCCAffectToAllDownlines">
                    <input id="inputCCAffectToAllDownlines" type="checkbox">
                    <span class="checkmark"></span>
                    Affect all Downlines
                </label>
            </div>
            <div>
                <div><label class="info-block">Problem Account Category</label></div>
                <div>
                    <label>
                        <input type="radio" value="value1" name="group2">
                        <span class="checkmark"></span>
                        Group Betting
                    </label>
                    <br />
                    <label>
                        <input type="radio" value="value2" name="group2">
                        <span class="checkmark"></span>
                        Hedging
                    </label>
                    <br />
                    <label>
                        <input type="radio" value="value3" name="group2">
                        <span class="checkmark"></span>
                        Arbitrage
                    </label>
                    <br />
                    <label>
                        <input type="radio" value="value4" name="group2">
                        <span class="checkmark"></span>
                        Fixed Game
                    </label>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="float-right">
        <fieldset>
            <legend>Comment</legend>
            <textarea id="txtcustomercategorycomment" rows="4" class="comment-field full-width" maxlength="300"></textarea>
        </fieldset>
    </div>
</div>

<div class="modal-footer margin-top-10">
    <button id="btncancelcustomercategory" class="button btn-cancel-outline" title="Cancel">Cancel</button>
    <button id="btnsavecustomercategory" class="button -add" title="Add Customer Category">Submit</button>
</div>

