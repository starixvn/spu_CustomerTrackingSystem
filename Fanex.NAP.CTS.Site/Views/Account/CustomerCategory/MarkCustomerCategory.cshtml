
<div class="float-container">
    <div class="float-left">
        <fieldset>
            <legend id="lblCCRoleName">Super Test01</legend>
            <div class="info-block"><label>VVIP Category</label></div>
            <div class="info-item">
                <label>
                    <input id="inputCCVVIP" name="group1" type="radio">
                    <span class="checkmark"></span>
                    VVIP
                </label>

                <label id="ckbCCAffectToAllDownlines">
                    <input id="inputCCAffectToAllDownlines" type="checkbox">
                    <span class="checkmark"></span>
                    Affect all Downlines
                </label>
                <br /><br />
            </div>

            <div class="info-block"><label>Problem Account Category</label></div>
            <div class="info-item">
                <div>
                    @foreach (var paCategory in Model)
                    {
                        <label>
                            <input type="radio" value="@paCategory.CategoryID" data-categorygroup="@paCategory.CategoryGroup" name="group2">
                            <span class="checkmark"></span>
                            @paCategory.CategoryName
                        </label>
                        <br /><br />
                    }
                </div>
            </div>
        </fieldset>
    </div>
    <div class="float-right">
        <fieldset>
            <legend>Comment</legend>
            <textarea id="txtCCComment" rows="4" class="comment-field full-width" maxlength="300"></textarea>
        </fieldset>
    </div>
</div>

<div class="modal-footer margin-top-10">
    <button id="btnCCCancel" class="button btn-cancel-outline" title="Cancel">Cancel</button>
    <button id="btnCCSave" class="button -add" title="Add Customer Category">Submit</button>
</div>

