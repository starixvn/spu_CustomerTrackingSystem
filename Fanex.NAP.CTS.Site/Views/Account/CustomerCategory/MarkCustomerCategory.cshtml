@using Fanex.NAP.CTS.ViewModel;
@model Fanex.NAP.CTS.ViewModel.Account.CustomerCategory.MarkCustomerCategoryViewModel
<div class="float-container" id="divProfileMarkCustomerCategory">
    <div class="float-left">
        <fieldset>
            <legend id="lblCCRoleName">@Model.UserName</legend>
            <div class="info-block"><label>VVIP Category</label></div>
            <div class="info-item">
                <label>
                    @if (Model.IsVVip)
                    {
                        <input id="inputCCVVIP" name="group1" type="radio" checked="checked">
                    }
                    else
                    {
                        <input id="inputCCVVIP" name="group2" type="radio">
                    }
                    <span class="checkmark"></span>
                    VVIP
                </label>

                <label id="ckbCCAffectToAllDownlines">
                    <input id="inputCCAffectToAllDownlines" type="checkbox">
                    <span class="checkmark"></span>
                    Affect all Downlines
                </label>
                <br /><br />
            </div>

            <div class="info-block"><label>Problem Account Category</label></div>
            <div class="info-item" id="groupRadio">
                <div>
                    @foreach (var paCategory in Model.ProblemAccountList)
                    {
                        <label>
                            @if (Model.CategoryList.Any(x => x.CategoryId == paCategory.CategoryID))
                            {
                                <input type="radio" value="@paCategory.CategoryID" data-categorygroup="@paCategory.CategoryGroup" name="@paCategory.CategoryID" checked="checked" disabled="disabled">
                            }
                            else
                            {
                                <input type="radio" value="@paCategory.CategoryID" data-categorygroup="@paCategory.CategoryGroup" name="group2">
                            }

                            <span class="checkmark"></span>
                            @paCategory.CategoryName
                        </label>
                        <br /><br />
                    }
                </div>
            </div>
        </fieldset>     
    </div>
    <div class="float-right">
        <fieldset>
            <legend>Comment</legend>
            <textarea id="txtCCComment" rows="4" class="comment-field full-width" maxlength="300"></textarea>
        </fieldset>
    </div>
</div>

<div class="modal-footer margin-top-10">
    <button id="btnCCCancel" class="button btn-cancel-outline" title="Cancel">Cancel</button>
    <button id="btnCCSave" class="button -add" title="Add Customer Category">Submit</button>
</div>

