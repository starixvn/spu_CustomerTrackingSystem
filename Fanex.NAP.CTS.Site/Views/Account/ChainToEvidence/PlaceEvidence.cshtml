@using Fanex.NAP.CTS.Model;

<div id="divPlaceEvidence" style="display:none;">
    <div class="modal-dialog">
        <div class="box">
            <div class="box-heading">Account Information</div>
            <div class="box-content">
                <div><label class="bold">Account: </label><span id="lblPlaceEvidenceAccount"></span></div>
                <div><label class="bold">Subscriber: </label><span id="lblPlaceEvidenceSubscriber"></span></div>
            </div>
        </div>

        <div class="box">
            <div class="box-heading">Add Evidence</div>
            <div class="box-content">
                <div style="margin-bottom: 10px; width: 340px;">
                    <select id="ddlPlaceEvidenceListEvidence">                       
                    </select>
                </div>
                <div class="flex">
                    <div class="flex-auto-width">
                        <div class="label">Description</div>
                        <div class="content-description" id="divPlaceEvidenceDescription">
                        </div>
                    </div>
                    <div class="flex-auto-width">
                        <div class="label">Comment <span style="font-weight:bold">(max 500 characters)</span></div>
                        <div>
                            <textarea rows="4" class="comment-field" id="txtPlaceEvidenceComment" maxlength="500"></textarea>
                        </div>
                        <div class="quick-group-comment">
                            <button class="button button-quick-comment" title="Arbitrage">Arbitrage</button>
                            <button class="button button-quick-comment" title="Bonus Hunter">Bonus Hunter</button>
                            <button class="button button-quick-comment" title="Group Betting">Group Betting</button>
                            <button class="button button-quick-comment" title="Hedging">Hedging</button>
                            <button class="button button-quick-comment" title="Irrigation Bet">Irrigation Bet</button>
                            <button class="button button-quick-comment" title="Robot Betting">Robot Betting</button>
                            <button class="button button-quick-comment" title="Suspicious Fixed Game">Suspicious Fixed Game</button>
                        </div>
                    </div>
                </div>                
            </div>
        </div>
        <div class="modal-footer margin-top-10">
            <button class="button btn-cancel-outline" id="btnPlaceEvidenceCancel" title="Cancel">Cancel</button>
            <button class="button -add" id="btnPlaceEvidenceSubmit" title="Place Evidence">Submit</button>
        </div>
    </div>
</div>