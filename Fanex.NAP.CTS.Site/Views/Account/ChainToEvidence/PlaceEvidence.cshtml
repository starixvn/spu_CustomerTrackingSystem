<div id="divPlaceEvidence" style="display:none;">
    <div class="modal-dialog">
        <div class="box">
            <div class="box-heading">Account Information</div>
            <div class="box-content">
                <div><label>Account: </label><span id="lblPlaceEvidenceAccount"></span></div>
                <div><label>Subscriber: </label><span id="lblPlaceEvidenceSubscriber"></span></div>
            </div>
        </div>

        <div class="box">
            <div class="box-heading">Add Evidence</div>
            <div class="box-content">
                <div style="margin-bottom: 10px; width: 300px;">
                    <select id="ddlPlaceEvidenceListEvidence"></select>
                </div>
                <div class="box">
                    <div class="box-heading">Description</div>
                    <div class="box-content" id="divPlaceEvidenceDescription">
                    </div>
                </div>
                <div class="box">
                    <div class="box-heading">Comment</div>
                    <div class="box-content">
                        <textarea rows="4" class="comment-field" id="txtPlaceEvidenceComment"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer margin-top-10">
            <button class="button btn-cancel-outline" id="btnPlaceEvidenceCancel">Cancel</button>
            <button class="button -add" id="btnPlaceEvidenceAdd">Add Evidence</button>
        </div>
    </div>
</div>