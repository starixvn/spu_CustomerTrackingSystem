@using Fanex.NAP.CTS.Model;

@{
    ViewBag.Title = "ChainToEvidence";
}

<div id="chain-to-evidence">
    <div class="filter">
        <div class="form-control dropdown">
            <div class="control-label">Evidence List</div>
            <select class="control" id="cbbChainToEvidenceListEvidence" multiple="multiple">
                @*@foreach (var evidence in ViewBag.EvidenceList)
                {
                    <option value="@evidence.EvidenceCode" selected>@(evidence.EvidenceCode + " " + evidence.EvidenceName)</option>
                }*@
            </select>
        </div>
    </div>
    <div class="table-report">
        <div>
            <div class="graph-heading">
                <div class="bold">Flagged Evidence</div>
                <div class="graph-info">
                    <button class="button button-primary-outline" id="btnChainToEvidenceFlagged">Flagged Evidence</button>
                </div>
            </div>
            <table id="tblChainToEvidenceFlagged" class="table table-striped" style="width: 100%">
                <thead>
                    <tr>
                        <th>Evidence</th>
                        <th>Flagged Date/Time</th>
                        <th>Comment</th>
                        <th>Creator</th>
                        <th>Remove</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div class="mt-12">
            <div class="graph-heading">
                <div class="bold">Affected Evidence</div>
            </div>
            <table id="tblChainToEvidenceAffected" class="table table-striped" style="width: 100%">
                <thead>
                    <tr>
                        <th>Evidence</th>
                        <th>Username</th>
                        <th>Login ID</th>
                        <th>Association Type</th>
                        <th>Affected Date/Time</th>
                        <th>Last Login</th>
                        <th>Remove</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div class="mt-12">
            <div class="graph-heading">
                <div class="bold">Exceptions</div>
                <button id="btnaddexceptions" class="button button-primary-outline">Add Exceptions</button>
            </div>
            <table id="tblChainToEvidenceException" class="table table-striped" style="width: 100%">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Login ID</th>
                        <th>Exceptions Date/Time</th>
                        <th>Comment</th>
                        <th>Creator</th>
                        <th>Remove</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@Html.Partial("ChainToEvidence/PlaceEvidence")
@Html.Partial("ChainToEvidence/AddException")