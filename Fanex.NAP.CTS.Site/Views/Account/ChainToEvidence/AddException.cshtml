<div id="divAddException" style="display:none;">
    <div class="form-control">
        <div class="label">Username/Login ID</div>
        <input id="txtusername" type="text" class="input-field full-width" maxlength="50" />
    </div>
    <div class="form-control">
        <div class="label">Comment</div>
        <textarea id="txtcomment" rows="4" class="comment-field full-width"  maxlength="200">If we had a dime for every time we said it, and a dollar for ever time it was ignored...</textarea>
    </div>

    <div class="modal-footer margin-top-10">
        <button id="btncancelexceptions" class="button btn-cancel-outline" title="Cancel">Cancel</button>
        <button id="btnsaveexceptions" class="button -add" title="Add Exception">Submit</button>
    </div>
</div>
    
