@using Fanex.NAP.CTS.Model;

@{
    ViewBag.Title = "RobotBetting";
}

<div>
    <div style="padding-top: 0.6rem">
        <div class="filter">
            <div class="form-control">
                <span id="spanFirstRobotDate"></span>
            </div>
            <div class="form-control">
                <span id="spanLastRobotDate"></span>
            </div>
        </div>
    </div>         
    
    <div id="divRobotBetting" class="table-report">
        <table id="tableRobotBetting" class="table table-striped robotBettingTable" style="width: 100%" >
            <thead>
                <tr>
                    <th class="th1">Trans Date</th>
                    <th class="th2">Match</th>
                    <th class="th3">Trans ID</th>
                    <th class="th4">Bet Type</th>
                    <th class="th5">Bet Team</th>
                    <th class="th6">Stake</th>
                    <th>Odds</th>
                    <th class="th7">Live Score</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div id="divRobotOCRD" class="table-report">
        <table id="tblRobotOCRD" class="table table-striped robotBettingTable" style="width: 100%">
            <thead>
                <tr>
                    <th>Trans Date</th>
                    <th>Trans ID</th>
                    <th>IP</th>
                    <th>Bet Type</th>
                    <th>Bet Team</th>
                    <th>Stake</th>
                    <th>Odds</th>
                    <th>Live Score</th>
                </tr>
            </thead>
        </table>
    </div>
    <div id="divRobotImperva" class="table-report">
        <table id="tblImperva" class="table table-striped robotBettingTable" style="width: 100%">
            <tbody>                
            </tbody>
        </table>
    </div>
</div>
