@using Fanex.NAP.CTS.Model;

@{
    ViewBag.Title = "RobotBetting";
}

<div>
    <div>
        <div>
            <span>First Robot Date</span>
            <span id="spanFirstRobotDate"></span>
        </div>
        <div>
            <span>Last Robot Date</span>
            <span id="spanLastRobotDate"></span>
        </div>
    </div>

    <div id="divRobotBetting" class="table-report">
        <table id="tableRobotBetting" class="table table-striped" style="width: 100%">
            <thead>
                <tr>
                    <th>Trans Date</th>
                    <th>Match</th>
                    <th>Trans ID</th>
                    <th>Bet Type</th>
                    <th>Bet Team</th>
                    <th>Stake</th>
                    <th>Odds</th>
                    <th>Live Score</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
