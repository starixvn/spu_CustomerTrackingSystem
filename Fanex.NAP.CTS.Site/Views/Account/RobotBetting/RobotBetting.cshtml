@using Fanex.NAP.CTS.Model;

@{
    ViewBag.Title = "RobotBetting";
}

<div>
    <div style="padding-top: 0.6rem">
        <div class="filter">
            <div class="form-control">
                <span id="spanFirstRobotDate"></span>
            </div>
            <div class="form-control">
                <span id="spanLastRobotDate"></span>
            </div>
        </div>
    </div>         
    
    <div id="divBotLoginPattern" class="table-report">
        <table id="tblBotLoginPattern" class="table table-striped robot-ai-lp" style="width: 100%">
            <thead>
                <tr>
                    <th class="th1">Date/Time</th>
                    <th class="th2">Device</th>
                    <th class="th3">Robot Tracking</th>
                    <th class="th4">Device Type</th>
                    <th class="th5">Browser</th>
                    <th class="th6">IP</th>                 
                    <th class="th7">Domain</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div id="divRobotBetting" class="table-report">
        <table id="tableRobotBetting" class="table table-striped robotBettingTable" style="width: 100%" >
            <thead>
                <tr>
                    <th class="th1">Trans Date</th>
                    <th class="th2">Match</th>
                    <th class="th3">Trans ID</th>
                    <th class="th4">Bet Type</th>
                    <th class="th5">Bet Team</th>
                    <th class="th6">Stake</th>
                    <th>Odds</th>
                    <th class="th7">Live Score</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div id="divRobotRD" class="table-report">
        <table id="tblRobotRD" class="table table-striped robot-rd-thead-th" style="width: 100%">
            <thead>
                <tr>
                    <th class="th1">Trans Date</th>
                    <th class="th2">Trans ID</th>
                    <th class="th3">IP</th>
                    <th class="th4">Bet Type</th>
                    <th class="th5">Bet Team</th>
                    <th class="th6">Stake</th>
                    <th class="th7">Odds</th>
                    <th class="th8">Live Score</th>
                </tr>
            </thead>
        </table>
    </div>
    <div id="divRobotImperva" class="table-report">
        <div id="tblImperva_wrapper" class="dataTables_wrapper no-footer">
            <table id="tblImperva" class="table table-striped dataTable no-footer" style="width: 100%">
                <tbody>
                </tbody>
            </table>
        </div>
        
    </div>
</div>
