@{
    ViewBag.Title = "IMPORT EVIDENCES";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/import-evidences-styles")
}
<h2 class="page-title">IMPORT EVIDENCES</h2>

<div class="form-filter">
    <div class="col-md-8">
        <input type="file" id="inputFileUpload" name="inputFileUpload" class="form-control" />
    </div>
</div>
<div class="form-filter">
    <div class="col-md-8">
        <button class="button button-import" id="btnImport">Import</button>
    </div>
</div>

<div id="divResult" class="div-grid">
    <table id="tableResult" class="table table-striped width-100per" style="width: 100%">
        <thead>
            <tr class="format-tr">
                <th colspan="4" class="format-th">Error List</th>
            </tr>
            <tr>
                <th>Line</th>
                <th>Username</th>
                <th>Evidence Code</th>
                <th>Error</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<div class="hide">
    <input id="hdIsHostPermission" type="hidden" IsHostPermission="@Model.ToString()" />
</div>

@section scripts{
    @Scripts.Render("~/import-evidences-scripts")
}