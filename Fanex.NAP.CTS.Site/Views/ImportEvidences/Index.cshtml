@{
    ViewBag.Title = "IMPORT EVIDENCES";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/import-evidences-styles")
}
    <h2 class="page-title">MULTIPLE IMPORT EVIDENCES</h2>

    <div class="import-evidences">
        <div action="" method="post" enctype="multipart/form-data" class="form-upload">
            <div class="upload">
                <input type="file" name="inputFileUpload" id="inputFileUpload" />
                <span class="fileName">Select file..</span>
                <input type="button" class="uploadButton" value="Browse..." />
            </div>

            <button class="button button-import" id="btnImport">Import file</button>

        </div>

        <div id="" class="note">
            <div class="group-icon">
                <i class="note-icon icon-chevron-up"></i>
                <a href="javascript:void(0)" class="note-title">Note:</a>
            </div>

            <div id="divNote">
                <div class="wrapper-info">
                    <div>- You can use 2 rows for adding evidence for 1 account</div>
                    <div>- Import file structure:</div>
                    <div class="column-text">    + First Column: Username</div>
                    <div class="column-text">    + Second Column: Evidence Code</div>
                    <div class="required-text">
                        * Requirement: This column must be in Text format
                    </div>
                    <div class="column-text">    + Third Column: Comment</div>
                </div>
                
                <table id="" class="table table-striped table-note-info">
                    <thead>
                        <tr>
                            <th>Username</th>
                            <th>Evidence Code</th>
                            <th>Comment</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Sample1</td>
                            <td>6.4</td>
                            <td>test</td>
                        </tr>
                        <tr>
                            <td>Sample2</td>
                            <td>6.4</td>
                            <td>test</td>
                        </tr>
                        <tr>
                            <td>Sample3</td>
                            <td>6.4</td>
                            <td>test</td>
                        </tr>
                        <tr>
                            <td>Sample4</td>
                            <td>6.4</td>
                            <td>test</td>
                        </tr>
                        <tr>
                            <td>Sample5</td>
                            <td>6.4</td>
                            <td>test</td>
                        </tr>
                        <tr>
                            <td>Sample6</td>
                            <td>6.4</td>
                            <td>test</td>
                        </tr>
                        <tr>
                            <td>Sample7</td>
                            <td>6.4</td>
                            <td>test</td>
                        </tr>
                        <tr>
                            <td>Sample8</td>
                            <td>6.4</td>
                            <td>test</td>
                        </tr>
                        <tr>
                            <td>Sample9</td>
                            <td>6.4</td>
                            <td>test</td>
                        </tr>

                    </tbody>
                </table>

                <div class="get-file">
                    For importing file template, please following this 
                    <span class="btnDownloadTemplate" id="btnDownloadTemplate" style="cursor:pointer; color:deepskyblue">file</span>
                </div>
            </div>

          
        </div>

        <div id="divResult" class="div-grid" hidden="hidden">
            <table id="tableResult" class="table table-striped width-100per tableResult" style="width: 100%">
                <thead>
                    <tr class="format-tr">
                        <th colspan="4" class="format-th">Error List</th>
                    </tr>
                    <tr>
                        <th>Line</th>
                        <th>Username</th>
                        <th>Evidence Code</th>
                        <th>Error</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div id="divResultParseFile" hidden="hidden"></div>

        <div id="divValidation" hidden="hidden">
            <div>Your file has been validated.</div>
            <div>System is automatically importing the evidence data.</div>
            <div>You can start work on other function.</div>
        </div>

        <div class="hide">
            <input id="hdIsHostPermission" type="hidden" IsHostPermission="@Model.ToString()" />
        </div>
    </div>


@section scripts{
    @Scripts.Render("~/import-evidences-scripts")
}
