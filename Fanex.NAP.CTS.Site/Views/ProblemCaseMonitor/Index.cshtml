
@{
    ViewBag.Title = "PROBLEM CASES REPORT";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/problem-case-monitor-styles")
}

<section class="problem-cases-report">
    <div class="content">
        <h2 class="page-title">Problem Case Monitor</h2>
    </div>
    <div class="problem-cases-content">
        <div class="problem-cases-table">
            <div class="group-control">
                <div class="title-problem-cases">
                    <div class="label"> From To Date </div>
                </div>
                <div class="form-filter">
                    <div class="group calendar width-180">
                        <label class="text">From</label>
                        <input type="text" id="dpkFromDate" class="control" readonly>
                        <span class="icon-calendar-text"></span>
                    </div>
                    <div class="group calendar width-180">
                        <label class="text">To</label>
                        <input type="text" id="dpkToDate" class="control" readonly>
                        <span class="icon-calendar-text"></span>
                    </div>
                    <div class="group width-180">
                        <label class="text">Subscriber</label>
                        <div style="width:200px">
                            <select class="control width-select" id="cbbSubscriber" multiple="multiple">
                                @*foreach (var group in ViewBag.Subscribers)
                            {
                                <optgroup label="group.SubscriberGroupName">
                                    foreach (var item in group.SubscriberList)
                                    {
                                        <option selected value=item.SubscriberID>item.SubscriberName</option>
                                    }
                                </optgroup>
                            }*@
                            </select>
                        </div>
                    </div>
                    <div class="group width-180">
                        <label class="text">Problem Cases</label>
                        <select class="control width-select" id="cbbProblemCases" multiple="multiple">
                        </select>
                    </div>
                    <button class="button button-generate" id="btnGenerate">Generate</button>
                </div>
            </div>

            <div id="problemAccountMonitorGrid" class="problem-cases-datatable">
                <div class="fixed-header">
                    <div class="top-header">
                        <div class="export-excel">
                            <button class="button btnExcel" id="btnExportExcel" title="Export to Excel" >
                                <i class="icon icon-excel"></i>
                            </button>  
                        </div>
                    </div>
                </div>

                <table id="tblProblemCasesReport" class="table table-striped width-100per table-problem-cases" style="width: 100%">
                    <thead>
                        <tr>
                            <th>Username</th>
                            <th>Subscriber</th>
                            <th>Robot</th>
                            <th>Suspicious Association</th>
                            <th>Pro Punter</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
</section>



