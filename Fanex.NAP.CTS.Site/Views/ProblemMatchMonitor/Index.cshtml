@{
    ViewBag.Title = "PROBLEM MATCH MONITOR";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/problem-match-monitor-styles")
    <link href="~/Content/scss/vendors/select2.min.css" rel="stylesheet" />
}
<h2 class="page-title">Problem Match Monitor</h2>

<div class="form-filter">
    <div class="group calendar">
        <label class="text">Date</label>
        <input type="text" id="dpkDate" class="control">
        <span class="icon-calendar-text"></span>
    </div>
    <div class="group width-196">
        <label class="text">Sport</label>
        <select class="control" id="cbbSport">
            <option value="1">Soccer</option>
        </select>
    </div>
    <div class="group width-336">
        <label class="text">League</label>
        <select class="control" id="cbbLeague" name="state"></select>
    </div>
    <div class="group width-196">
        <label class="text">Match Status</label>
        <select class="control" id="cbbMatchStatus">
            <option>All</option>
            <option value="running" selected>Running</option>
            <option value="completed">Completed</option>
        </select>
    </div>
    <button class="button -primary" id="btnGenerate">Generate</button>
</div>

<div id="problemMatchMonitorGrid" class="div-grid">
    <div class="top-header">
        <div class="refresh">
            <div class="refresh-action">
                <span class="number" id="refreshCountDown">-</span>
                <button class="icon" id="btnRefresh"><span class="icon-autorenew"></span></button>
            </div>
            <select class="refresh-option first" id="refreshInterval">
                <option value="--">Not refresh</option>
                <option value="60">60s</option>
                <option value="120">120s</option>
                <option value="180">180s</option>
                <option value="300">300s</option>
            </select>
        </div>
    </div>

    <table id="problemMatchMonitorTable" class="table table-striped width-100per" style="width: 100%">
        <thead>
            <tr>
                <th>#</th>
                <th>Event</th>
                <th>Match Score</th>
                <th>Status</th>
                <th>Group Betting</th>
                <th>Hedging</th>
            </tr>
            <tr class="format-tr">
                <th colspan="6" class="format-th"></th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@section scripts{
    <script>
        var balanceUpDay = new Date(@Model.Year, @(Model.Month - 1), @Model.Day);
    </script>    
    <script src="~/Scripts/select2.min.js"></script>
    @Scripts.Render("~/problem-match-monitor-scripts")
}