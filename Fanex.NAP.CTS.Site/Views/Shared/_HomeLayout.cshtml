@using Fanex.NAP.Core.Configuration
<!doctype html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Customer Tracking System</title>
    <link href="https://fonts.googleapis.com/css?family=Lato:400,400i,700" rel="stylesheet">
    <link href="~/Content/scss/fonts/Fraud-Sensor/style.css" rel="stylesheet" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    @Styles.Render("~/Content/styles")
    @RenderSection("styles", false)
    @Scripts.Render("~/bundles/modernizr")
    @Scripts.Render("~/bundles/jquery")
</head>
<body>
    <header class="header">        
        <div class="toggle-btn toggle-close">
            <span class="lines"></span>
        </div>
        <a href="@Url.Action("Index", "Home")" class="logo">
            <svg width="148" height="38">
                <image xlink:href="~/Content/scss/images/logo-header.svg" src="~/Content/scss/images/logo-header.png" width="148" height="38" alt="Customer Tracking System" />
            </svg>
        </a>
        <div class="header-right">
            @{
                var property = ViewContext.Controller.GetType().GetProperty("BaseControllerName");

                var baseControllerName = property.GetValue(ViewContext.Controller, null).ToString();
            }

            @Html.Action("Menu", "Home", new { activeMenu = baseControllerName })
            @Html.Partial("_HomeLoginPartial")
        </div>
    </header>
    <section class="wrapper">
        <div class="content">
            @RenderBody()
        </div>
    </section>

    <div id="loading">
        <div class="ui-widget-overlay ui-front"></div>
        <div class="loader"></div>
    </div>

    <div class="cover-bg visible"></div>

    <div id="formconfirmation" title=""></div>
    <div id="confirmation" title="Confirmation"></div>
    <div id="success" style="color: #4f971f" class="text-center"></div>
    <div id="error" style="color:red" class="text-center"></div>
    <!-- Matomo -->
    <script type="text/javascript">
        var _paq = window._paq || [];
        /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
        _paq.push(["setDoNotTrack", true]);
        _paq.push(["disableCookies"]);
        _paq.push(['trackPageView']);
        _paq.push(['enableLinkTracking']);
        (function () {
            var u = "//matomo.starific.net/";
            _paq.push(['setTrackerUrl', u + 'matomo.php']);
            _paq.push(['setSiteId', '@Fanex.NAP.CTS.Core.Utilities.ConfigSettings.Matomo_SiteId']);
            var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
            g.type = 'text/javascript'; g.async = true; g.defer = true; g.src = u + 'matomo.js'; s.parentNode.insertBefore(g, s);
        })();
    </script>
    <noscript><p><img src="//matomo.starific.net/matomo.php?idsite=@Fanex.NAP.CTS.Core.Utilities.ConfigSettings.Matomo_SiteId&amp;rec=1" style="border:0;" alt="" /></p></noscript>
    <!-- End Matomo Code -->
    <script>
        var config = {
        contextPath: '@Url.Content("~")'
    };
    </script>
    @if (NapSettings.Settings.EnableReCheckIn)
    {
        <script src="~/Areas/UserLogin/scripts/ReCheckIn.js" type="text/javascript"></script>
    }
    @Scripts.Render("~/core")
    @Scripts.Render("~/notification")

    @RenderSection("scripts", required: false)
    @Scripts.Render("~/finalize")
</body>
</html>