@using System.Collections.Generic;
@using Fanex.NAP.CTS.Resource.Consts;
@using Fanex.NAP.Core.Models;
@model IList<MenuItem>

@{
    Func<string, string> iconLookup = menuName =>
    {
        switch (menuName)
        {
            case "Home":
                return "<span class='icon icon-home'></span>";
            case "Account & Device Search":
                return "<span class='icon icon-account-device'></span>";
            case "Suspicious Bets":
                return "<span class='icon icon-warning'></span>";
            case "Report":
                return "<span class='icon icon-reports'></span>";
            case "Configurations":
                return "<span class='icon icon-settings'></span>";
            case "Association":
                return "<span class='icon icon-settings'></span>";
            case "Notification":
                return "<span class='icon icon-email'></span>";
            case "Settings":
                return "<span class='icon icon-email'></span>";
            case "Controller":
                return "<span class='icon icon-Controller'></span>";
            case "Monitor":
                return "<span class='icon icon-monitor'></span>";
            default:
                return string.Empty;
        }
    };

    var controllerBaseType = ViewBag.ActiveMenu as string;
}

<ul class="main-menu">
    <li class="menu-item" id="menu-home"><a href="@Url.Action("Index", "Home")" class="link @(controllerBaseType.Contains(Consts.MenuItemHome) ? "active" : "")">@Html.Raw(iconLookup("Home")) Home</a></li>
    @foreach (var menu in Model.Where(m => string.IsNullOrEmpty(m.ParentName) && m.IsActive && m.Name != "Home").OrderBy(m => m.DisplayOrder))
    {
        var subMenus = Model.Where(m => !string.IsNullOrEmpty(m.ParentName) && m.IsActive && m.ParentId == menu.Id).OrderBy(m => m.DisplayOrder);

        <li class="menu-item" id="@menu.Name">
            <a href="#@menu.Name" class="link @(subMenus.Any() ? "has-child" : "") @(controllerBaseType.Equals(menu.Name) ? "active" : "")">@Html.Raw(iconLookup(menu.Name)) @menu.Name</a>
            @if (subMenus.Any())
            {
                <ul class="sub-menu">
                    @foreach (var subMenu in subMenus)
                    {
                        <li class="sub-menu-item">
                            <a href="@Url.Content(subMenu.ValidUrl)" class="link">@subMenu.Name</a>
                        </li>
                    }
                </ul>
            }
        </li>
    }
</ul>