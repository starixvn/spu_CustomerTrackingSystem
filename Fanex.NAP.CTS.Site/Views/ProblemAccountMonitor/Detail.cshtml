@model Fanex.NAP.CTS.ViewModel.ProblemAccountMonitor.DetailViewModel
@{
    ViewBag.Title = "PROBLEM MATCH MONITOR";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/problem-account-monitor-detail-styles")
}

<div class="page-title">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "ProblemAccountMonitor")">PROBLEM MATCH MONITOR</a></li>
        <li class="breadcrumb-item active" aria-current="page">DETAIL</li>
    </ol>
</div>


<div class="form-filter-detail fixed-header">
    <div class="block-top">
        <div class="group">
            <table class="table__detail-left">
                <tr>
                    <td class="info-name">Event</td>
                    <td class="info-value" id="lblMatchName"></td>
                    <td class="info-name">Evidence</td>
                    <td class="info-value" id="lblEvidence"></td>
                </tr>
                <tr>
                    <td class="info-name">Date</td>
                    <td class="info-value" id="lblEventDate"></td>
                    <td class="info-name">HT/FT Score</td>
                    <td class="info-value" id="lblScore"></td>
                </tr>
            </table>
        </div>

        <div class="group">
            <table class="table__detail-right">
                <tr>
                    <td rowspan="2" class="info-name">Special <br /> Notes:</td>
                    <td class="info-value"><span class="bg-red">Red</span></td>
                    <td class="info-value">Goal Score < Match Goal Score</td>
                </tr>
                <tr>
                    <td class="info-value"><span class="bg-green">Green</span></td>
                    <td class="info-value">Placed after 75<span class="sup">th</span> min</td>
                </tr>
            </table>
        </div>
    </div>

    <div class="block-bottom">
        <div class="group width-200">
            <label class="text">Contain ticket from site</label>
            <select class="control" id="cbbSite" multiple="multiple"></select>
        </div>
        <div class="group width-200">
            <label class="text">Bet Type</label>
            <select class="control" id="cbbBetType" multiple="multiple"></select>
        </div>
        <div class="group width-200">
            <label class="text">Currency</label>
            <select class="control" id="cbbCurrency" multiple="multiple"></select>
        </div>
        <div class="group width-200" id="divStakeRangeContainer">
            <label class="text">Stake Range</label>
            <div class="block-range" style="cursor:pointer;" id="btnShowStakeRange">
                <i class="icon-down icon-chevron-down"></i>
                <span class="control cbbStake" id="lblStakeRange">0 - 10000</span>
            </div>
            <div id="formInputStakeRange" class="formInputStakeRange">
                <label class="text">Stake Range</label>
                <div class="block-input">
                    <span class="text">Min:</span>
                    <input class="control" type="number" min="0" value="0" id="inputStakeMin" />
                </div>
                <div class="block-input">
                    <span class="text">Max:</span>
                    <input class="control" type="number"  min="0" maxlength="15" value="10000" id="inputStakeMax" />
                </div>
                <button class="button button-generate" id="btnApply">Apply</button>
            </div>
        </div>
        <div class="button-left">            
            <button class="button button-generate" id="btnGenerate">Generate</button>
        </div>
    </div>    
</div>

<div class="div-grid -detail">
    <table id="ticketsTable" class="table width-100per" style="width: 100%">
        <thead>
            <tr>
                <th>#</th>
                <th>Trans Date</th>
                <th>Username</th>
                <th>Currency</th>
                <th>Site</th>
                <th>Bettype</th>
                <th>BetID</th>
                <th>Choice</th>
                <th>Live Bet Score</th>
                <th>Handicap</th>
                <th>Stake</th>
                <th>Odds</th>
                <th>Status</th>
                <th>Void</th>
            </tr>
            <tr class="format-tr">
                <th colspan="14" class="format-th">
                    <div class="wrapper-selections">
                        <span class="detail-selections">
                            Total: <span id="spanTotalSelections">0</span> selections (Max: 2000 selections)
                        </span>
                        <select class="control" id="cbbVoid" multiple="multiple">
                            <option value="red">Red</option>
                            <option selected value="white">White</option>
                            <option value="green">Green</option>
                        </select>
                    </div>                   
                </th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<div class="div-grid detail__button-bottom" style="text-align: right">
    <div class="group">
        <button class="button" id="btnCopyToClipboard">Copy to clipboard</button>
        @*@<button class="button" id="btnVoidAllRequest">Void All(Instant) Request</button>
        <button class="button" id="btnVoidManualRequest">Manual Void Request</button>*@

        <form action="@Model.VoidRequestToTVSParam.TargetUrl" id="formCreateVoidRequest" enctype="multipart/form-data" method="post" target="_blank" hidden>
            <input id="UserId" type="hidden" value="@Model.VoidRequestToTVSParam.UserId" />
            <input id="OnUserId" type="hidden" value="@Model.VoidRequestToTVSParam.OnUserId" />
            <input id="Time" type="hidden" value="@Model.VoidRequestToTVSParam.Time" />
            <input id="IsTest" type="hidden" value="@Model.VoidRequestToTVSParam.IsTest" />
            <input id="TransIds" type="hidden" value="@Model.VoidRequestToTVSParam.TransIds" />
            <button class="button" id="btnCreateVoidRequest">Create Void Request</button>
        </form>
</div>
</div>

<div class="hide">
    <input id="hdMatchId" type="hidden" value="@Model.MatchId" />
    <input id="hdFraudCaseId" type="hidden" value="@Model.FraudCaseId" />
    <input id="hdIsHostPermission" type="hidden" IsHostPermission="@Model.IsHostPermission.ToString()" />
</div>
@section scripts{    
    @Scripts.Render("~/problem-account-monitor-detail-scripts")
}
