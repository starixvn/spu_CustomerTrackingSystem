@{
    ViewBag.Title = "PROBLEM ACCOUNT MONITOR";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles{
    @Styles.Render("~/problem-account-monitor-styles")
}
    <h2 class="page-title">PROBLEM ACCOUNT MONITOR</h2>



    <div id="problemAccountMonitorGrid" class="div-grid">
        <div class="fixed-header">
            <div class="form-filter">
                <div class="group calendar width-180">
                    <label class="text">Date</label>
                    <input type="text" id="dpkDate" class="control" readonly>
                    <span class="icon-calendar-text"></span>
                </div>
                <div class="group width-180">
                    <label class="text">Sport</label>
                    <select class="control" id="cbbSport" multiple="multiple">
                    </select>
                </div>
                <div class="group width-320">
                    <label class="text">League</label>
                    <select class="control" id="cbbLeague" name="state"></select>
                </div>
                <div class="group width-180">
                    <label class="text">Match Status</label>
                    <select class="control" id="cbbMatchStatus">
                        <option value="All" selected>All</option>
                        <option value="running">Running</option>
                        <option value="completed">Completed</option>
                    </select>
                </div>
                <div class="group width-180">
                    <label class="text">Site</label>
                    <select class="control" id="cbbSite" multiple="multiple">
                    </select>
                </div>
                <button class="button button-generate" id="btnGenerate">Generate</button>
            </div>
            <div class="top-header">
                <div class="refresh">
                    <div class="refresh-action">
                        <span class="number" id="refreshCountDown">-</span>
                        <button class="icon" id="btnRefresh" title="Click to refresh"><span class="icon-autorenew"></span></button>
                    </div>
                    <select class="refresh-option first" id="refreshInterval">
                        <option value="--">Not refresh</option>
                        <option value="60">60s</option>
                        <option value="120">120s</option>
                        <option value="180">180s</option>
                        <option value="300">300s</option>
                    </select>
                </div>
            </div>
        </div>
        

        <table id="problemAccountMonitorTable" class="table table-striped width-100per" style="width: 100%">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Event</th>
                    <th>Match Score</th>
                    <th>Status</th>
                    <th>Group Betting</th>
                    <th>Hedging</th>
                </tr>
                @*<tr class="format-tr">
                    <th colspan="6" class="format-th"></th>
                </tr>*@
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div>
        @using (Html.BeginForm("Detail", "ProblemAccountMonitor", FormMethod.Post, new { id = "formViewDetail", target = "_blank" }))
        {
            @Html.Hidden("matchId", "123456", new { id = "matchId" });
            @Html.Hidden("fraudCaseId", "13", new { id = "fraudCaseId" });
            @Html.Hidden("siteIds", "", new { id = "siteIds" });
        }
    </div>

@section scripts{
    <script>
        var balanceUpDay = new Date(@Model.Year, @(Model.Month - 1), @Model.Day);
    </script>    
    @Scripts.Render("~/problem-account-monitor-scripts")
}