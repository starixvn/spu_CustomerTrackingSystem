//USE ctsgraphdb
USE ctslocal
CALL apoc.cypher.run('
MATCH (c:CTSCustomer)-[r:ADD_MANUALLY]-(c2:CTSCustomer)
WHERE c.CTSCustID = $ip_CTSCustId AND c2.CustID IS NOT NULL AND
	(($ip_assStatus = 0) 
	OR ($ip_assStatus = 1 AND not exists((c)-[:HAS_EXCEPTION]-(c2)))
    OR ($ip_assStatus = 2 AND exists((c)-[:HAS_EXCEPTION]-(c2))))
	AND
	   (($ip_IsAssReport = 0)
	OR  ($ip_IsAssReport = 1 AND r.CreatedDate >= datetime($ip_AssCreatedFrom) AND r.CreatedDate <= datetime($ip_AssCreatedTo)))
WITH c,c2,r
OPTIONAL MATCH (c)-[e:HAS_EXCEPTION]-(c2)
OPTIONAL MATCH (c2)-[:BELONG_TO_SUB]->(s:Subscriber)
OPTIONAL MATCH (c2)-[:HAS_STATUS]->(st:StaticList)
WITH c,c2,r,st,e,s
WHERE   (($ip_IsAssReport = 1)
		OR  ($ip_IsAssReport = 0 AND st.ItemID IN $ip_AccountStatuses AND st.ListID = 1 AND s.SubscriberID IN $ip_SubscriberIDs))  

RETURN c2.CTSCustID as CTSCustID
	, c2.CustID AS CustId
	, c2.Username AS Username
	, c2.Username2 AS Username2
	, collect(3) as AssociationType
	, -1 AS SharedDevices
	, -1 AS SharedIPs
	, s.SubscriberID AS SubscriberId
	, s.SubscriberName as SubscriberName
	, r.CreatedDate as AssociationDateGMT0
	, CASE e WHEN null THEN 1 ELSE 2 END AS AssociationStatus
	, st.ItemID as StatusId
	, st.ItemNameDisplay as StatusName
	, CASE WHEN st.ItemID in [1,11] THEN 1 ELSE 2 END AS PriorityStatusOrder
',{ip_CTSCustId: $CTSCustID, ip_assStatus: $AssStatus, ip_IsAssReport: $IsAssReport, ip_AssCreatedFrom: $AssCreatedFrom, ip_AssCreatedTo: $AssCreatedTo, ip_SubscriberIDs: $SubscriberIDs, ip_AccountStatuses: $AccountStatuses}) YIELD value 
WITH collect(value) as ListAss, count(value) as TotalItems
UNWIND ListAss as ass
WITH ass, TotalItems 
ORDER BY ass.SiteName, ass.AssociationStatus, ass.PriorityStatusOrder, ass.AssociationDateGMT0 DESC
SKIP $Skip
LIMIT $Pagesize
RETURN COLLECT(ass) AS AssociationList, TotalItems