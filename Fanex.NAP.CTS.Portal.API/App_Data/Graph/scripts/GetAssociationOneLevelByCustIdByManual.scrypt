CALL apoc.cypher.run('
MATCH (c:CTSCustomer)-[r:ADD_MANUALLY]-(c2:CTSCustomer)
WHERE c.CTSCustID = $ip_CTSCustId AND 
	(($ip_assStatus = 0) 
	OR ($ip_assStatus = 1 AND not exists((c)-[:HAS_EXCEPTION]-(c2)))
    OR ($ip_assStatus = 2 AND exists((c)-[:HAS_EXCEPTION]-(c2))))
WITH c,c2,r
OPTIONAL MATCH (c)-[e:HAS_EXCEPTION]-(c2)
RETURN c2.CTSCustID as CTSCustID, c2.CustID AS CustId, c2.UserName AS Username, c2.UserName2 AS Username2, 3 as AssociationType, -1 AS SharedDevices, -1 AS SharedIPs, CASE c2.SubscriberID WHEN null THEN -1 ELSE c2.SubscriberID END AS SubscriberId, apoc.date.format(r.CreatedDate,"ms","yyyy-MM-dd HH:mm:ss") as AssociationDate, CASE e WHEN null THEN 1 ELSE 2 END AS AssociationStatus
',{ip_CTSCustId: $CTSCustID, ip_assStatus: $AssStatus}) YIELD value 
WITH collect(value) as ListAss, count(value) as TotalItems
UNWIND ListAss as ass
WITH ass, TotalItems 
SKIP $Skip
LIMIT $Pagesize
RETURN COLLECT(ass) AS AssociationList, TotalItems