CALL apoc.cypher.run('
MATCH (c:CTSCustomer)-[r2:USED_IP]->(i:IP)<-[r3:USED_IP]-(c2:CTSCustomer)
WHERE c.CTSCustID = $ip_CTSCustId AND 
	(($ip_assStatus = 0) 
	OR ($ip_assStatus = 1 AND not exists((c)-[:HAS_EXCEPTION]-(c2)))
    OR ($ip_assStatus = 2 AND exists((c)-[:HAS_EXCEPTION]-(c2))))
	AND
	  	   (($ip_IsAssReport = 0)
	OR  ($ip_IsAssReport = 1 AND datetime(r2.CreatedTime) > datetime(r3.CreatedTime) AND datetime(r2.CreatedTime) >= datetime($ip_AssCreatedFrom) AND datetime(r2.CreatedTime) <= datetime($ip_AssCreatedTo))
	OR  ($ip_IsAssReport = 1 AND datetime(r3.CreatedTime) >= datetime(r2.CreatedTime) AND datetime(r3.CreatedTime) >= datetime($ip_AssCreatedFrom) AND datetime(r3.CreatedTime) <= datetime($ip_AssCreatedTo)))
WITH c,c2,i,r2,r3
OPTIONAL MATCH (c)-[e:HAS_EXCEPTION]-(c2)
OPTIONAL MATCH (c2)-[:BELONG_TO_SITE]->(s:Site)
OPTIONAL MATCH (c2)-[:HAS_STATIC]->(st:Static)
WITH c,c2,i,r2,r3,st,e,s
WHERE   (($ip_IsAssReport = 1)
		OR  ($ip_IsAssReport = 0 AND st.ItemID IS NOT NULL AND st.ItemID IN $ip_AccountStatuses AND s.SiteID IS NOT NULL AND s.SiteID IN $ip_SiteIDs))  
RETURN c2.CTSCustID as CTSCustID, c2.CustID AS CustId, c2.UserName AS Username, c2.UserName2 AS Username2, 2 as AssociationType, -1 AS SharedDevices, -1 AS SharedIPs, CASE c2.SubscriberID WHEN null THEN -1 ELSE c2.SubscriberID END AS SubscriberId, CASE WHEN (r2.CreatedTime >= r3.CreatedTime) THEN r2.CreatedTime ELSE r3.CreatesTime END as AssociationDateGMT0, CASE e WHEN null THEN 1 ELSE 2 END AS AssociationStatus, 
		s.SiteID as SiteID, s.Site as SiteName, st.ItemID as StatusId, st.ItemName as StatusName
',{ip_CTSCustId: $CTSCustID, ip_assStatus: $AssStatus, ip_IsAssReport: $IsAssReport, ip_AssCreatedFrom: $AssCreatedFrom, ip_AssCreatedTo: $AssCreatedTo, ip_SiteIDs: $SiteIDs, ip_AccountStatuses: $AccountStatuses}) YIELD value 
WITH collect(value) as ListAss, count(value) as TotalItems
UNWIND ListAss as ass
WITH ass, TotalItems 
ORDER BY ass.AssociationDateGMT0 DESC
SKIP $Skip
LIMIT $Pagesize
RETURN COLLECT(ass) AS AssociationList, TotalItems