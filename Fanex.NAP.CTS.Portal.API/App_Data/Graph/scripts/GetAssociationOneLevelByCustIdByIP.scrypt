CALL apoc.cypher.run('
MATCH (c:CTSCustomer)-[r2:USED_IP]->(i:IP)<-[r3:USED_IP]-(c2:CTSCustomer)
WHERE c.CTSCustID = $ip_CTSCustId AND c2.CustID IS NOT NULL AND
	(($ip_assStatus = 0) 
	OR ($ip_assStatus = 1 AND not exists((c)-[:HAS_EXCEPTION]-(c2)))
    OR ($ip_assStatus = 2 AND exists((c)-[:HAS_EXCEPTION]-(c2))))
UNWIND [r2.CreatedTime,r3.CreatedTime]  as val
WITH c,c2,i, Max(val) as AssDate
OPTIONAL MATCH (c)-[e:HAS_EXCEPTION]-(c2)
OPTIONAL MATCH (c2)-[:BELONG_TO_SITE]->(s:Site)
OPTIONAL MATCH (c2)-[:HAS_STATUS]->(st:StaticList)
WITH c,c2,i,st,e,s, AssDate
WHERE   (($ip_IsAssReport = 1 AND st.ItemID IS NOT NULL AND st.ItemName IS NOT NULL)
		OR  ($ip_IsAssReport = 0 AND st.ItemID IS NOT NULL AND st.ItemID IN $ip_AccountStatuses AND st.ListID = 1 AND s.SiteID IS NOT NULL AND s.SiteID IN $ip_SiteIDs))  
WITH c,c2,st,e,s, Min(AssDate) as firstAssDate
WHERE (($ip_IsAssReport = 0)
     OR ($ip_IsAssReport = 1 AND firstAssDate >= $ip_AssCreatedFrom AND firstAssDate <= $ip_AssCreatedTo)
RETURN c2.CTSCustID as CTSCustID, c2.CustID AS CustId, c2.UserName AS Username, c2.UserName2 AS Username2, collect(4) as AssociationType, -1 AS SharedDevices, -1 AS SharedIPs, CASE c2.SubscriberID WHEN null THEN -1 ELSE c2.SubscriberID END AS SubscriberId, firstAssDate as AssociationDateGMT0, CASE e WHEN null THEN 1 ELSE 2 END AS AssociationStatus, 
		s.SiteID as SiteID, s.Site as SiteName, st.ItemID as StatusId, st.ItemName as StatusName, CASE WHEN st.ItemID in [1,11] THEN 1 ELSE 2 END AS PriorityStatusOrder
',{ip_CTSCustId: $CTSCustID, ip_assStatus: $AssStatus, ip_IsAssReport: $IsAssReport, ip_AssCreatedFrom: $AssCreatedFrom, ip_AssCreatedTo: $AssCreatedTo, ip_SiteIDs: $SiteIDs, ip_AccountStatuses: $AccountStatuses}) YIELD value 
WITH collect(value) as ListAss, count(value) as TotalItems
UNWIND ListAss as ass
WITH ass, TotalItems 
ORDER BY ass.SiteName, ass.AssociationStatus, ass.PriorityStatusOrder, ass.AssociationDateGMT0 DESC
SKIP $Skip
LIMIT $Pagesize
RETURN COLLECT(ass) AS AssociationList, TotalItems