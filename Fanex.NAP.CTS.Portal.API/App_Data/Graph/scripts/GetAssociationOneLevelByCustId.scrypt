MATCH (c:CTSCustomer)-[:USED_DEVICE]->(d:Device)<-[:USED_DEVICE]-(c1:CTSCustomer)
MATCH (c)-[:USED_IP]->(i:IP)<-[:USED_IP]-(c1)
WHERE c.CustID = $CustId
RETURN c1.CustID AS CustId, c1.UserName AS Username, c1.UserName2 AS Username2, 1 AS AssociationType, COUNT(d) AS SharedDevice, COUNT(i) AS SharedIP
UNION ALL
MATCH (c:CTSCustomer)-[:USED_IP]->(i:IP)<-[:USED_IP]-(c2:CTSCustomer)
MATCH (c)-[:USED_DEVICE]->(d:Device)<-[:USED_DEVICE]-(c2)
WHERE c.CustID = $CustId
RETURN c2.CustID AS CustId, c2.UserName AS Username, c2.UserName2 AS Username2, 2 as AssociationType, COUNT(d) AS SharedDevice, COUNT(i) AS SharedIP