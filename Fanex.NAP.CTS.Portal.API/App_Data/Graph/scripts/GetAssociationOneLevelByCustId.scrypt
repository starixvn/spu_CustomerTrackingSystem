CALL apoc.cypher.run('
MATCH (c:CTSCustomer)-[r:USED_DEVICE]->(d:Device)<-[r1:USED_DEVICE]-(c1:CTSCustomer)
WHERE c.CTSCustID = $ip_CTSCustId
WITH c,c1,d,r,r1
UNWIND [r.CreatedTime,r1.CreatedTime] AS val
RETURN c1.CTSCustID as CTSCustID, c1.CustID AS CustId, c1.UserName AS Username, c1.UserName2 AS Username2, 1 AS AssociationType, -1 AS SharedDevices, -1 AS SharedIPs, c1.SubscriberID AS SubscriberId, MAX(val) AS AssociationDate
UNION ALL
MATCH (c:CTSCustomer)-[r2:USED_IP]->(i:IP)<-[r3:USED_IP]-(c2:CTSCustomer)
WHERE c.CTSCustID = $ip_CTSCustId
WITH c,c2,i,r2,r3
UNWIND [r2.CreatedTime,r3.CreatedTime] AS val
RETURN c2.CTSCustID as CTSCustID, c2.CustID AS CustId, c2.UserName AS Username, c2.UserName2 AS Username2, 2 as AssociationType, -1 AS SharedDevices, -1 AS SharedIPs, c2.SubscriberID AS SubscriberId, MAX(val) AS AssociationDate
',{ip_CTSCustId: $CTSCustID}) YIELD value 
WITH collect(value) as ListAss, count(value) as TotalItems
UNWIND ListAss as ass
WITH ass, TotalItems 
SKIP $Skip
LIMIT $Pagesize
RETURN COLLECT(ass) AS AssociationList, TotalItems