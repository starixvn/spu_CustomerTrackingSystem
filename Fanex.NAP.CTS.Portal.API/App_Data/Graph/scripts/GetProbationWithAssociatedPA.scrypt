MATCH (c:CTSCustomer)
WHERE c.CustID in $ip_CustIDs
WITH c
OPTIONAL MATCH (c)-[r1:USED_DEVICE]->(d:Device)<-[r2:USED_DEVICE]-(c2:CTSCustomer)-[r3:HAS_CATEGORY]->(ct:CustomerCategory)
WHERE   ct.ParentID = 50
WITH Distinct  c, CASE ct.CategoryID WHEN NULL THEN 0  ELSE 1 END AS isAssociatedPA
WHERE
		   ($ip_isAssociatedWithPA = -1)
		OR ($ip_isAssociatedWithPA = 0 AND isAssociatedPA = 0)
        OR ($ip_isAssociatedWithPA = 1 AND isAssociatedPA = 1)

RETURN c.CustID as CustId , isAssociatedPA as IsAssociationWithPA