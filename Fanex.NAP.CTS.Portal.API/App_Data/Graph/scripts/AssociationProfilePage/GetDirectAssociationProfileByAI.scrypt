MATCH (c:CTSCustomer)
WHERE c.CTSCustID = $ip_CTSCustID
CALL {
    WITH c
    OPTIONAL MATCH (c)-[r:ASS_BY_AI]-(c1:CTSCustomer)
    RETURN DISTINCT c1, r.CreatedDate AS PreAssDate
    UNION
    WITH c
    OPTIONAL MATCH (c)-[r:GROUP_BY_AI*2]-(c1:CTSCustomer)
    RETURN DISTINCT c1, r[0].CreatedDate AS PreAssDate
}
WITH c, c1, MIN(PreAssDate) AS AssDate
MATCH (c1)-[:BELONG_TO_SUB]->(s:Subscriber)
MATCH (c1)-[:HAS_STATUS]->(st:StaticList)
WHERE (($ip_AssociationStatus = 0) 
		    OR ($ip_AssociationStatus = 1 AND not exists((c)-[:HAS_EXCEPTION]-(c1)))
		    OR ($ip_AssociationStatus = 2 AND exists((c)-[:HAS_EXCEPTION]-(c1)))) 
        AND s.SubscriberID in $ip_SubscriberIDs
        AND st.ListID = 1 AND st.ItemID in $ip_AccountStatuses
WITH c, c1, s, st, AssDate
OPTIONAL MATCH (c)-[e:HAS_EXCEPTION]-(c1)
OPTIONAL MATCH (c1)-[:HAS_CATEGORY]->(ct:CustomerCategory)
WHERE ct.CategoryID IN $ip_CategoryIDs
WITH c, c1, s, st, ct, e, AssDate AS firstAssDate
WHERE ( 0 IN $ip_CategoryIDs) OR (NOT 0 IN $ip_CategoryIDs AND ct.CategoryID IS NOT NULL)
OPTIONAL MATCH (c)-[r:GROUP_BY_AI]->(g:AIGroup)<-[r1:GROUP_BY_AI]-(c1)
WITH 
      c1.CTSCustID          AS CTSCustID
    , c1.CustID             AS CustId
    , c1.CustSubID          AS CustSubId
    , s.SubscriberID        AS SubscriberID
    , s.SubscriberName      AS SubscriberName
    , c1.UserName           AS UserName
    , c1.UserName2          AS UserName2  
    , st.PriorityOrder      AS StatusGroup    
    , st.ItemID             AS StatusID
    , st.ItemNameDisplay    AS StatusName
    , "Betting Pattern"     AS AssociationTypeName  
    , CASE e WHEN null THEN 1 ELSE 2 END AS AssociationStatus
    , CASE WHEN $ip_AssociationStatus in [0,2] and e.CreatedDate IS NOT NULL THEN e.CreatedDate ELSE firstAssDate END AS AssociationDate
    , ct.ParentID           AS ParentIDs
    , apoc.text.join(COLLECT(DISTINCT toString(ct.CategoryID )),",") AS CategoryIDs
    , apoc.text.join(COLLECT(DISTINCT ct.CategoryName),",")          AS CategoryNames
    , apoc.text.join(COLLECT(DISTINCT toString(g.GroupID)),",")                AS GroupIDs
    , apoc.text.join(COLLECT(DISTINCT toString(r1.OriginGroupID)),",")         AS OriginGroupIDs
ORDER BY SubscriberName ASC, AssociationStatus ASC, StatusGroup ASC, StatusID ASC, AssociationDate DESC, CTSCustID ASC
WITH COLLECT({CTSCustID:CTSCustID, CustId:CustId, CustSubId:CustSubId, SubscriberID:SubscriberID, SubscriberName:SubscriberName, UserName:UserName, UserName2:UserName2, StatusGroup:StatusGroup, StatusID:StatusID, StatusName:StatusName, AssociationTypeName:AssociationTypeName, AssociationStatus:AssociationStatus, AssociationDate:AssociationDate, ParentIDs:ParentIDs, CategoryIDs:CategoryIDs, CategoryNames:CategoryNames, GroupIDs:GroupIDs, OriginGroupIDs:OriginGroupIDs} ) as AssociationList, count(CTSCustID) as TotalItems
UNWIND AssociationList as associationList
WITH associationList, TotalItems
SKIP $ip_Skip
LIMIT $ip_PageSize
RETURN COLLECT(associationList) as AssociationList, TotalItems