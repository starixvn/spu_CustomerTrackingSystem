USE ctsgraphdb
//USE ctslocal
CALL apoc.cypher.run('
    MATCH p=((c:CTSCustomer)-[:USED_DEVICE*2]-(c1:CTSCustomer))
    WHERE c.CTSCustID = $ip_CTSCustID AND c <> c1 AND c1.CTSCustID IS NOT NULL 
    WITH DISTINCT c, c1, collect(relationships(p)) AS r 
    MATCH (c1)-[:BELONG_TO_SUB]->(s:Subscriber)
    MATCH (c1)-[:HAS_STATUS]->(st:StaticList)
    WHERE  st.ListID = 1 AND st.ItemID in $ip_AccountStatuses
        AND s.SubscriberID in $ip_SubscriberIDs
        AND      (($ip_AssociationStatus = 0) 
                OR ($ip_AssociationStatus = 1 AND not exists((c)-[:HAS_EXCEPTION]-(c1)))
                OR ($ip_AssociationStatus = 2 AND exists((c)-[:HAS_EXCEPTION]-(c1))))
    WITH c, c1, r, st.PriorityOrder as StatusGroup, st.ItemID as ItemID, st.ItemNameDisplay as StatusName, s.SubscriberID as SubscriberID, s.SubscriberName as SubscriberName
    UNWIND r as val
    UNWIND (CASE WHEN val[0].CreatedDate > val[1].CreatedDate THEN val[0].CreatedDate ELSE val[1].CreatedDate END) AS association
    WITH c, c1, SubscriberID, SubscriberName, StatusGroup, ItemID, StatusName, Min(association) as firstAss
    OPTIONAL MATCH (st2:StaticList {ListID:2, ItemID:1})
    OPTIONAL MATCH (c:CTSCustomer)-[e:HAS_EXCEPTION]-(c1:CTSCustomer)
    RETURN 
        c1.CTSCustID            AS CTSCustID
        , c1.CustID             AS CustId
        , c1.CustSubID          AS CustSubId
        , SubscriberID          AS SubscriberID
        , SubscriberName        AS SubscriberName
        , c1.Username           AS UserName
        , c1.Username2          AS UserName2  
        , StatusGroup           AS StatusGroup    
        , ItemID                AS StatusID
        , StatusName            AS StatusName
        , st2.ItemNameDisplay   AS AssociationTypeName  
        , CASE e WHEN null THEN 1 ELSE 2 END AS AssociationStatus
        , CASE WHEN $ip_AssociationStatus in [0,2] and e IS NOT NULL THEN e.CreatedDate ELSE firstAss END AS AssociationDate

    UNION

    MATCH (c:CTSCustomer)-[r:ADD_MANUALLY]-(c1:CTSCustomer)
    MATCH (c1)-[:BELONG_TO_SUB]->(s:Subscriber)
    MATCH (c1)-[:HAS_STATUS]->(st:StaticList)
    WHERE c.CTSCustID = $ip_CTSCustID AND c1.CTSCustID IS NOT NULL 
        AND (($ip_AssociationStatus = 0) 
            OR ($ip_AssociationStatus = 1 AND not exists((c)-[:HAS_EXCEPTION]-(c1)))
            OR ($ip_AssociationStatus = 2 AND exists((c)-[:HAS_EXCEPTION]-(c1))))
        AND s.SubscriberID in $ip_SubscriberIDs
        AND st.ListID = 1 AND st.ItemID in $ip_AccountStatuses
    WITH distinct c,c1,s,st,r.CreatedDate as AssDate
    OPTIONAL MATCH (st2:StaticList {ListID:2, ItemID:$ip_AssociationType})
    OPTIONAL MATCH (c:CTSCustomer)-[e:HAS_EXCEPTION]-(c1:CTSCustomer)
    WITH c,c1,s,e,st,st2.ItemNameDisplay as AssTypeName, Min(AssDate) as firstAssDate
    RETURN 
        c1.CTSCustID            AS CTSCustID
        , c1.CustID             AS CustId
        , c1.CustSubID          AS CustSubId
        , s.SubscriberID        AS SubscriberID
        , s.SubscriberName      AS SubscriberName
        , c1.Username           AS UserName
        , c1.Username2          AS UserName2  
        , st.PriorityOrder      AS StatusGroup    
        , st.ItemID             AS StatusID
        , st.ItemNameDisplay    AS StatusName
        , AssTypeName           AS AssociationTypeName  
        , CASE e WHEN null THEN 1 ELSE 2 END AS AssociationStatus
        , CASE WHEN $ip_AssociationStatus in [0,2] and e IS NOT NULL THEN e.CreatedDate ELSE firstAssDate END AS AssociationDate

    UNION

    MATCH (c:CTSCustomer)-[r:ASS_BY_IP]-(c1:CTSCustomer)
    MATCH (c1)-[:BELONG_TO_SUB]->(s:Subscriber)
    MATCH (c1)-[:HAS_STATUS]->(st:StaticList)
    WHERE c.CTSCustID = $ip_CTSCustID  AND c.CustSubID = 0 AND c1.CTSCustID IS NOT NULL
        AND (($ip_AssociationStatus = 0) 
            OR ($ip_AssociationStatus = 1 AND not exists((c)-[:HAS_EXCEPTION]-(c1)))
            OR ($ip_AssociationStatus = 2 AND exists((c)-[:HAS_EXCEPTION]-(c1))))
        AND s.SubscriberID in $ip_SubscriberIDs
        AND st.ListID = 1 AND st.ItemID in $ip_AccountStatuses
    WITH distinct c,c1,s,st,r.CreatedDate as AssDate
    OPTIONAL MATCH (st2:StaticList {ListID:2, ItemID:$ip_AssociationType})
    OPTIONAL MATCH (c:CTSCustomer)-[e:HAS_EXCEPTION]-(c1:CTSCustomer)
    WITH c,c1,s,e,st,st2.ItemNameDisplay as AssTypeName, Min(AssDate) as firstAssDate
    RETURN 
        c1.CTSCustID            AS CTSCustID
        , c1.CustID             AS CustId
        , c1.CustSubID          AS CustSubId
        , s.SubscriberID        AS SubscriberID
        , s.SubscriberName      AS SubscriberName
        , c1.Username           AS UserName
        , c1.Username2          AS UserName2  
        , st.PriorityOrder      AS StatusGroup    
        , st.ItemID             AS StatusID
        , st.ItemNameDisplay    AS StatusName
        , AssTypeName           AS AssociationTypeName  
        , CASE e WHEN null THEN 1 ELSE 2 END AS AssociationStatus
        , CASE WHEN $ip_AssociationStatus in [0,2] and e IS NOT NULL THEN e.CreatedDate ELSE firstAssDate END AS AssociationDate

    UNION

    MATCH (c:CTSCustomer)-[r:ASS_BY_AI]-(c1:CTSCustomer)
    MATCH (c1)-[:BELONG_TO_SUB]->(s:Subscriber)
    MATCH (c1)-[:HAS_STATUS]->(st:StaticList)
    WHERE c.CTSCustID = $ip_CTSCustID AND c1.CTSCustID IS NOT NULL
        AND (($ip_AssociationStatus = 0) 
		    OR ($ip_AssociationStatus = 1 AND not exists((c)-[:HAS_EXCEPTION]-(c1)))
		    OR ($ip_AssociationStatus = 2 AND exists((c)-[:HAS_EXCEPTION]-(c1)))) 
        AND s.SubscriberID in $ip_SubscriberIDs
        AND st.ListID = 1 AND st.ItemID in $ip_AccountStatuses
    WITH distinct c,c1,s,st,r.CreatedDate as AssDate
    OPTIONAL MATCH (st2:StaticList {ListID:2, ItemID:$ip_AssociationType})
    OPTIONAL MATCH (c:CTSCustomer)-[e:HAS_EXCEPTION]-(c1:CTSCustomer)

    WITH c,c1,s,e,st,st2.ItemNameDisplay as AssTypeName, Min(AssDate) as firstAssDate
    RETURN 
          c1.CTSCustID          AS CTSCustID
        , c1.CustID             AS CustId
        , c1.CustSubID          AS CustSubId
        , s.SubscriberID        AS SubscriberID
        , s.SubscriberName      AS SubscriberName
        , c1.Username           AS UserName
        , c1.Username2          AS UserName2  
        , st.PriorityOrder      AS StatusGroup    
        , st.ItemID             AS StatusID
        , st.ItemNameDisplay    AS StatusName
        , AssTypeName           AS AssociationTypeName  
        , CASE e WHEN null THEN 1 ELSE 2 END AS AssociationStatus
        , CASE WHEN $ip_AssociationStatus in [0,2] and e IS NOT NULL THEN e.CreatedDate ELSE firstAssDate END AS AssociationDate
',{ip_CTSCustID: $ip_CTSCustID, ip_AssociationStatus: $ip_AssociationStatus, ip_AssociationType: $ip_AssociationType, ip_AccountStatuses: $ip_AccountStatuses, ip_SubscriberIDs: $ip_SubscriberIDs}) YIELD value 
WITH     value.CTSCustID        AS CTSCustID
        , value.CustId          AS CustId
        , value.CustSubId       AS CustSubId
        , value.SubscriberID    AS SubscriberID
        , value.SubscriberName  AS SubscriberName
        , value.UserName        AS UserName
        , value.UserName2       AS UserName2
        , value.StatusGroup     AS StatusGroup
        , value.StatusID        AS StatusID
        , value.StatusName      AS StatusName
        , value.AssociationStatus                      AS AssociationStatus    
        , COLLECT(DISTINCT value.AssociationTypeName)  AS AssociationTypeName  
        , COLLECT(DISTINCT value.AssociationDate)      AS AssociationDate
UNWIND(AssociationDate) AS associationDate       
WITH CTSCustID, CustId, CustSubId, SubscriberID, SubscriberName, UserName, UserName2, StatusGroup, StatusID, StatusName, AssociationStatus, AssociationTypeName, Min(associationDate) as AssociationDate
OPTIONAL MATCH (c1:CTSCustomer)-[:HAS_CATEGORY]->(ct:CustomerCategory)
WHERE ct.CategoryID in $ip_CategoryIDs AND c1.CTSCustID in CTSCustID 
WITH 
      CTSCustID          AS CTSCustID
    , CustId             AS CustId
    , CustSubId          AS CustSubId
    , SubscriberID       AS SubscriberID
    , SubscriberName     AS SubscriberName
    , UserName           AS UserName
    , UserName2          AS UserName2  
    , StatusGroup        AS StatusGroup    
    , StatusID           AS StatusID
    , StatusName         AS StatusName
    , AssociationStatus  AS AssociationStatus
    , apoc.text.join(AssociationTypeName,",")                     AS AssociationTypeName
    , AssociationDate    AS AssociationDate
    , ct.ParentIDs       AS ParentIDs
    , apoc.text.join(collect(distinct ct.CategoryIDs),",")        AS CategoryIDs
    , apoc.text.join(collect(distinct ct.CategoryNames),",")      AS CategoryNames
    
ORDER BY SubscriberName ASC, AssociationStatus ASC, StatusGroup ASC, StatusID ASC, AssociationDate DESC, CTSCustID ASC
SKIP $ip_Skip
LIMIT $ip_PageSize
RETURN CTSCustID, CustId, CustSubId, SubscriberID, SubscriberName, UserName, UserName2, StatusGroup, StatusID, StatusName, AssociationTypeName, AssociationStatus, AssociationDate, ParentIDs, CategoryIDs, CategoryNames