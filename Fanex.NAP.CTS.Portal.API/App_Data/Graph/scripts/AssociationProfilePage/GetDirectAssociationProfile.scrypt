USE ctsgraphdb
//USE ctslocal
CALL apoc.cypher.run('
MATCH (c:CTSCustomer)-[r:USED_DEVICE]->(d:Device)<-[r1:USED_DEVICE]-(c1:CTSCustomer)
MATCH (c1)-[:BELONG_TO_SUB]->(s:Subscriber)
MATCH (c1)-[:HAS_STATUS]->(st:StaticList)
WHERE c.CTSCustID = $ip_CTSCustID AND c1.CTSCustID IS NOT NULL 
        AND (($ip_AssociationStatus = 0) 
		    OR ($ip_AssociationStatus = 1 AND not exists((c)-[:HAS_EXCEPTION]-(c1)))
		    OR ($ip_AssociationStatus = 2 AND exists((c)-[:HAS_EXCEPTION]-(c1))))
        AND s.SubscriberID in $ip_SubscriberIDs
        AND st.ListID = 1 AND st.ItemID in $ip_AccountStatuses
UNWIND [r.CreatedDate,r1.CreatedDate]  as val
WITH c,c1,d,s,st,Max(val) as AssDate
OPTIONAL MATCH (c)-[e:HAS_EXCEPTION]-(c1)
OPTIONAL MATCH (st2:StaticList {ListID:2, ItemID:1})
OPTIONAL MATCH (c1)-[:HAS_CATEGORY]->(ct:CustomerCategory)
WHERE ct.CategoryID in $ip_CategoryIDs
WITH DISTINCT c,c1,s,st,ct,e,st2.ItemNameDisplay as AssTypeName,Min(AssDate) as firstAssDate
RETURN 
     c1.CTSCustID           AS CTSCustID
    , c1.CustID             AS CustId
    , c1.CustSubID          AS CustSubId
    , s.SubscriberID        AS SubscriberID
    , s.SubscriberName      AS SubscriberName
    , c1.Username           AS UserName
    , c1.Username2          AS UserName2  
    , st.PriorityOrder      AS StatusGroup    
    , st.ItemID             AS StatusID
    , st.ItemNameDisplay    AS StatusName
    , AssTypeName           AS AssociationTypeName  
    , CASE e WHEN null THEN 1 ELSE 2 END AS AssociationStatus
    , CASE WHEN $ip_AssociationStatus in [0,2] and e IS NOT NULL THEN e.CreatedDate ELSE firstAssDate END AS AssociationDate
    , ct.ParentID           AS ParentIDs
    , ct.CategoryID        AS CategoryIDs
    , ct.CategoryName      AS CategoryNames

UNION

MATCH (c:CTSCustomer)-[r:ASS_BY_AI]-(c1:CTSCustomer)
MATCH (c1)-[:BELONG_TO_SUB]->(s:Subscriber)
MATCH (c1)-[:HAS_STATUS]->(st:StaticList)
WHERE c.CTSCustID = $ip_CTSCustID AND c1.CTSCustID IS NOT NULL
    AND (($ip_AssociationStatus = 0) 
        OR ($ip_AssociationStatus = 1 AND not exists((c)-[:HAS_EXCEPTION]-(c1)))
        OR ($ip_AssociationStatus = 2 AND exists((c)-[:HAS_EXCEPTION]-(c1)))) 
    AND s.SubscriberID in $ip_SubscriberIDs
    AND st.ListID = 1 AND st.ItemID in $ip_AccountStatuses
WITH DISTINCT c,c1,s,st,r.CreatedDate as AssDate
OPTIONAL MATCH (c)-[e:HAS_EXCEPTION]-(c1)
OPTIONAL MATCH (st2:StaticList {ListID:2, ItemID:2})
OPTIONAL MATCH (c1)-[:HAS_CATEGORY]->(ct:CustomerCategory)
WHERE ct.CategoryID in $ip_CategoryIDs
WITH DISTINCT c,c1,s,st,e,ct,st2.ItemNameDisplay as AssTypeName, Min(AssDate) as firstAssDate
RETURN 
    c1.CTSCustID          AS CTSCustID
    , c1.CustID             AS CustId
    , c1.CustSubID          AS CustSubId
    , s.SubscriberID        AS SubscriberID
    , s.SubscriberName      AS SubscriberName
    , c1.Username           AS UserName
    , c1.Username2          AS UserName2  
    , st.PriorityOrder      AS StatusGroup    
    , st.ItemID             AS StatusID
    , st.ItemNameDisplay    AS StatusName
    , AssTypeName           AS AssociationTypeName  
    , CASE e WHEN null THEN 1 ELSE 2 END AS AssociationStatus
    , CASE WHEN $ip_AssociationStatus in [0,2] and e IS NOT NULL THEN e.CreatedDate ELSE firstAssDate END AS AssociationDate
    , ct.ParentID           AS ParentIDs
    , ct.CategoryID        AS CategoryIDs
    , ct.CategoryName      AS CategoryNames

UNION

MATCH (c:CTSCustomer)-[r:ADD_MANUALLY]-(c1:CTSCustomer)
MATCH (c1)-[:BELONG_TO_SUB]->(s:Subscriber)
MATCH (c1)-[:HAS_STATUS]->(st:StaticList)
WHERE c.CTSCustID = $ip_CTSCustID AND c.CustSubID = 0 AND c1.CTSCustID IS NOT NULL
    AND (($ip_AssociationStatus = 0) 
        OR ($ip_AssociationStatus = 1 AND not exists((c)-[:HAS_EXCEPTION]-(c1)))
        OR ($ip_AssociationStatus = 2 AND exists((c)-[:HAS_EXCEPTION]-(c1))))
    AND s.SubscriberID in $ip_SubscriberIDs
    AND st.ListID = 1 AND st.ItemID in $ip_AccountStatuses
WITH DISTINCT c,c1,s,st,r.CreatedDate as AssDate
OPTIONAL MATCH (c)-[e:HAS_EXCEPTION]-(c1)
OPTIONAL MATCH (st2:StaticList {ListID:2, ItemID:3})
OPTIONAL MATCH (c1)-[:HAS_CATEGORY]->(ct:CustomerCategory)
WHERE ct.CategoryID in $ip_CategoryIDs
WITH DISTINCT c,c1,s,st,e,ct,st2.ItemNameDisplay as AssTypeName, Min(AssDate) as firstAssDate
RETURN 
      c1.CTSCustID          AS CTSCustID
    , c1.CustID             AS CustId
    , c1.CustSubID          AS CustSubId
    , s.SubscriberID        AS SubscriberID
    , s.SubscriberName      AS SubscriberName
    , c1.Username           AS UserName
    , c1.Username2          AS UserName2  
    , st.PriorityOrder      AS StatusGroup    
    , st.ItemID             AS StatusID
    , st.ItemNameDisplay    AS StatusName
    , AssTypeName           AS AssociationTypeName  
    , CASE e WHEN null THEN 1 ELSE 2 END AS AssociationStatus
    , CASE WHEN $ip_AssociationStatus in [0,2] and e IS NOT NULL THEN e.CreatedDate ELSE firstAssDate END AS AssociationDate
    , ct.ParentID           AS ParentIDs
    , ct.CategoryID        AS CategoryIDs
    , ct.CategoryName      AS CategoryNames

UNION

MATCH (c:CTSCustomer)-[r:ASS_BY_IP]-(c1:CTSCustomer)
MATCH (c1)-[:BELONG_TO_SUB]->(s:Subscriber)
MATCH (c1)-[:HAS_STATUS]->(st:StaticList)
WHERE c.CTSCustID = $ip_CTSCustID AND c.CustSubID = 0 AND c1.CTSCustID IS NOT NULL
    AND (($ip_AssociationStatus = 0) 
        OR ($ip_AssociationStatus = 1 AND not exists((c)-[:HAS_EXCEPTION]-(c1)))
        OR ($ip_AssociationStatus = 2 AND exists((c)-[:HAS_EXCEPTION]-(c1))))
    AND s.SubscriberID in $ip_SubscriberIDs
    AND st.ListID = 1 AND st.ItemID in $ip_AccountStatuses
WITH DISTINCT c,c1,s,st,r.CreatedDate as AssDate
OPTIONAL MATCH (c)-[e:HAS_EXCEPTION]-(c1)
OPTIONAL MATCH (st2:StaticList {ListID:2, ItemID:4})
OPTIONAL MATCH (c1)-[:HAS_CATEGORY]->(ct:CustomerCategory)
WHERE ct.CategoryID in $ip_CategoryIDs
WITH DISTINCT c,c1,s,st,e,ct,st2.ItemNameDisplay as AssTypeName, Min(AssDate) as firstAssDate
RETURN 
      c1.CTSCustID          AS CTSCustID
    , c1.CustID             AS CustId
    , c1.CustSubID          AS CustSubId
    , s.SubscriberID        AS SubscriberID
    , s.SubscriberName      AS SubscriberName
    , c1.Username           AS UserName
    , c1.Username2          AS UserName2  
    , st.PriorityOrder      AS StatusGroup    
    , st.ItemID             AS StatusID
    , st.ItemNameDisplay    AS StatusName
    , AssTypeName           AS AssociationTypeName  
    , CASE e WHEN null THEN 1 ELSE 2 END    AS AssociationStatus
    , CASE WHEN $ip_AssociationStatus in [0,2] and e IS NOT NULL THEN e.CreatedDate ELSE firstAssDate END AS AssociationDate
    , ct.ParentID              AS ParentIDs
    , ct.CategoryID        AS CategoryIDs
    , ct.CategoryName      AS CategoryNames

',{ip_CTSCustID: $CTSCustID, ip_AssociationStatus: $AssociationStatus, ip_AssociationType:$AssociationType, ip_AccountStatuses: $AccountStatuses, ip_SubscriberIDs: $SubscriberIDs, ip_CategoryIDs : $CategoryIDs}) YIELD value

WITH Distinct
      value.CTSCustID                              AS CTSCustID
    , value.CustId                                 AS CustId
    , value.CustSubId                              AS CustSubId
    , value.SubscriberID                           AS SubscriberID
    , value.SubscriberName                         AS SubscriberName
    , value.UserName                               AS UserName
    , value.UserName2                              AS UserName2
    , value.StatusGroup                            AS StatusGroup
    , value.StatusID                               AS StatusID
    , value.StatusName                             AS StatusName
    , collect(Distinct value.AssociationTypeName)  AS AssociationTypeName 
    , value.AssociationStatus                      AS AssociationStatus
    , collect(Distinct value.AssociationDate)      AS AssociationDate
    , value.ParentIDs                              AS ParentIDs
    , collect(Distinct toString(value.CategoryIDs))AS CategoryIDs
    , collect(Distinct value.CategoryNames)        AS CategoryNames
UNWIND(AssociationDate) as associationDate
WITH CTSCustID,CustId,CustSubId,SubscriberID,SubscriberName,UserName,UserName2,StatusGroup,StatusID,StatusName,AssociationTypeName,AssociationStatus, Min(associationDate) as AssociationDate,ParentIDs,CategoryIDs,CategoryNames
WITH collect({
      CTSCustID          : CTSCustID
    , CustId             : CustId
    , CustSubId          : CustSubId
    , SubscriberID       : SubscriberID
    , SubscriberName     : SubscriberName
    , UserName           : UserName
    , UserName2          : UserName2
    , StatusGroup        : StatusGroup
    , StatusID           : StatusID
    , StatusName         : StatusName
    , AssociationTypeName: apoc.text.join(AssociationTypeName,",")
    , AssociationStatus  : AssociationStatus
    , AssociationDate    : AssociationDate
    , ParentIDs          : ParentIDs
    , CategoryIDs        : apoc.text.join(CategoryIDs,",")
    , CategoryNames      : apoc.text.join(CategoryNames,",")
}) AS ListAss, COUNT(CTSCustID) AS TotalItems
UNWIND ListAss AS ass
WITH ass, TotalItems 
ORDER BY ass.SubscriberName ASC, ass.AssociationStatus ASC, ass.StatusGroup ASC, ass.StatusID ASC, ass.AssociationDate DESC, ass.CTSCustID ASC
SKIP $Skip
LIMIT $Pagesize
RETURN COLLECT(ass) AS AssociationList, TotalItems