WITH $AssociatedLevel AS level
MATCH (c:CTSCustomer)
WHERE c.CustID IN $CustIdList
MATCH (c)-[r:HAS_EVIDENCE]->(e:Evidence)
WITH DISTINCT c,r,e,level
RETURN c.CustID AS Level0CustId, c.CustID AS CustId, e.EvidenceCode AS EvidenceCode, e.EvidenceName AS EvidenceName, level AS AssociatedLevel, apoc.date.format(r.CreatedDate,"ms","yyyy-MM-dd HH:mm:ss", "America/Aruba") AS CreatedDateInTicks
LIMIT 500