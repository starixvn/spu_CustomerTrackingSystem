USE ctsgraphdb
MATCH (c:CTSCustomer)<-[:HAS_DOWNLINE]-(rootAgent:CTSCustomer)
WHERE c.CTSCustID = $RootCTSCustID
CALL{
    WITH rootAgent
    MATCH (rootAgent)-[:USED_DEVICE*2]-(assAgent:CTSCustomer)-[:HAS_DOWNLINE]->(ass:CTSCustomer)
    WHERE ass.CTSCustID IN $AssCTSCustIDs
    RETURN ass, assAgent, "Device" AS AssType
    
    UNION
    WITH rootAgent
    MATCH (rootAgent)-[:GROUP_BY_AI*2]-(assAgent:CTSCustomer)-[:HAS_DOWNLINE]->(ass:CTSCustomer)
    WHERE ass.CTSCustID IN $AssCTSCustIDs
    RETURN ass, assAgent, "Betting Pattern" AS AssType

    UNION
    WITH rootAgent
    MATCH (rootAgent)-[r:ASS_BY_AI|ADD_MANUALLY|ASS_BY_IP]-(assAgent:CTSCustomer)-[:HAS_DOWNLINE]->(ass:CTSCustomer)
    WHERE ass.CTSCustID IN $AssCTSCustIDs
    RETURN  ass, assAgent,
        CASE type(r) 
            WHEN 'ASS_BY_AI' THEN 'Betting Pattern'
            WHEN 'ADD_MANUALLY' THEN 'Manually'
            ELSE 'IP' 
        END AS AssType
}
RETURN c.CTSCustID          AS FromCTSCustID
    , c.CustID              AS FromCustID
    , c.UserName            AS FromUsername
    , rootAgent.UserName    AS FromAgentUsername
    , ass.CTSCustID         AS ToCTSCustID
    , ass.CustID            AS ToCustID
    , ass.UserName          AS ToUsername
    , assAgent.UserName     AS ToAgentUsername
    ,                          AssType