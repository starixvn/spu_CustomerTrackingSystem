USE ctsgraphdb2022
MATCH (c:CTSCustomer)
WHERE c.CTSCustID IN $CTSCustIDs
CALL {   
    WITH c
    MATCH (c)-[r:GROUP_BY_AI]->(g:AIGroup)
    RETURN g.GroupID + 10000000000 AS ToID, 4 AS AssociationType

    UNION
    WITH c
    MATCH (c)-[r:ADD_MANUALLY|ASS_BY_IP|ASS_BY_AI]-(c2:CTSCustomer)
    RETURN c2.CTSCustID AS ToID, 
        CASE type(r) 
            WHEN 'ADD_MANUALLY' THEN 2
            WHEN 'ASS_BY_AI' THEN 3
            ELSE 5
        END AS AssociationType
}
RETURN c.CTSCustID AS FromID, ToID, AssociationType

UNION
MATCH (c:CTSCustomer)-[:USED_DEVICE]->(d:Device)<-[:USED_DEVICE]-(c1:CTSCustomer)
WHERE c.CTSCustID IN $CTSCustIDs
RETURN c1.CTSCustID AS FromID, d.DeviceID * -1 AS ToID, 1 AS AssociationType