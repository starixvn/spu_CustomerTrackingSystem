MATCH (c:CTSCustomer)
WHERE c.CTSCustID IN [13,22,30,31,32,33,34,35,36,37]
CALL{
	WITH c
	RETURN  id(c) AS data
	
	UNION
    // AssDevice
    WITH c
    MATCH (c)-[:USED_DEVICE*2]-(c1:CTSCustomer)
    RETURN  id(c1) AS data
    UNION
    WITH c
    MATCH (c)-[:USED_DEVICE*4]-(c1:CTSCustomer)
    RETURN id(c1) AS data
    UNION
    WITH c
    MATCH (c)-[:USED_DEVICE]->(d:Device)
    RETURN id(d) AS data
	UNION
    WITH c
    MATCH (c)-[:USED_DEVICE*4]-(c1:CTSCustomer)-[:USED_DEVICE]->(d:Device)
    RETURN id(d) AS data

    UNION
    // AssGroupByAI
    WITH c
    MATCH (c)-[:GROUP_BY_AI]->(g:AIGroup)
    RETURN  id(g) AS data
    UNION
    WITH c
	MATCH (c)-[:GROUP_BY_AI*4]-(c1:CTSCustomer)-[:GROUP_BY_AI]->(g:AIGroup)
    RETURN  id(g) AS data
    UNION
    WITH c
    MATCH (c)-[:GROUP_BY_AI*2]-(c1:CTSCustomer)
    RETURN  id(c1) AS data
    UNION
    WITH c
    MATCH (c)-[:GROUP_BY_AI*4]-(c1:CTSCustomer)
    RETURN  id(c1) AS data
    
    UNION
    // AssAI
    WITH c
    MATCH (c)-[:ASS_BY_AI]-(c1:CTSCustomer)
    RETURN  id(c1) AS data
    UNION
    WITH c
    MATCH (c)-[:ASS_BY_AI*2]-(c1:CTSCustomer)
    RETURN  id(c1) AS data

    UNION
    // AssIP
    WITH c
    MATCH (c)-[:ASS_BY_IP]-(c1:CTSCustomer)
    RETURN  id(c1) AS data
    UNION
    WITH c
    MATCH (c)-[:ASS_BY_IP*2]-(c1:CTSCustomer)
    RETURN  id(c1) AS data

    UNION
    // Manual
    WITH c
    MATCH (c)-[:ADD_MANUALLY]-(c1:CTSCustomer)
    RETURN  id(c1) AS data
    UNION
    WITH c
    MATCH (c)-[:ADD_MANUALLY*2]-(c1:CTSCustomer)
    RETURN  id(c1) AS data
}
WITH collect(distinct data) AS nodeIds
CALL gds.graph.create.cypher(
  'AssLevel2',
  'UNWIND $nodes AS id RETURN id',
  'MATCH (n)-[r:USED_DEVICE|GROUP_BY_AI|ASS_BY_AI|ASS_BY_IP|ADD_MANUALLY]-(m)
    WHERE (id(n) IN $nodes) AND (id(m) IN $nodes)
    RETURN id(n) AS source, id(m) AS target, type(r) AS type',
  { parameters: { nodes: nodeIds} }
)
 YIELD
  graphName, nodeCount AS nodes, relationshipCount AS rels
   RETURN graphName, nodes, rels