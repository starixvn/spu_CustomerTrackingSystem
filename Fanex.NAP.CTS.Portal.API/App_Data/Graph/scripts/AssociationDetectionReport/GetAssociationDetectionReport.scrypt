USE ctsgraphdb
//USE ctslocal
MATCH (c:CTSCustomer)-[:BELONG_TO_SUB]->(s:Subscriber)
WHERE c.CTSCustID in $ip_CTSCustIDs AND NOT (s.SubscriberID IN $ip_ExcludeSubscriberIDs)
WITH DISTINCT c

CALL 
{
    WITH c
    MATCH (c)-[:USED_DEVICE*2]-(c1:CTSCustomer)
    WHERE c <> c1
    WITH DISTINCT c, c1
    WHERE NOT EXISTS((c)-[:HAS_EXCEPTION]-(c1))
    WITH DISTINCT c.CTSCustID as lv0, c1
    MATCH (c1)-[:BELONG_TO_SUB]->(s:Subscriber)
    WHERE NOT (s.SubscriberID IN $ip_ExcludeSubscriberIDs)
    RETURN DISTINCT lv0, COLLECT(DISTINCT c1.CTSCustID) AS association

    UNION
    WITH c
    MATCH (c)-[r:ASS_BY_AI]-(c1:CTSCustomer)
    WHERE c <> c1
    WITH DISTINCT c, c1
    WHERE NOT EXISTS((c)-[:HAS_EXCEPTION]-(c1))
    WITH DISTINCT c.CTSCustID as lv0, c1
    MATCH (c1)-[:BELONG_TO_SUB]->(s:Subscriber)
    WHERE NOT (s.SubscriberID IN $ip_ExcludeSubscriberIDs)
    RETURN DISTINCT lv0, COLLECT(DISTINCT c1.CTSCustID) AS association

    UNION
    WITH c
    MATCH (c)-[r:ASS_BY_IP]-(c1:CTSCustomer)
    WHERE c <> c1
    WITH DISTINCT c, c1
    WHERE NOT EXISTS((c)-[:HAS_EXCEPTION]-(c1))
    WITH DISTINCT c.CTSCustID as lv0, c1
    MATCH (c1)-[:BELONG_TO_SUB]->(s:Subscriber)
    WHERE NOT (s.SubscriberID IN $ip_ExcludeSubscriberIDs)
    RETURN DISTINCT lv0, COLLECT(DISTINCT c1.CTSCustID) AS association

    UNION
    WITH c
    MATCH (c)-[r:ADD_MANUALLY]-(c1:CTSCustomer)
    WHERE c <> c1
    WITH DISTINCT c, c1
    WHERE NOT EXISTS((c)-[:HAS_EXCEPTION]-(c1))
    WITH DISTINCT c.CTSCustID as lv0, c1
    MATCH (c1)-[:BELONG_TO_SUB]->(s:Subscriber)
    WHERE NOT (s.SubscriberID IN $ip_ExcludeSubscriberIDs)
    RETURN DISTINCT lv0, COLLECT(DISTINCT c1.CTSCustID) AS association
}
WITH DISTINCT lv0, association
UNWIND association as eachAssRow
WITH DISTINCT collect(lv0) AS lv0, Count(lv0) as numberAss, eachAssRow
WHERE numberAss >= 2 OR eachAssRow in $ip_CTSCustIDs
WITH lv0, CASE WHEN numberAss >= 2 AND NOT eachAssRow in $ip_CTSCustIDs THEN lv0 ELSE eachAssRow END AS rows
UNWIND lv0 AS root
UNWIND rows AS assRow
WITH DISTINCT root, assRow
WHERE root <> assRow
RETURN root AS CTSCustIdLv0, collect(DISTINCT assRow) AS Associations
