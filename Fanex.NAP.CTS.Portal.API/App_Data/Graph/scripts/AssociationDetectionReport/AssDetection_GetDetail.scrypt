USE ctsgraphdb2022
MATCH (c:CTSCustomer)
WHERE c.CTSCustID = $RootCTSCustID
CALL{
    WITH c
    MATCH (c)-[:USED_DEVICE*2]-(ass:CTSCustomer)
    WHERE ass.CTSCustID IN $AssCTSCustIDs
    RETURN ass, "Device" AS AssType
    
    UNION
    WITH c
    MATCH (c)-[:GROUP_BY_AI*2]-(ass:CTSCustomer)
    WHERE ass.CTSCustID IN $AssCTSCustIDs
    RETURN ass, "Betting Pattern" AS AssType

    UNION
    WITH c
    MATCH (c)-[r:ASS_BY_AI|ADD_MANUALLY|ASS_BY_IP]-(ass:CTSCustomer)
    WHERE ass.CTSCustID IN $AssCTSCustIDs
    RETURN  ass,
        CASE type(r) 
            WHEN 'ASS_BY_AI' THEN 'Betting Pattern'
            WHEN 'ADD_MANUALLY' THEN 'Manually'
            ELSE 'IP' 
        END AS AssType
}
RETURN ass.CTSCustID AS ToCTSCustID, ass.UserName AS ToUsername, ass.CustID AS ToCustID, AssType, ass.Username