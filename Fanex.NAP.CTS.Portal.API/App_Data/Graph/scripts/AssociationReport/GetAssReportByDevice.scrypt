//USE ctsgraphdb
USE ctslocal
CALL apoc.cypher.run('
MATCH (c:FlaggedCustomer)-[r:HAS_EVIDENCE]->(e:Evidence)
WHERE e.EvidenceID IN $ip_EvidenceIDs
WITH  c, collect(DISTINCT e.EvidenceCode) as EvidenceCodes
MATCH (c)-[:HAS_STATUS]->(st:StaticList)
WHERE st.ListID = 1 AND st.ItemID IN $ip_AccountStatusIDs
WITH c, EvidenceCodes, st.ItemNameDisplay as AccountStatus
MATCH (c)-[:BELONG_TO_SUB]->(s:Subscriber)
WHERE s.SubscriberID in $ip_SubscriberIDs
WITH c, EvidenceCodes, AccountStatus, s.SubscriberID as SubscriberID, s.SubscriberName as SubscriberName
MATCH (c)-[r:USED_DEVICE]->(d:Device )<-[r1:USED_DEVICE]-(c2:CTSCustomer)
UNWIND [r.CreatedDate,r1.CreatedDate]  as val
WITH DISTINCT c.CTSCustID as CTSCustID, c.Username as UserName, EvidenceCodes, AccountStatus, SubscriberID, SubscriberName, d.DeviceID as DeviceID, MAX(val) as assDate, c2.CTSCustID as CTSCustID2
WITH DISTINCT CTSCustID, UserName, EvidenceCodes, AccountStatus, SubscriberID, SubscriberName,
collect(DeviceID) as DeviceIDs , collect(assDate) as ListAssDate, CTSCustID2
WHERE (($ip_AccountStatusIDs = 0) 
            OR ($ip_AccountStatusIDs = 1 AND NOT EXISTS ((:CTSCustomer {CTSCustID:CTSCustID})-[:HAS_EXCEPTION]-(:CTSCustomer {CTSCustID:CTSCustID2})))
            OR ($ip_AccountStatusIDs = 2 AND EXISTS ((:CTSCustomer {CTSCustID:CTSCustID})-[:HAS_EXCEPTION]-(:CTSCustomer {CTSCustID:CTSCustID2})))) 
UNWIND ListAssDate as val
WITH DISTINCT CTSCustID, UserName, EvidenceCodes, AccountStatus, SubscriberID, SubscriberName,
Min(val) as FirstDate, CTSCustID2
WHERE FirstDate >= $ip_FromAssDate AND FirstDate <= $ip_ToAssDate
WITH DISTINCT CTSCustID, UserName, EvidenceCodes, AccountStatus, SubscriberID, SubscriberName
OPTIONAL MATCH (:CTSCustomer {CTSCustID:CTSCustID})-[:HAS_CATEGORY]->(ct:CustomerCategory)
RETURN CTSCustID, UserName, apoc.text.join(EvidenceCodes,","), AccountStatus, SubscriberID, SubscriberName, apoc.text.join(collect(ct.CategoryName),",") as CategoryName
RETURN 
      CTSCustID           AS CTSCustID
    , UserName            AS UserName
    , SubscriberID        AS SubscriberID
    , SubscriberName      AS SubscriberName
    , AccountStatus       AS AccountStatus
    , apoc.text.join(EvidenceCodes,",")             AS EvidenceCodes
    , apoc.text.join(collect(ct.CategoryName),",")  AS CategoryName
',{ip_FromAssDate: $FromAssDate, ip_ToAssDate: $ToAssDate, ip_AccountStatusIDs: $AccountStatusIDs, ip_SubscriberIDs: $SubscriberIDs, ip_AssociationStatus: $AssociationStatus, ip_EvidenceIDs: $EvidenceIDs, ip_AssociationType : $AssociationType}) YIELD value 
WITH collect(value) as ListAss, count(value) as TotalItems
UNWIND ListAss as ass
WITH ass, TotalItems 
ORDER BY ass.AccountStatus DESC, ass.SubscriberName DESC
SKIP $Skip
LIMIT $Pagesize
RETURN COLLECT(ass) AS AssociationList, TotalItems