//USE ctsgraphdb2022
USE ctslocal
CALL apoc.cypher.run('
MATCH (c:CTSCustomer)-[r:USED_DEVICE]->(d:Device )<-[r1:USED_DEVICE]-(c1:CTSCustomer) 
WHERE c.CTSCustID in $ip_CTSCustIDs 
    AND (($ip_FromAssDate <= r.CreatedDate <= $ip_ToAssDate) 
        OR ($ip_FromAssDate <= r1.CreatedDate<= $ip_ToAssDate))
    AND (($ip_AssociationStatus = 0) 
		OR ($ip_AssociationStatus = 1 AND not exists((c)-[:HAS_EXCEPTION]-(c1)))
		OR ($ip_AssociationStatus = 2 AND exists((c)-[:HAS_EXCEPTION]-(c1))))
WITH DISTINCT c, d.DeviceID as DeviceID, c1, [r.CreatedDate,r1.CreatedDate] as assDate
UNWIND assDate  as val
WITH c, DeviceID, c1, Max(val) as assDateByDevice
WITH c, c1, Min(assDateByDevice) as firstAssociation
WHERE $ip_FromAssDate <= firstAssociation <= $ip_ToAssDate 
WITH DISTINCT c.CTSCustID as CTSCustID
OPTIONAL MATCH (:CTSCustomer {CTSCustID:CTSCustID})-[:HAS_CATEGORY]->(ct:CustomerCategory)
RETURN 
      CTSCustID           AS CTSCustID
    , apoc.text.join(collect(ct.CategoryName),",")  AS CategoryName
',{ ip_CTSCustIDs : $CTSCustIDs, ip_FromAssDate: datetime($FromAssDate), ip_ToAssDate: datetime($ToAssDate), ip_AssociationStatus: $AssociationStatus}) YIELD value 
WITH collect(value) as ListAss, count(value) as TotalItems
RETURN ListAss AS AssociationList, TotalItems