MATCH (e:Evidence)<-[re1:HAS_EVIDENCE]-(c:CTSCustomer)-[r1:USED_DEVICE]->(d:Device)<-[r2:USED_DEVICE]-(c1:CTSCustomer)
WHERE   (($ip_AssType = 1) 
            OR ($ip_AssType = 2 AND NOT EXISTS (c.CTSCustID))
            OR ($ip_AssType = 3 AND NOT EXISTS (c.CTSCustID)))  //reject this case
        AND c.CustStatusID = $ip_AccountStatus 
        AND c.Site = trim($ip_SiteName)
		AND e.EvidenceCode = trim($ip_EvidenceCode)
		AND 
        	    (($ip_AssStatus = 0) 
         	 OR ($ip_AssStatus = 1 AND NOT EXISTS ((c)-[:HAS_EXCEPTION]-(c1)))
         	 OR ($ip_AssStatus = 2 AND EXISTS ((c)-[:HAS_EXCEPTION]-(c1))))         
WITH MAX(r1.CreatedTime,r2.CreatedTime) as FirstAssDate,c,e
WHERE FirstAssDate >= $ip_AssCreatedFrom AND FirstAssDate <= $ip_AssCreatedTo
OPTIONAL MATCH (c)-[HAS_EVIDENCE]->(e1:Evidence)
with  c,  collect(Distinct e1.EvidenceCode) as listEvidenceCode
RETURN Distinct c.CTSCustID as CTSCustID, c.UserName AS Username, CASE c.CustStatusID WHEN 1 THEN 'OPEN' ELSE 'CLOSE' END AS AccountStatus, listEvidenceCode
UNION
MATCH (e:Evidence)<-[re1:HAS_EVIDENCE]-(c:CTSCustomer)-[m:ADD_MANUALLY]-(c1:CTSCustomer)-[re2:HAS_EVIDENCE]->(e)
WHERE   (($ip_AssType = 1) 
        	OR ($ip_AssType = 2 AND NOT EXISTS (c.CTSCustID))
        	OR ($ip_AssType = 3 AND NOT EXISTS (c.CTSCustID)))  //reject this case  
		AND	c.CustStatusID = $ip_AccountStatus
        AND trim(c.Site) = $ip_SiteName
		AND e.EvidenceCode = trim($ip_EvidenceCode)
		AND 
        	    (($ip_AssStatus = 0) 
         	 OR ($ip_AssStatus = 1 AND NOT EXISTS ((c)-[:HAS_EXCEPTION]-(c1)))
         	 OR ($ip_AssStatus = 2 AND EXISTS ((c)-[:HAS_EXCEPTION]-(c1))))  
WITH MAX(re1.CreatedTime,re2.CreatedTime) as FirstAssDate,c, e
WHERE FirstAssDate >= $ip_AssCreatedFrom AND FirstAssDate <= $ip_AssCreatedTo
OPTIONAL MATCH (c)-[HAS_EVIDENCE]->(e1:Evidence)
with  c,  collect(Distinct e1.EvidenceCode) as listEvidenceCode
RETURN Distinct c.CTSCustID as CTSCustID, c.UserName AS Username, CASE c.CustStatusID WHEN 1 THEN 'OPEN' ELSE 'CLOSE' END AS AccountStatus, listEvidenceCode
