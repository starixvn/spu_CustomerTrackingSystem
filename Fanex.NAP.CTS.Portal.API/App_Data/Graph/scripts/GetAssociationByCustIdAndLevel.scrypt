WITH $AssociatedLevel AS level
CALL apoc.do.case([
level = 0,'MATCH (c:CTSCustomer)-[:USED_DEVICE|:ADD_MANUALLY*0]-(c1:CTSCustomer) WHERE c.CustID IN $custIdList AND c1.CustID IS NOT NULL RETURN c.CustID AS Level0CustId, c1.CustID AS CustId'
,level = 1,'MATCH (c:CTSCustomer)-[:USED_DEVICE|:ADD_MANUALLY*2]-(c1:CTSCustomer) WHERE c.CustID IN $custIdList AND c1.CustID IS NOT NULL RETURN c.CustID AS Level0CustId, c1.CustID AS CustId'
,level = 2,'MATCH (c:CTSCustomer)-[:USED_DEVICE|:ADD_MANUALLY*4]-(c1:CTSCustomer) WHERE c.CustID IN $custIdList AND c1.CustID IS NOT NULL RETURN c.CustID AS Level0CustId, c1.CustID AS CustId'
],'',{custIdList: $CustIdList}) YIELD value
RETURN DISTINCT value.Level0CustId AS Level0CustId, value.CustId AS CustId