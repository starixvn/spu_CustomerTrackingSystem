MATCH (c:CTSCustomer)
WHERE c.CTSCustID = $CTSCustID
OPTIONAL MATCH (c)-[:USED_DEVICE]->(d:Device)
OPTIONAL MATCH (d)<-[:USED_DEVICE]-(c1:CTSCustomer)
WHERE c1.CTSCustID <> c.CTSCustID
WITH c, COUNT(DISTINCT d) as TotalDevices, collect(DISTINCT c1) as assDev
OPTIONAL MATCH (c)-[:USED_IP]->(i:IP)
OPTIONAL MATCH (i)<-[:USED_IP]-(c2:CTSCustomer)
WHERE c2.CTSCustID <> c.CTSCustID
WITH TotalDevices,assDev,COUNT(DISTINCT i) as TotalIps, collect(DISTINCT c2) as assIp
UNWIND assIp as c1
UNWIND assDev as c2
UNWIND [c1,c2] as cus
RETURN COUNT(DISTINCT cus) as TotalAccounts, TotalDevices,TotalIps