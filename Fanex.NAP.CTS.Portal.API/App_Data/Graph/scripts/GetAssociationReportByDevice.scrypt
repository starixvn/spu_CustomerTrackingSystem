//      Created:	Harvey.Nguyen
//		Task:		Association Report [Redmine ID: #]       
//		Param's Explanation (filtered by):
//				- ip_AssCreatedFrom, ip_AssCreatedTo
//				- ip_AccountStatus : (single selection) Disabled ; Open includes Active; Closed includes Suspended, View Only, Disabled, Inactive
//				- ip_SubscriberList 
//				- ip_AssStatus: 0:All; 1:Link; 2: Unlink  (multi-selection)
//				- ip_EvidenceCode
//				- ip_AssType:  1: Device; 2:Manual; 3:IP  (single-selction)
CALL {
    MATCH (c0:FlaggedCustomer)-[:BELONG_TO_SUB]->(s0:Subscriber)
    WHERE s0.SubscriberID in $ip_SubscriberList
    MATCH (c0:FlaggedCustomer)-[:HAS_STATUS]->(st:StaticList),(c0)-[:HAS_EVIDENCE]->(e:Evidence)
    WHERE st.ItemID IN $ip_AccountStatus AND st.ListID = 1
        AND e.EvidenceID IN $ip_EvidenceCode
    WITH c0,s0,st
    MATCH (c0)-[r0:USED_DEVICE]->(d:Device)<-[r1:USED_DEVICE]-(c1:CTSCustomer)
    WHERE c0.CustID <> c1.CustID
        AND CASE WHEN r0.CreatedDate > r1.CreatedDate THEN r0.CreatedDate ELSE r1.CreatedDate END >= $ip_AssCreatedFrom     //datetime("2021-04-01")
        AND CASE WHEN r0.CreatedDate > r1.CreatedDate THEN r0.CreatedDate ELSE r1.CreatedDate END <= $ip_AssCreatedTo       //datetime("2021-04-21")
        AND (($ip_AssStatus = 0) 
         	 OR ($ip_AssStatus = 1 AND NOT EXISTS ((c0)-[:HAS_EXCEPTION]-(c1)))
         	 OR ($ip_AssStatus = 2 AND EXISTS ((c0)-[:HAS_EXCEPTION]-(c1)))) 
    RETURN DISTINCT c0,s0,st
    SKIP $ip_SkipRows LIMIT $ip_TakeRows
}
WITH c0,s0,st
MATCH (c0)-[:HAS_EVIDENCE]->(e:Evidence), (c0)-[:HAS_CATEGORY]->(cate:CustomerCategory)
RETURN s0.SubscriberName,c0.Username,st.ItemNameDisplay AS status
,collect(distinct e.EvidenceCode) AS codes
,collect(distinct cate.CategoryName) AS categories
,c0.CustID AS CustID