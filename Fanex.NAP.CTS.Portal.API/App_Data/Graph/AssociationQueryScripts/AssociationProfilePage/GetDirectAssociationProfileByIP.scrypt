USE ctsgraphdb
//USE ctslocal
CALL apoc.cypher.run('
MATCH (c:CTSCustomer)-[r:ASS_BY_IP]-(c1:CTSCustomer)
WHERE c.CTSCustID = $ip_CTSCustID AND c1.CTSCustID IS NOT NULL AND c1.CustSubID = 0
	(($ip_AssociationStatus = 0) 
		OR ($ip_AssociationStatus = 1 AND not exists((c)-[:HAS_EXCEPTION]-(c1)))
		OR ($ip_AssociationStatus = 2 AND exists((c)-[:HAS_EXCEPTION]-(c1))))
WITH distinct c,c1, r.CreatedDate as AssDate
OPTIONAL MATCH (c)-[e:HAS_EXCEPTION]-(c1)
OPTIONAL MATCH (c1)-[:BELONG_TO_SUB]->(s:Subscriber {SubscriberID in $ip_SubscriberIDs})
OPTIONAL MATCH (c1)-[:HAS_STATUS]->(st:StaticList {ListID:1, ItemID in $ip_AccountStatuses})
OPTIONAL MATCH (st2:StaticList {ItemID:2, ListID:$ip_AssociationType})
OPTIONAL MATCH (c1)-[:HAS_CATEGORY]->(ct:CustomerCategory {CategoryID in $ip_CategoryIDs})
WITH c,c1,AssDate,e,s,st,st2,ct
WHERE  s IS NOT NULL and st IS NOT NULL and ct IS NOT NULL)
WITH c,c1,st,e,s,collect(toString(ct.CategoryID)) as CategoryIDs, collect(ct.CategoryName) as CategoryNames,distinct ct.ParentID as ParentID,st2.ItemNameDisplay as AssTypeName, Min(AssDate) as firstAssDate
RETURN 
      c1.CTSCustID          AS CTSCustID
    , c1.CustID             AS CustId
    , c1.CustSubID          AS CustSubId
    , s.SubscriberID        AS SubscriberID
    , s.SubscriberName      AS SubscriberName
    , c1.Username           AS UserName
    , c1.Username2          AS UserName2  
    , st.PriorityOrder      AS StatusGroup    
    , st.ItemID             AS StatusID
    , st.ItemNameDisplay    AS StatusName
    , AssTypeName           AS AssociationTypeName  
    , CASE e WHEN null THEN 1 ELSE 2 END    AS AssociationStatus
    , CASE ($ip_AssociationStatus = 2) THEN e.CreatedDate ELSE firstAssDate END AS AssociationDate
    , ParentID              AS ParentIDs
    , CategoryIDs           AS CategoryIDs
    , CategoryNames         AS CategoryNames
',{ip_CTSCustID: $CTSCustID, ip_AssociationStatus: $AssociationStatus, ip_AssociationType:$AssociationType, ip_AccountStatuses: $AccountStatuses, ip_SubscriberIDs: $SubscriberIDs, ip_CategoryIDs : $CategoryIDs}) YIELD value 
WITH collect(value) as ListAss, count(value) as TotalItems
UNWIND ListAss as ass
WITH ass, TotalItems 
ORDER BY ass.SubscriberName ASC, ass.AssociationStatus ASC, ass.StatusGroup ASC, ass.StatusID ASC, ass.AssociationDate ASC, ass.CTSCustID ASC
SKIP $Skip
LIMIT $Pagesize
RETURN COLLECT(ass) AS AssociationList, TotalItems