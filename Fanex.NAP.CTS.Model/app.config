<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
        
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" /><section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" /><section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" /></configSections>
  
<ONEbook.UM ServiceUris="http://ha.nexdev.net:8889/api" EnableCheckUM="false" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" SiteId="2000" UMPageUrl="~/UserLogin/Common/Offline"> 
    <AllowedIPs AllowAll="true">
      <add Value="10.19.10.54" /> <!--Exact IP-->
      <add From="10.19.10.100" To="10.19.10.200" /> <!--IP Range-->
    </AllowedIPs>
  </ONEbook.UM><Fanex.Logging msmqPath="FormatName:DIRECT=tcp:[IP]\private$\entlib" defaultCategory="$CategoryValue" filePath="$FilePath" />
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.0.0.0" newVersion="5.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="NPOI" publicKeyToken="0df73ec7942b34e1" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.1.3.0" newVersion="2.1.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.ValueTuple" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Net.Http" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.1.1.3" newVersion="4.1.1.3" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
<Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
            <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="$resourcePath_Value" enableWatching="1" />
        </providers>
    </Fanex.Data.DbSettingProvider></configuration>